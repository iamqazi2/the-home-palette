    "hosp_process": {
      "type": "hp-about-process",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/IMG_8881.heic",
            "title": "Consultation",
            "text": "Tell us the concept, the cover count and the budget. We look at your menu, your interiors and how your team actually plates, then recommend shapes and finishes that will hold up in your service.",
            "caption": "It starts with your table, not our catalogue",
            "meta": "Free of charge",
            "meta_icon": "message-circle"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/IMG_8879.heic",
            "title": "Design & colour matching",
            "text": "We match glazes to your brand palette, adjust rim profiles and sizes, and lay out the full setting — plate, bowl, cup, platter — so you can see the table before anything is fired.",
            "caption": "Glazes matched to your brand palette",
            "meta": "14 colour families",
            "meta_icon": "sparkles"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/IMG_8878.heic",
            "title": "Sampling & approval",
            "text": "Physical samples reach your hands before the production run. Weight, stack height, dishwasher behaviour and thermal shock all get checked against real service conditions, and nothing scales up until you sign off.",
            "caption": "Samples before the production run",
            "meta": "Approved by you",
            "meta_icon": "shield-check"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/IMG_8886.heic",
            "title": "Production & delivery",
            "text": "We schedule the run against your opening or reorder date and deliver nationwide, packed to survive the journey — with every future reorder matched back to your master sample.",
            "caption": "Delivered to your door, nationwide",
            "meta": "Nationwide",
            "meta_icon": "truck"
          }
        }
      },
