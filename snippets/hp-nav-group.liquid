{%- comment -%}
  A nav dropdown, built from theme settings rather than from the Shopify menu,
  and rendered alongside the real menu in both the desktop nav and the drawer.

  Its items now point at their own pages — /pages/shop-by-colour and the rest —
  so each is an ordinary link. They were homepage anchors before those pages
  existed, which is why this group could not live in Content > Menus at the
  time; it stays here so the three items keep their own labels and order
  without depending on someone rebuilding them in the menu editor.

  A URL is used as given, so it works with no JavaScript and from anywhere in
  the store. Should a target ever be set back to an in-page anchor, hp-theme.js
  still handles it: any href starting with # gets data-hp-jump, which closes
  the drawer and scrolls with the sticky header's height taken off.

  Every value is passed in explicitly rather than read off `section` here.
  This snippet is rendered from header-dropdown-menu and header-drawer, which
  are themselves snippets — a nested {% render %} — and a scope that failed to
  carry `section` that far would render nothing at all, silently. Passing the
  settings in removes the question.

  Accepts:
    variant     {string} 'desktop' renders the header dropdown markup,
                         'drawer' renders the mobile drawer's accordion markup
    label       {string} the group's own title; nothing renders when blank
    scheme      {string} the header's menu colour scheme, for the panel classes
    i1_label / i1_url  {string} first item's text and destination
    i2_label / i2_url  {string} second item
    i3_label / i3_url  {string} third item
{%- endcomment -%}

{%- liquid
  assign group_label = label

  assign has_items = false
  if i1_label != blank and i1_url != blank
    assign has_items = true
  endif
  if i2_label != blank and i2_url != blank
    assign has_items = true
  endif
  if i3_label != blank and i3_url != blank
    assign has_items = true
  endif
-%}

{%- if group_label != blank and has_items -%}
  {%- assign gid = group_label | handle -%}

  {%- if variant == 'drawer' -%}
    <li>
      <details id="Details-menu-drawer-group-{{ gid }}">
        <summary
          id="HeaderDrawer-group-{{ gid }}"
          class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
        >
          {{ group_label | escape }}
          <span class="svg-wrapper">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div
          id="link-group-{{ gid }}"
          class="menu-drawer__submenu has-submenu motion-reduce"
          tabindex="-1"
        >
          <div class="menu-drawer__inner-submenu">
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
              {%- for n in (1..3) -%}
                {%- liquid
                  case n
                    when 1
                      assign it_label = i1_label
                      assign it_url = i1_url
                    when 2
                      assign it_label = i2_label
                      assign it_url = i2_url
                    when 3
                      assign it_label = i3_label
                      assign it_url = i3_url
                  endcase
                -%}
                {%- if it_label != blank and it_url != blank -%}
                  <li>
                    <a
                      href="{{ it_url }}"
                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                      {%- if it_url contains '#' %} data-hp-jump="{{ it_url | split: '#' | last }}"{% endif %}
                    >
                      {{ it_label | escape }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </details>
    </li>
  {%- else -%}
    <li>
      <header-menu>
        <details id="Details-HeaderMenu-group-{{ gid }}">
          <summary
            id="HeaderMenu-group-{{ gid }}"
            class="header__menu-item list-menu__item link focus-inset"
          >
            <span>{{ group_label | escape }}</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <ul
            id="HeaderMenu-MenuList-group-{{ gid }}"
            class="header__submenu list-menu list-menu--disclosure color-{{ scheme }} gradient caption-large motion-reduce global-settings-popup"
            role="list"
            tabindex="-1"
          >
            {%- for n in (1..3) -%}
              {%- liquid
                case n
                  when 1
                    assign it_label = i1_label
                    assign it_url = i1_url
                  when 2
                    assign it_label = i2_label
                    assign it_url = i2_url
                  when 3
                    assign it_label = i3_label
                    assign it_url = i3_url
                endcase
              -%}
              {%- if it_label != blank and it_url != blank -%}
                <li>
                  <a
                    href="{{ it_url }}"
                    class="header__menu-item list-menu__item link link--text focus-inset caption-large"
                    {%- if it_url contains '#' %} data-hp-jump="{{ it_url | split: '#' | last }}"{% endif %}
                  >
                    {{ it_label | escape }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </details>
      </header-menu>
    </li>
  {%- endif -%}
{%- endif -%}
