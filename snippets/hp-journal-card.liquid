{%- comment -%}
  A single Journal post card. Shared by the lead story and the grid so the two
  cannot drift apart; the lead's different shape is CSS only (.hp-journal__lead).

  Accepts:
    block       {object} a "post" block from the THP Journal section
    read_label  {string} link text
{%- endcomment -%}

{%- liquid
  assign post_url = block.settings.url
  if post_url == blank and block.settings.handle != blank
    assign post_url = '/pages/' | append: block.settings.handle
  endif
  assign card_alt = block.settings.title | escape
-%}

<a class="hp-journal__card" {% if post_url != blank %}href="{{ post_url }}"{% endif %}>
  {%- if block.settings.image != blank -%}
    <span class="hp-journal__media">
      {{
        block.settings.image
        | image_url: width: 1400
        | image_tag:
          widths: '400, 600, 900, 1200, 1400',
          sizes: '(min-width: 1200px) 30vw, (min-width: 750px) 45vw, 100vw',
          alt: card_alt,
          loading: 'lazy'
      }}
    </span>
  {%- endif -%}

  <span class="hp-journal__body">
    {%- if block.settings.tag != blank -%}
      <span class="hp-journal__tag">{{ block.settings.tag | escape }}</span>
    {%- endif -%}
    <h2 class="hp-journal__title">{{ block.settings.title | escape }}</h2>
    {%- if block.settings.excerpt != blank -%}
      <p class="hp-journal__excerpt">{{ block.settings.excerpt }}</p>
    {%- endif -%}
    <span class="hp-journal__more">
      {{ read_label | default: 'Read the story' | escape }}
      {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
    </span>
  </span>
</a>
