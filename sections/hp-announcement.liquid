{% comment %} THP — Teal announcement marquee (promos scrolling, ✦ separators) {% endcomment %}

{%- style -%}
  .hp-announce {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: var(--hp-font-ui);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hp-announce .hp-marquee__track {
    padding: 0.9rem 0;
    animation-duration: {{ section.settings.speed }}s;
  }
  .hp-announce__item { display: inline-flex; align-items: center; padding: 0 2rem; }
  .hp-announce__item a { color: inherit; text-decoration: none; }
  .hp-announce__item a:hover { text-decoration: underline; text-underline-offset: 0.4em; }
  .hp-announce__star { opacity: 0.7; padding-right: 0.4rem; }
{%- endstyle -%}

<div class="hp-announce">
  <div class="hp-marquee hp-marquee--pause" aria-hidden="true">
    <div class="hp-marquee__track">
      {%- for i in (1..2) -%}
        <span style="display:inline-flex">
          {%- for block in section.blocks -%}
            <span class="hp-announce__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              <span class="hp-announce__star">✦</span>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
              {%- else -%}
                {{ block.settings.text | escape }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
  <p class="visually-hidden">
    {%- for block in section.blocks -%}{{ block.settings.text | escape }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
  </p>
</div>

{% schema %}
{
  "name": "THP Announcement Marquee",
  "tag": "section",
  "class": "hp-announce-section",
  "max_blocks": 8,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1a4b46" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fff9df" },
    {
      "type": "range",
      "id": "speed",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll duration (lower = faster)",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery over Rs. 8,000" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Announcement Marquee",
      "blocks": [
        { "type": "promo" },
        { "type": "promo", "settings": { "text": "5% off online payment" } },
        { "type": "promo", "settings": { "text": "Handcrafted in Pakistan" } },
        { "type": "promo", "settings": { "text": "Nationwide shipping · 3–5 days" } }
      ]
    }
  ]
}
{% endschema %}
