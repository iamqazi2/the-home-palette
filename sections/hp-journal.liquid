{% comment %}
  THP — Journal.

  Built for a Shopify PAGE rather than a Blog, because that is what exists on
  this store (/pages/journals). The trade-off is worth knowing: a Page has no
  article list of its own, so each post is a block here and each post's own page
  is a separate Shopify Page. A real Blog would give article URLs, tags, RSS and
  article schema for free — if one is ever created, this section keeps working
  and can simply be swapped for the blog template.

  Posts link to /pages/<handle>, using the handle typed on each block, which is
  what create-journal-pages.mjs creates. Get the handles matching and the whole
  thing wires itself up.
{% endcomment %}

{%- liquid
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.heading | escape
-%}

{%- style -%}
  .hp-journal-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(28rem, 34vw, 40rem);
    background: var(--hp-teal);
    color: var(--hp-cream);
    overflow: hidden;
  }
  .hp-journal-hero__media { position: absolute; inset: 0; z-index: 0; }
  .hp-journal-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .hp-journal-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(12, 38, 39, 0.88), rgba(18, 53, 54, 0.55));
  }
  .hp-journal-hero__inner { position: relative; z-index: 2; width: 100%; padding: clamp(3.2rem, 6vw, 6rem) 0; }
  .hp-journal-hero__eyebrow { margin: 0 0 1.4rem; }
  .hp-journal-hero__title { margin: 0; color: var(--hp-cream); font-size: var(--hp-h-page); }
  .hp-journal-hero__text {
    margin: 1.4rem 0 0;
    max-width: 56rem;
    font-size: 1.55rem;
    line-height: 1.75;
    color: rgba(255, 249, 223, 0.88);
  }

  .hp-journal { background: {{ section.settings.bg_color | default: '#fffdf4' }}; }

  .hp-journal__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--hp-paper);
    border: 1px solid var(--hp-hairline);
    border-radius: var(--hp-r-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--hp-ink);
    transition: transform 0.45s var(--hp-ease), box-shadow 0.45s var(--hp-ease);
  }
  .hp-journal__card:hover { transform: translateY(-8px); box-shadow: var(--hp-shadow-card); }
  .hp-journal__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--hp-linen);
  }
  .hp-journal__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--hp-ease); }
  .hp-journal__card:hover .hp-journal__media img { transform: scale(1.06); }
  .hp-journal__body { display: flex; flex-direction: column; gap: 0.9rem; padding: 2rem 1.8rem 2.2rem; flex: 1 1 auto; }
  .hp-journal__tag {
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-teal);
  }
  .hp-journal__title {
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: var(--hp-h-block);
    line-height: 1.25;
    letter-spacing: -0.004em;
    color: var(--hp-heading);
  }
  .hp-journal__excerpt {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--hp-taupe);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hp-journal__more {
    margin-top: auto;
    padding-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-teal);
  }
  .hp-journal__more .hp-icon { transition: transform 0.35s var(--hp-ease); }
  .hp-journal__card:hover .hp-journal__more .hp-icon { transform: translateX(4px); }

  /* Lead story: the first post takes the full width, so the page opens with a
     focal point rather than a flat wall of equal cards. */
  .hp-journal__lead { margin-bottom: clamp(2.4rem, 4vw, 4rem); }
  @media screen and (min-width: 900px) {
    .hp-journal__lead .hp-journal__card { flex-direction: row; }
    .hp-journal__lead .hp-journal__media { flex: 0 0 55%; aspect-ratio: auto; }
    .hp-journal__lead .hp-journal__body { justify-content: center; padding: clamp(2.4rem, 3.4vw, 4rem); }
    .hp-journal__lead .hp-journal__title { font-size: var(--hp-h-section); }
    .hp-journal__lead .hp-journal__excerpt { -webkit-line-clamp: 4; font-size: 1.5rem; }
  }

  .hp-journal__grid { display: grid; gap: clamp(1.6rem, 2.4vw, 2.4rem); grid-template-columns: 1fr; }
  @media screen and (min-width: 750px) { .hp-journal__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (min-width: 1200px) { .hp-journal__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
{%- endstyle -%}

<div class="hp-journal-hero">
  {%- if section.settings.hero_image != blank -%}
    <div class="hp-journal-hero__media">
      {{
        section.settings.hero_image
        | image_url: width: 2200
        | image_tag: widths: '600, 900, 1200, 1600, 2200', sizes: '100vw', alt: hero_alt, fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}
  <div class="hp-journal-hero__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp-eyebrow hp-eyebrow--light hp-journal-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="hp-journal-hero__title">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="hp-journal-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

<div class="hp-journal hp-section">
  <div class="hp-container">
    {%- comment -%}
      Lead story rendered outside the loop, and the grid loop then starts at
      offset 1. Opening the grid <div> inside the loop's first iteration and
      closing it after the loop does render correctly, but it leaves the markup
      unbalanced as written — which theme check flags, and which is genuinely
      harder to edit safely later.
    {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="hp-journal__lead" data-hp-reveal {{ section.blocks.first.shopify_attributes }}>
        {% render 'hp-journal-card', block: section.blocks.first, read_label: section.settings.read_label %}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 1 -%}
      <div class="hp-journal__grid" data-hp-stagger>
        {%- for block in section.blocks offset: 1 -%}
          <div data-hp-reveal {{ block.shopify_attributes }}>
            {% render 'hp-journal-card', block: block, read_label: section.settings.read_label %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "THP Journal",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Journal" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tagline",
      "default": "Styling notes, care guides and table stories from The Home Palette."
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fffdf4" },
    { "type": "text", "id": "read_label", "label": "Link label", "default": "Read the story" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt" },
        { "type": "text", "id": "tag", "label": "Category" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "handle",
          "label": "Page handle",
          "info": "The post's own page, e.g. journal-ceramic-vs-porcelain. Links to /pages/<handle>."
        },
        { "type": "url", "id": "url", "label": "Custom link", "info": "Overrides the handle above." }
      ]
    }
  ],
  "presets": [{ "name": "THP Journal", "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }] }]
}
{% endschema %}
