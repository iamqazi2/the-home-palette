{% comment %}
  THP — cart page recommendations, based on the most recently added item so the
  suggestions track what the shopper is actually buying rather than a fixed
  collection. Hidden entirely when the cart is empty.
{% endcomment %}

{%- assign last_item = cart.items | last -%}

{%- if last_item != blank -%}
  <div class="hp-section hp-section--tight">
    <div class="hp-container">
      {% render 'hp-recommendations',
        product: last_item.product,
        recs_section: section.settings.loader_section,
        intent: section.settings.intent,
        heading: section.settings.heading,
        limit: section.settings.limit
      %}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "THP Cart Recommendations",
  "tag": "section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your table" },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "complementary", "label": "Complementary (goes well with)" },
        { "value": "related", "label": "Related (similar products)" }
      ],
      "default": "complementary"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "loader_section",
      "label": "Loader section id",
      "info": "Must match the id of the 'THP Recommendations (loader)' section in this template.",
      "default": "hp_recs"
    }
  ],
  "presets": [{ "name": "THP Cart Recommendations" }]
}
{% endschema %}
