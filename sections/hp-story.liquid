{% comment %} THP — v3 story band: teal split, parallax image left, cream copy + stats right {% endcomment %}

{%- liquid
  assign bg = section.settings.background
  assign band_bg = 'var(--hp-teal)'
  if bg == 'dark'
    assign band_bg = 'var(--hp-teal-ink)'
  elsif bg == 'cream'
    assign band_bg = 'var(--hp-cream)'
  elsif bg == 'custom'
    assign band_bg = section.settings.custom_bg | default: '#257575'
  endif
-%}

{%- style -%}
  .hp-story { background: {{ band_bg }}; color: var(--hp-cream); overflow: hidden; }
  .hp-story--on-cream { color: var(--hp-ink); }
  .hp-story__grid {
    display: grid;
    align-items: stretch;
  }
  @media screen and (min-width: 900px) {
    .hp-story__grid { grid-template-columns: 1.05fr 1fr; min-height: 56rem; }
    .hp-story--flip .hp-story__grid > .hp-story__media-wrap { order: 2; }
  }
  .hp-story__media-wrap {
    position: relative;
    overflow: hidden;
    min-height: 34rem;
  }
  .hp-story__media-wrap img {
    {% if section.settings.sepia %}filter: sepia(0.25) saturate(0.9) contrast(1.02);{% endif %}
  }
  .hp-story__body {
    padding: clamp(2.8rem, 5vw, 5.6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .hp-story__body .hp-eyebrow { color: var(--hp-cream); margin-bottom: 1.4rem; }
  .hp-story--on-cream .hp-story__body .hp-eyebrow { color: var(--hp-teal); }
  .hp-story__heading {
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 4vw, 4.2rem);
    line-height: 1.08;
    margin: 0 0 1.8rem;
    color: inherit;
  }
  .hp-story__text {
    font-size: 1.45rem;
    line-height: 1.85;
    color: rgba(255, 249, 223, 0.85);
    margin: 0 0 2.4rem;
    max-width: 48rem;
  }
  .hp-story--on-cream .hp-story__text { color: var(--hp-taupe); }
  .hp-story__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.8rem, 3vw, 3.2rem);
    margin: 0 0 2.8rem;
    padding: 1.8rem 0;
    list-style: none;
    border-top: 1px solid rgba(255, 249, 223, 0.24);
    border-bottom: 1px solid rgba(255, 249, 223, 0.24);
    align-self: stretch;
  }
  .hp-story--on-cream .hp-story__stats { border-color: var(--hp-hairline-teal); }
  .hp-story__stat-value {
    display: block;
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: 3.2rem;
    line-height: 1;
    color: inherit;
  }
  .hp-story__stat-label {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 249, 223, 0.7);
  }
  .hp-story--on-cream .hp-story__stat-label { color: var(--hp-taupe); }
{%- endstyle -%}

<div class="hp-story{% if section.settings.flip %} hp-story--flip{% endif %}{% if bg == 'cream' %} hp-story--on-cream{% endif %}">
  <div class="hp-story__grid">
    <div class="hp-story__media-wrap">
      <div class="hp-media-frame" data-hp-parallax>
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 52vw, 100vw', loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
    <div class="hp-story__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-story__heading" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hp-story__text" data-hp-reveal>{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank -%}
        <ul class="hp-story__stats" data-hp-reveal>
          {%- if section.settings.stat_1_value != blank -%}
            <li>
              <span class="hp-story__stat-value">{{ section.settings.stat_1_value | escape }}</span>
              <span class="hp-story__stat-label">{{ section.settings.stat_1_label | escape }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.stat_2_value != blank -%}
            <li>
              <span class="hp-story__stat-value">{{ section.settings.stat_2_value | escape }}</span>
              <span class="hp-story__stat-label">{{ section.settings.stat_2_label | escape }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.stat_3_value != blank -%}
            <li>
              <span class="hp-story__stat-value">{{ section.settings.stat_3_value | escape }}</span>
              <span class="hp-story__stat-label">{{ section.settings.stat_3_label | escape }}</span>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div data-hp-reveal>
          <a
            {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% endif %}
            class="hp-btn {% if bg == 'cream' %}hp-btn--outline{% else %}hp-btn--cream-solid{% endif %}"
          >
            {{ section.settings.button_label | escape }}
            {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Story Split",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "background",
      "label": "Band colour",
      "options": [
        { "value": "teal", "label": "Brand teal" },
        { "value": "dark", "label": "Deep teal" },
        { "value": "cream", "label": "Cream" },
        { "value": "custom", "label": "Custom colour" }
      ],
      "default": "teal"
    },
    { "type": "color", "id": "custom_bg", "label": "Custom band colour", "info": "Used when Band colour is set to Custom.", "default": "#257575" },
    { "type": "checkbox", "id": "sepia", "label": "Sepia treatment on image", "default": false },
    { "type": "checkbox", "id": "flip", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter Two — The Craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted in Pakistan, Made for Fine Dining" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece begins in the hands of Pakistani artisans.</p>" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "100%" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Handcrafted" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the Craft" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "THP Story Split" }]
}
{% endschema %}
