{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Collections like "All products" have no image of their own, which left those
  # heroes as a flat teal band. Fall back to a section-level image so every
  # collection page gets a photo without one having to be set per collection.
  assign hero_image = collection.image | default: section.settings.hp_fallback_image
  assign hero_alt = hero_image.alt | default: collection.title | escape
  assign has_hero_image = false
  if section.settings.show_collection_image and hero_image != blank
    assign has_hero_image = true
  endif

  case section.settings.hp_height
    when 'small'
      assign hp_band_height = 'clamp(26rem, 32vw, 36rem)'
    when 'large'
      assign hp_band_height = 'clamp(42rem, 58vw, 68rem)'
    else
      assign hp_band_height = 'clamp(34rem, 44vw, 52rem)'
  endcase
-%}

{%- comment -%}
  THP: full-bleed collection banner — photo covering the whole band with the
  title over it, instead of Dawn's side-by-side "text left / image right".

  This lives here rather than in hp-theme.css on purpose. The stylesheet_tag
  above loads component-collection-hero.css into <body>, which is later in
  document order than hp-theme.css in <head>, so Dawn's hero rules beat that
  file at equal specificity. This block renders after the stylesheet_tag, so it
  wins on order and needs almost no !important.

  What was broken: hp-theme.css absolutely positioned the image container but
  also made .collection-hero__inner position: relative. The image container is
  a CHILD of that inner (see the markup below), so inset: 0 sized it to the
  padded, page-width inner rather than the full band — that is the photo
  floating with teal margins around it. And because the image was the only
  positioned element in that context, it painted over the heading, which is why
  the collection title had vanished entirely.
{%- endcomment -%}
{%- style -%}
  .collection-hero {
    position: relative;
    overflow: hidden;
    background: var(--hp-teal);
    color: var(--hp-cream);
    padding: 0;
  }

  /* Plain padded block, not Dawn's flex row — and critically position: static,
     so the absolutely positioned image below anchors to .collection-hero (the
     full band) rather than to this padded, page-width box. */
  .collection-hero__inner {
    display: block;
    position: static;
    padding-top: clamp(3.2rem, 6vw, 6rem);
    padding-bottom: clamp(3.2rem, 6vw, 6rem);
  }

  /* Positioned with a z-index so the title sits above both the photo and its
     scrim. Without this the heading is painted over by the image. */
  .collection-hero__text-wrapper {
    position: relative;
    z-index: 2;
    flex-basis: auto;
    padding: 0;
  }
  .collection-hero__title {
    margin: 0;
    color: var(--hp-cream);
  }
  .collection-hero__description,
  .collection-hero__tagline {
    margin: 1.4rem 0 0;
    max-width: 56rem;
    font-size: 1.55rem;
    line-height: 1.75;
    color: rgba(255, 249, 223, 0.88);
  }
  .collection-hero__eyebrow { margin: 0 0 1.4rem; }
  .collection-hero__cta { margin-top: 2.4rem; }
  @media screen and (max-width: 749px) {
    .collection-hero__tagline { font-size: 1.4rem; }
    .collection-hero__cta { margin-top: 2rem; }
  }

  /* With the photo taken out of flow, nothing is left to give the band height
     but the title, so it would collapse to a thin strip. A min-height restores
     a proper banner, and centring the inner puts the title in the middle of the
     image rather than pinned to its top edge. */
  .collection-hero {
    display: flex;
    align-items: center;
    min-height: {{ hp_band_height }};
  }
  .collection-hero .collection-hero__inner { width: 100%; }

  /* Photo fills the band. Dawn's border, radius, shadow, fixed heights and
     flex sizing all assume the side-by-side layout, so each is reset. */
  .collection-hero--with-image .collection-hero__inner { padding-bottom: clamp(3.2rem, 6vw, 6rem); }
  .collection-hero--with-image .collection-hero__text-wrapper { padding: 0; }
  .collection-hero--with-image .collection-hero__image-container {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    height: auto;
    min-height: 0;
    align-self: auto;
    flex: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .collection-hero--with-image .collection-hero__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Scrim between photo and text, so the title stays readable over a light or
     busy image. Sits at z-index 1: above the photo, below the text. */
  .collection-hero--with-image::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(12, 38, 39, 0.86), rgba(18, 53, 54, 0.5));
  }
  .collection-hero--with-image .collection-hero__title,
  .collection-hero--with-image .collection-hero__description,
  .collection-hero--with-image .collection-hero__tagline {
    text-shadow: 0 2px 16px rgba(12, 38, 39, 0.65);
  }

  /* Dawn re-applies the split layout and its own band padding above 750px. */
  @media screen and (min-width: 750px) {
    .collection-hero.collection-hero--with-image { padding: 0; overflow: hidden; }
    .collection-hero__inner { display: block; align-items: initial; flex-direction: column; padding-bottom: clamp(3.2rem, 6vw, 6rem); }
    .collection-hero--with-image .collection-hero__text-wrapper { padding: 0; flex-basis: auto; }
    .collection-hero--with-image .collection-hero__image-container { margin-left: 0; flex: none; min-height: 0; }
  }
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__image-container { height: auto; }
    .collection-hero--with-image .collection-hero__inner { padding-bottom: clamp(3.2rem, 6vw, 6rem); }
  }
{%- endstyle -%}

<div class="collection-hero{% if has_hero_image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- if section.settings.hp_eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--light collection-hero__eyebrow">{{ section.settings.hp_eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- liquid
        # Tagline is per page without any per-page setting: it uses each
        # collection's own description, which the merchant already writes in the
        # admin. The section-level line is only a fallback for collections that
        # have no description yet, so no page is ever left with a bare title.
        assign hp_tagline = ''
        if collection.description != blank
          assign hp_tagline = collection.description | strip_html | strip | truncatewords: 28
        elsif section.settings.hp_tagline != blank
          assign hp_tagline = section.settings.hp_tagline
        endif
      -%}
      {%- if section.settings.hp_show_tagline and hp_tagline != blank -%}
        <p class="collection-hero__tagline">{{ hp_tagline }}</p>
      {%- endif -%}

      {%- if section.settings.hp_cta_label != blank -%}
        {%- comment -%}
          The visitor is already on the collection, so this scrolls to the grid
          rather than navigating anywhere. #ProductGridContainer is the id
          main-collection-product-grid gives its results wrapper.
        {%- endcomment -%}
        <a class="hp-btn hp-btn--cream-solid collection-hero__cta" href="#ProductGridContainer">
          {{ section.settings.hp_cta_label | escape }}
          {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
        </a>
      {%- endif -%}
    </div>

    {%- if has_hero_image -%}
      <div class="collection-hero__image-container media gradient">
        {{
          hero_image
          | image_url: width: 2200
          | image_tag:
            widths: '600, 900, 1200, 1600, 2200',
            sizes: '100vw',
            alt: hero_alt,
            fetchpriority: 'high'
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "select",
      "id": "hp_height",
      "label": "Banner height",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "text",
      "id": "hp_eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "checkbox",
      "id": "hp_show_tagline",
      "label": "Show tagline",
      "default": true,
      "info": "Uses each collection's own description, so every page gets its own line."
    },
    {
      "type": "textarea",
      "id": "hp_tagline",
      "label": "Fallback tagline",
      "default": "Handcrafted pieces, made for the way you actually set the table.",
      "info": "Shown only on collections that have no description of their own."
    },
    {
      "type": "text",
      "id": "hp_cta_label",
      "label": "Button label",
      "default": "Shop the collection",
      "info": "Scrolls down to the products. Leave empty to hide the button."
    },
    {
      "type": "image_picker",
      "id": "hp_fallback_image",
      "label": "Fallback banner image",
      "info": "Used on collections that have no image of their own, such as All products."
    }
  ]
}
{% endschema %}
