{% comment %}
  THP — hospitality gallery.

  A mosaic on a fixed grid: tiles are one cell, two cells tall, or two cells
  wide, packed densely so the wall ends on a straight edge.

  It used to be a CSS column layout, which kept each photograph's own
  proportions but balanced the columns by height — with a handful of large
  portrait shots that left one column hanging far below the others and a band
  of empty page beneath the rest. A fixed grid crops a little but always tiles.

  Tile size defaults to the photograph's own orientation (portrait becomes a
  tall tile) and can be overridden per block.
{% endcomment %}

{%- style -%}
  .hp-hgal { background: {{ section.settings.bg_color | default: '#fff9df' }}; }

  .hp-hgal__wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Rows are portrait-shaped, because most service photography is shot on a
       phone held upright — landscape shots centre-crop into them far more
       gracefully than portraits crop into a landscape cell. */
    grid-auto-rows: clamp(19rem, 52vw, 26rem);
    grid-auto-flow: dense;
    gap: clamp(1rem, 1.6vw, 1.8rem);
  }
  @media screen and (min-width: 990px) {
    .hp-hgal__wall {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
      grid-auto-rows: clamp(24rem, 24vw, 34rem);
    }
  }
  .hp-hgal__item--tall { grid-row: span 2; }
  .hp-hgal__item--wide { grid-column: span 2; }

  /* Safety net for a ragged final row: the last tile stretches from wherever
     it lands to the end of the grid, so the wall always closes on a straight
     edge no matter how many photographs are in it. A tile that already sits in
     the last column is unaffected. */
  .hp-hgal__item:last-child { grid-column-end: -1; }

  .hp-hgal__item {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: var(--hp-r-card);
    overflow: hidden;
    background: var(--hp-linen);
    transition: transform 0.5s var(--hp-ease), box-shadow 0.5s var(--hp-ease);
  }
  .hp-hgal__item:hover { transform: translateY(-6px); box-shadow: var(--hp-shadow-card); }
  .hp-hgal__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--hp-ease);
  }
  .hp-hgal__item:hover img { transform: scale(1.05); }

  .hp-hgal__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 35, 32, 0) 45%, rgba(10, 35, 32, 0.78) 100%);
    opacity: 0;
    transition: opacity 0.5s var(--hp-ease);
    pointer-events: none;
  }
  .hp-hgal__item:hover .hp-hgal__veil { opacity: 1; }

  .hp-hgal__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.8rem;
    color: var(--hp-cream);
    transform: translateY(10px);
    opacity: 0;
    transition: opacity 0.5s var(--hp-ease), transform 0.5s var(--hp-ease);
    pointer-events: none;
  }
  .hp-hgal__item:hover .hp-hgal__cap { opacity: 1; transform: translateY(0); }
  .hp-hgal__cap-venue {
    display: block;
    font-family: var(--hp-font-display);
    font-size: 1.9rem;
    line-height: 1.2;
  }
  .hp-hgal__cap-note {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 249, 223, 0.72);
  }

  /* Touch devices have no hover, so the caption would never appear — pin it
     open there instead of hiding the information entirely. */
  @media (hover: none) {
    .hp-hgal__veil { opacity: 1; }
    .hp-hgal__cap { opacity: 1; transform: none; padding: 1.4rem; }
    .hp-hgal__cap-venue { font-size: 1.6rem; }
  }

  .hp-hgal__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.6rem 2.4rem;
    margin-top: clamp(2.4rem, 3.4vw, 3.6rem);
    text-align: center;
  }
  .hp-hgal__foot-text {
    margin: 0;
    max-width: 58rem;
    font-size: 1.4rem;
    line-height: 1.75;
    color: var(--hp-taupe);
  }
{%- endstyle -%}

<div class="hp-hgal hp-section">
  <div class="hp-container">
    <div class="hp-section-head{% if section.settings.center_head %} hp-section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-hgal__wall">
      {%- for block in section.blocks -%}
        {%- if block.settings.image == blank -%}{%- continue -%}{%- endif -%}
        {%- assign alt = block.settings.venue | default: section.settings.heading -%}
        {%- liquid
          assign size = block.settings.size
          if size == blank or size == 'auto'
            assign size = 'standard'
            if block.settings.image.height > block.settings.image.width
              assign size = 'tall'
            endif
          endif
        -%}
        <figure class="hp-hgal__item hp-hgal__item--{{ size }}" data-hp-reveal {{ block.shopify_attributes }}>
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag: widths: '400, 600, 800, 1100, 1400', sizes: '(min-width: 990px) 26vw, 48vw', loading: 'lazy', alt: alt
          }}
          <span class="hp-hgal__veil"></span>
          {%- if block.settings.venue != blank or block.settings.note != blank -%}
            <figcaption class="hp-hgal__cap">
              {%- if block.settings.venue != blank -%}
                <span class="hp-hgal__cap-venue">{{ block.settings.venue | escape }}</span>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <span class="hp-hgal__cap-note">{{ block.settings.note | escape }}</span>
              {%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.foot_text != blank or section.settings.button_label != blank -%}
      <div class="hp-hgal__foot" data-hp-reveal>
        {%- if section.settings.foot_text != blank -%}
          <p class="hp-hgal__foot-text">{{ section.settings.foot_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
            class="hp-btn"
          >
            {{ section.settings.button_label | escape }}
            {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "THP Hospitality Gallery",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fff9df" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "center_head", "label": "Centre the heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In Service" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Crockery, Mid-Shift" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Not styled studio shots — plates, cups and chafing dishes photographed on the tables they were made for."
    },
    { "type": "textarea", "id": "foot_text", "label": "Closing note" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Your Order" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "venue", "label": "Caption", "info": "Shown on hover, e.g. the venue or the dish." },
        { "type": "text", "id": "note", "label": "Sub-caption", "info": "Small uppercase line under the caption." },
        {
          "type": "select",
          "id": "size",
          "label": "Tile size",
          "info": "Auto makes portrait photos tall and everything else a single cell.",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "standard", "label": "Single cell" },
            { "value": "tall", "label": "Tall (2 rows)" },
            { "value": "wide", "label": "Wide (2 columns)" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Hospitality Gallery",
      "blocks": [{ "type": "shot" }, { "type": "shot" }, { "type": "shot" }, { "type": "shot" }, { "type": "shot" }, { "type": "shot" }]
    }
  ]
}
{% endschema %}
