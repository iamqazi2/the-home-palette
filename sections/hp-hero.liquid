{% comment %} THP — Full-height cinematic hero slider {% endcomment %}

{%- style -%}
  .hp-hero {
    position: relative;
    display: block;
    height: 100svh;
    min-height: 56rem;
    max-height: 120rem;
    overflow: hidden;
    background: var(--hp-moss);
    color: var(--hp-cream);
  }
  .hp-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.4s var(--hp-ease), visibility 0s 1.4s;
    z-index: 1;
  }
  .hp-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.4s var(--hp-ease);
    z-index: 2;
  }
  .hp-hero__media,
  .hp-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hp-hero__slide.is-active .hp-hero__media img {
    animation: hp-kenburns 9s var(--hp-ease) forwards;
  }
  @keyframes hp-kenburns {
    from { transform: scale(1.1) translateX(1.5%); }
    to { transform: scale(1) translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero__slide { transition: none; }
    .hp-hero__slide.is-active .hp-hero__media img { animation: none; }
  }
  .hp-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(14, 6, 6, 0.72) 0%, rgba(14, 6, 6, 0.24) 42%, rgba(14, 6, 6, 0.12) 100%);
  }
  /* inset hairline frame — the "plate rim" */
  .hp-hero__frame {
    position: absolute;
    inset: 1.6rem;
    border: 1px solid rgba(255, 249, 223, 0.34);
    pointer-events: none;
    z-index: 4;
  }
  @media screen and (min-width: 750px) { .hp-hero__frame { inset: 2.4rem; } }

  .hp-hero__content {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: clamp(9rem, 16vh, 14rem);
    padding: 0 clamp(2.8rem, 6vw, 8rem);
    max-width: 92rem;
  }
  .hp-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--hp-cream);
    margin-bottom: 2rem;
  }
  .hp-hero__kicker::before {
    content: '';
    width: 4.4rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }
  .hp-hero__heading {
    font-family: var(--hp-font-display);
    font-weight: 500;
    font-size: clamp(4rem, 8.5vw, 9rem);
    line-height: 1.02;
    letter-spacing: 0.005em;
    margin: 0;
    color: var(--hp-cream);
  }
  .hp-hero__sub {
    margin: 2rem 0 0;
    font-size: clamp(1.4rem, 1.6vw, 1.7rem);
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: rgba(239, 236, 236, 0.92);
    max-width: 48rem;
  }
  .hp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-top: 3.2rem;
  }
  /* staggered rise on the active slide's copy */
  .hp-hero__kicker, .hp-hero__heading, .hp-hero__sub, .hp-hero__actions {
    opacity: 0;
    transform: translateY(26px);
  }
  .hp-hero__slide.is-active .hp-hero__kicker,
  .hp-hero__slide.is-active .hp-hero__heading,
  .hp-hero__slide.is-active .hp-hero__sub,
  .hp-hero__slide.is-active .hp-hero__actions {
    animation: hp-hero-rise 1s var(--hp-ease) forwards;
  }
  .hp-hero__slide.is-active .hp-hero__kicker { animation-delay: 0.25s; }
  .hp-hero__slide.is-active .hp-hero__heading { animation-delay: 0.4s; }
  .hp-hero__slide.is-active .hp-hero__sub { animation-delay: 0.55s; }
  .hp-hero__slide.is-active .hp-hero__actions { animation-delay: 0.7s; }
  @keyframes hp-hero-rise {
    to { opacity: 1; transform: none; }
  }
  html:not(.hp-js) .hp-hero__kicker,
  html:not(.hp-js) .hp-hero__heading,
  html:not(.hp-js) .hp-hero__sub,
  html:not(.hp-js) .hp-hero__actions {
    opacity: 1; transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero__kicker, .hp-hero__heading, .hp-hero__sub, .hp-hero__actions {
      opacity: 1 !important; transform: none !important; animation: none !important;
    }
  }

  /* chrome: arrows, dots, counter, scroll cue */
  .hp-hero__chrome {
    position: absolute;
    z-index: 5;
    left: 0; right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 clamp(2.8rem, 6vw, 8rem) 3.2rem;
  }
  .hp-hero__dots { display: flex; gap: 1rem; align-items: center; }
  .hp-hero__dot {
    width: 3.2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    position: relative;
  }
  .hp-hero__dot::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    height: 1px;
    background: rgba(255, 249, 223, 0.4);
    transition: background 0.3s ease, height 0.3s ease, transform 0.3s ease;
  }
  .hp-hero__dot.is-active::after { background: var(--hp-cream); height: 3px; transform: translateY(-1px); }
  .hp-hero__counter {
    font-family: var(--hp-font-display);
    font-size: 1.6rem;
    letter-spacing: 0.2em;
    color: rgba(239, 236, 236, 0.85);
    white-space: nowrap;
  }
  .hp-hero__counter-current { color: var(--hp-cream); font-size: 2.2rem; }
  .hp-hero__nav { display: flex; gap: 0.8rem; }
  .hp-hero__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    background: transparent;
    border: 1px solid rgba(255, 249, 223, 0.4);
    border-radius: 50%;
    color: var(--hp-cream);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .hp-hero__arrow:hover { background: var(--hp-cream); color: var(--hp-ink); border-color: var(--hp-cream); }
  .hp-hero__cue {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 3rem;
    transform: translateX(-50%);
    color: rgba(255, 249, 223, 0.85);
    display: none;
    animation: hp-cue 2.6s ease-in-out infinite;
  }
  @media screen and (min-width: 990px) { .hp-hero__cue { display: block; } }
  @keyframes hp-cue {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }
  @media (prefers-reduced-motion: reduce) { .hp-hero__cue { animation: none; } }
  @media screen and (max-width: 749px) {
    .hp-hero__counter { display: none; }
  }
{%- endstyle -%}

<hp-hero
  class="hp-hero"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed }}"
  tabindex="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- for block in section.blocks -%}
    <div
      class="hp-hero__slide{% if forloop.first %} is-active{% endif %}"
      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
      role="group"
      aria-roledescription="slide"
      aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
      {{ block.shopify_attributes }}
    >
      <div class="hp-hero__media">
        {%- if block.settings.image -%}
          {%- liquid
            if forloop.first
              assign img_loading = 'eager'
              assign img_priority = 'high'
            else
              assign img_loading = 'lazy'
              assign img_priority = 'auto'
            endif
          -%}
          {{
            block.settings.image
            | image_url: width: 3200
            | image_tag:
              widths: '750, 1100, 1500, 1780, 2000, 3000, 3200',
              sizes: '100vw',
              loading: img_loading,
              fetchpriority: img_priority
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="hp-hero__scrim"></div>
      <div class="hp-hero__content">
        {%- if block.settings.kicker != blank -%}
          <p class="hp-hero__kicker">{{ block.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="hp-hero__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if block.settings.subheading != blank -%}
          <p class="hp-hero__sub">{{ block.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <div class="hp-hero__actions">
            <a
              {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="hp-btn hp-btn--cream"
            >
              {{ block.settings.button_label | escape }}
              {% render 'hp-icon', icon: 'arrow-right', size: 16 %}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  <div class="hp-hero__frame"></div>

  {%- if section.blocks.size > 1 -%}
    <div class="hp-hero__chrome">
      <div class="hp-hero__dots" role="tablist" aria-label="{{ section.settings.accessibility_info | escape }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hp-hero__dot{% if forloop.first %} is-active{% endif %}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="hp-hero__counter">
        <span class="hp-hero__counter-current">01</span>
        <span aria-hidden="true">/ {% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</span>
      </div>
      <div class="hp-hero__nav">
        <button type="button" class="hp-hero__arrow hp-hero__arrow--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-left', size: 18 %}
        </button>
        <button type="button" class="hp-hero__arrow hp-hero__arrow--next" aria-label="{{ 'general.slider.next_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-right', size: 18 %}
        </button>
      </div>
    </div>
  {%- endif -%}

  <div class="hp-hero__cue">
    {% render 'hp-icon', icon: 'chevron-down', size: 22 %}
  </div>
</hp-hero>

{% schema %}
{
  "name": "THP Hero Slider",
  "tag": "section",
  "class": "hp-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Slideshow description",
      "default": "Slideshow about our brand"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Handcrafted Heritage" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Table Remembers" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Premium serveware, crafted in Pakistan." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Hero Slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
