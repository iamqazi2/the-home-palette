{% comment %}
  THP — v4 cinematic hero.

  A single full-bleed stage: background video (or Ken-Burns image slides) under a
  layered treatment — directional gradient + centre vignette + film grain — so the
  footage reads as intentional and filmic rather than raw. Copy rotates with a
  cascade reveal; chrome is a thin progress rail plus a scroll cue.

  Video sharpness: the clip is rendered at full stage size with `object-fit: cover`
  and no scaling filters, and a poster keeps the first paint crisp. If the source
  file is low-resolution it will still soften when stretched — upload a 1920×1080
  (or larger) master and it will render 1:1.
{% endcomment %}

{%- liquid
  assign has_video = false
  if section.settings.video != null or section.settings.video_url != blank or section.settings.video_url_mobile != blank
    assign has_video = true
  endif

  assign h = section.settings.height
  assign hero_h = '88vh'
  if h == 'full'
    assign hero_h = '100svh'
  elsif h == 'compact'
    assign hero_h = '76vh'
  endif

  assign shade = section.settings.overlay_strength | divided_by: 100.0
  assign shade_mid = shade | times: 0.6
  assign shade_low = shade | times: 0.22
  assign shade_rgb = section.settings.overlay_color | default: '#1a4b46' | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign hero_text = section.settings.text_color | default: '#fff9df'

  # ---- Poster still --------------------------------------------------------
  # Without one, a phone looks at a flat block of overlay colour for as long as
  # it takes the clip to arrive — and the clip is deliberately held back until
  # the page has loaded and gone idle, so that is seconds, not milliseconds.
  # Worse for the score: the video's first frame then becomes the Largest
  # Contentful Paint, timed at whenever the download finished. A still painted
  # into the same box, at the same size, takes that role instead and takes it
  # early — LCP only updates for an element LARGER than the current best, and
  # the video is exactly the same size, so it never displaces the still.
  #
  # The bundled files are frame 0 of the two clips configured when they were
  # made, which is why the swap is invisible: the still IS the frame the video
  # opens on. Change either video without replacing its still (via the
  # thumbnail fields below) and that stops being true for the one you changed.
  # Desktop and phone each pick their own upload independently, then each
  # falls back to the matching half of the bundled still on its own — so
  # uploading only one (say, after swapping just the phone clip) does not
  # blank out the other, which still has a real video to match.
  assign poster_wide = ''
  assign poster_phone = ''
  if has_video and section.settings.video_poster_desktop
    assign poster_wide = section.settings.video_poster_desktop | image_url: width: 1600
  elsif has_video and section.settings.builtin_poster
    assign poster_wide = 'hp-hero-poster.webp' | asset_url
  endif
  if has_video and section.settings.video_poster_mobile
    assign poster_phone = section.settings.video_poster_mobile | image_url: width: 640
  elsif has_video and section.settings.builtin_poster
    assign poster_phone = 'hp-hero-poster-mobile.webp' | asset_url
  endif
-%}

{%- if poster_phone != blank -%}
  {%- comment -%}
    A background-image is not fetched until the box that carries it has been
    laid out, which is late for the thing that is now the page's LCP. These
    two preloads hand the URL to the preload scanner instead, so the fetch
    starts alongside the stylesheet rather than after it. `media` keeps each
    screen to the one file it will actually paint.
  {%- endcomment -%}
  <link rel="preload" as="image" href="{{ poster_phone }}" media="(max-width: 749px)" fetchpriority="high">
  <link rel="preload" as="image" href="{{ poster_wide }}" media="(min-width: 750px)" fetchpriority="high">
{%- endif -%}

{%- style -%}
  .hp-hero {
    position: relative;
    display: block;
    height: {{ hero_h }};
    min-height: 58rem;
    max-height: 110rem;
    overflow: hidden;
    background: {{ section.settings.overlay_color | default: '#1a4b46' }};
    color: {{ hero_text }};
    isolation: isolate;
  }
  @media screen and (max-width: 749px) { .hp-hero { min-height: 60rem; height: 92vh; } }

  /* ---- stage layers ---- */
  .hp-hero__video, .hp-hero__media { z-index: 0; }
  .hp-hero__video video,
  .hp-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.focal | default: 'center' }};
    /* no upscaling filters — keeps the source as sharp as it was uploaded */
    image-rendering: auto;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
  {%- unless has_video -%}
  .hp-hero__slide.is-active .hp-hero__media img { animation: hp-kenburns 16s ease-out both; }
  {%- endunless -%}

  .hp-hero__slide {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.1s var(--hp-ease), visibility 0s 1.1s;
  }
  .hp-hero__slide.is-active {
    opacity: 1; visibility: visible; z-index: 2;
    transition: opacity 1.1s var(--hp-ease);
  }
  {%- if has_video -%}
  .hp-hero__slide { pointer-events: none; }
  .hp-hero__slide.is-active { pointer-events: auto; }
  {%- endif -%}
  .hp-hero__media { position: absolute; inset: 0; }

  {%- if poster_wide != blank -%}
  /* The still is painted as a background on the stage rather than as the
     video's poster attribute. A poster is one URL for every screen, so a phone
     was downloading the 2400px desktop still — on mobile that outweighed the
     clip it sits in front of. As a background it can be served at a size that
     suits the screen, it still shows with JavaScript off, and it is what the
     video fades in over once it is ready. */
  .hp-hero__video {
    background-image: url({{ poster_wide }});
    background-size: cover;
    background-position: {{ section.settings.focal | default: 'center' }};
    background-repeat: no-repeat;
  }
  @media screen and (max-width: 749px) {
    .hp-hero__video {
      background-image: url({{ poster_phone }});
    }
  }
  /* The clip crossfades in over the still it opens on, so the moment the
     download lands is not a visible cut. Until then the <video> holds no file
     and paints nothing, and the still behind it is what the visitor sees. */
  .hp-hero__video video {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .hp-hero__video video.is-playing { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero__video video { transition: none; }
  }
  {%- endif -%}

  /* Directional wash + a flat full-frame floor underneath it. The floor
     guarantees a minimum contrast level no matter which part of the video is
     showing (busy/bright footage can wash out a pure gradient on its own),
     while the gradient still reads as an intentional, editorial vignette
     rather than a flat tint. */
  .hp-hero__scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(
        100deg,
        rgba({{ shade_rgb }}, {{ shade }}) 0%,
        rgba({{ shade_rgb }}, {{ shade_mid }}) 48%,
        rgba({{ shade_rgb }}, {{ shade_low }}) 100%
      ),
      rgba({{ shade_rgb }}, {{ shade_low | at_least: 0.22 }});
  }
  .hp-hero--center .hp-hero__scrim {
    background:
      linear-gradient(
        180deg,
        rgba({{ shade_rgb }}, {{ shade_mid }}) 0%,
        rgba({{ shade_rgb }}, {{ shade_low }}) 45%,
        rgba({{ shade_rgb }}, {{ shade }}) 100%
      ),
      rgba({{ shade_rgb }}, {{ shade_low | at_least: 0.22 }});
  }
  /* centre vignette — adds depth and hides soft edges on low-res footage */
  .hp-hero__vignette {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      radial-gradient(120% 90% at 50% 45%, transparent 32%, rgba(8, 26, 27, 0.62) 100%),
      linear-gradient(to top, rgba(8, 26, 27, 0.58) 0%, transparent 34%);
  }
  /* Localised shade directly behind the text block — the 'text_shade' setting.
     A soft dark pool that hugs the copy, so it stays legible even on a frame
     where the wide scrim alone is not quite enough (bright, high-detail food
     / product footage especially). */
  {%- if section.settings.text_shade -%}
  .hp-hero__inner { position: relative; }
  .hp-hero__inner::before {
    content: '';
    position: absolute;
    inset: -3.2rem -4rem;
    z-index: -1;
    background: radial-gradient(
      ellipse 78% 92% at 22% 50%,
      rgba(8, 26, 27, 0.6),
      rgba(8, 26, 27, 0.32) 55%,
      transparent 80%
    );
    pointer-events: none;
  }
  .hp-hero--center .hp-hero__inner::before {
    background: radial-gradient(
      ellipse 90% 92% at 50% 50%,
      rgba(8, 26, 27, 0.6),
      rgba(8, 26, 27, 0.32) 55%,
      transparent 80%
    );
  }
  {%- endif -%}
  {%- if section.settings.grain -%}
  /* fine film grain — the "vintage classic" texture */
  .hp-hero__grain {
    position: absolute; inset: -50%; z-index: 4; pointer-events: none;
    opacity: 0.14;
    background-image:
      radial-gradient(rgba(255,249,223,0.5) 0.5px, transparent 0.6px),
      radial-gradient(rgba(0,0,0,0.4) 0.5px, transparent 0.6px);
    background-size: 3px 3px, 4px 4px;
    background-position: 0 0, 1px 2px;
    animation: hp-grain 1.2s steps(3) infinite;
  }
  @keyframes hp-grain {
    0%   { transform: translate(0, 0); }
    33%  { transform: translate(-2%, 1%); }
    66%  { transform: translate(1%, -2%); }
    100% { transform: translate(0, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .hp-hero__grain { animation: none; } }
  /* On a phone the grain keeps its texture but loses its shimmer.

     The animation is why the layer is drawn at inset: -50% — it needs slack to
     translate into — and that makes it four times the area of the hero, which
     is itself most of the screen. Composited at a phone's pixel ratio that is
     a very large texture, re-composited every frame, for the entire time the
     hero exists, whether or not anyone is still looking at it. The static
     grain is what actually does the work of masking compression; the drift is
     a desktop flourish, and on a small screen at arm's length it is close to
     invisible anyway. Without the animation the layer no longer needs the
     slack either, so it shrinks to the hero's own box. */
  @media screen and (max-width: 749px) {
    .hp-hero__grain { inset: 0; animation: none; }
  }
  {%- endif -%}

  /* ---- copy ---- */
  .hp-hero__content {
    position: absolute; z-index: 6; inset: 0;
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 var(--hp-gap-x);
    padding-bottom: 8rem;
  }
  .hp-hero__inner { max-width: 68rem; }
  .hp-hero--center .hp-hero__content { align-items: center; text-align: center; }
  .hp-hero--center .hp-hero__inner { max-width: 76rem; }

  .hp-hero__kicker {
    display: inline-flex; align-items: center; gap: 1rem;
    font-family: var(--hp-font-ui);
    font-size: 1.05rem; font-weight: 600;
    letter-spacing: 0.32em; text-transform: uppercase;
    color: {{ hero_text }};
    margin: 0 0 1.8rem;
    opacity: 0.92;
    text-shadow: 0 1px 3px rgba(8, 26, 27, 0.7), 0 3px 16px rgba(8, 26, 27, 0.55);
  }
  .hp-hero__kicker::before { content: ''; width: 3.2rem; height: 1px; background: currentColor; opacity: 0.8; }
  .hp-hero--center .hp-hero__kicker::after { content: ''; width: 3.2rem; height: 1px; background: currentColor; opacity: 0.8; }

  .hp-hero__heading {
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: clamp(4rem, 7.4vw, 8.4rem);
    line-height: 0.98;
    letter-spacing: -0.008em;
    margin: 0;
    color: {{ hero_text }};
    text-shadow: 0 2px 4px rgba(8, 26, 27, 0.7), 0 6px 44px rgba(8, 26, 27, 0.6);
  }
  .hp-hero__rule {
    width: 7rem; height: 1px; margin: 2.4rem 0 0;
    background: currentColor; opacity: 0.45;
  }
  .hp-hero--center .hp-hero__rule { margin-left: auto; margin-right: auto; }
  .hp-hero__sub {
    margin: 2rem 0 0;
    font-size: clamp(1.45rem, 1.5vw, 1.7rem);
    line-height: 1.75;
    letter-spacing: 0.01em;
    color: {{ hero_text }};
    opacity: 0.86;
    max-width: 46rem;
    text-shadow: 0 1px 3px rgba(8, 26, 27, 0.7), 0 4px 24px rgba(8, 26, 27, 0.6);
  }
  .hp-hero--center .hp-hero__sub { margin-left: auto; margin-right: auto; }
  .hp-hero__actions { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 3rem; }
  .hp-hero--center .hp-hero__actions { justify-content: center; }

  .hp-hero__rating {
    display: inline-flex; align-items: center; gap: 1rem;
    margin-top: 3rem; padding: 0.9rem 1.7rem;
    border-radius: var(--hp-r-pill);
    background: rgba(8, 26, 27, 0.34);
    border: 1px solid rgba(255, 249, 223, 0.22);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    width: fit-content;
  }
  .hp-hero--center .hp-hero__rating { margin-left: auto; margin-right: auto; }
  .hp-hero__rating-score { font-family: var(--hp-font-display); font-weight: 600; font-size: 2rem; color: {{ hero_text }}; }
  .hp-hero__rating-text { font-size: 1.15rem; letter-spacing: 0.05em; color: {{ hero_text }}; opacity: 0.82; }

  /* entrance: cascade drop, staggered */
  .hp-hero__kicker, .hp-hero__heading, .hp-hero__rule,
  .hp-hero__sub, .hp-hero__actions, .hp-hero__rating {
    opacity: 0;
    transform: translateY(-28px);
    filter: blur(10px);
  }
  .hp-hero__slide.is-active .hp-hero__kicker,
  .hp-hero__slide.is-active .hp-hero__heading,
  .hp-hero__slide.is-active .hp-hero__rule,
  .hp-hero__slide.is-active .hp-hero__sub,
  .hp-hero__slide.is-active .hp-hero__actions,
  .hp-hero__slide.is-active .hp-hero__rating {
    animation: hp-hero-cascade 1.15s var(--hp-ease) forwards;
  }
  .hp-hero__slide.is-active .hp-hero__kicker  { animation-delay: 0.12s; }
  .hp-hero__slide.is-active .hp-hero__heading { animation-delay: 0.24s; }
  .hp-hero__slide.is-active .hp-hero__rule    { animation-delay: 0.38s; }
  .hp-hero__slide.is-active .hp-hero__sub     { animation-delay: 0.48s; }
  .hp-hero__slide.is-active .hp-hero__actions { animation-delay: 0.6s; }
  .hp-hero__slide.is-active .hp-hero__rating  { animation-delay: 0.72s; }
  @keyframes hp-hero-cascade {
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  html:not(.hp-js) .hp-hero__kicker, html:not(.hp-js) .hp-hero__heading,
  html:not(.hp-js) .hp-hero__rule, html:not(.hp-js) .hp-hero__sub,
  html:not(.hp-js) .hp-hero__actions, html:not(.hp-js) .hp-hero__rating {
    opacity: 1; transform: none; filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero__kicker, .hp-hero__heading, .hp-hero__rule,
    .hp-hero__sub, .hp-hero__actions, .hp-hero__rating {
      opacity: 1 !important; transform: none !important; filter: none !important; animation: none !important;
    }
    .hp-hero__slide { transition: none; }
    .hp-hero__slide.is-active .hp-hero__media img { animation: none !important; }
  }

  /* ---- chrome: progress rail + scroll cue ---- */
  .hp-hero__chrome {
    position: absolute; z-index: 7; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    padding: 0 var(--hp-gap-x) 2.6rem;
  }
  .hp-hero__dots { display: flex; gap: 0.8rem; align-items: center; }
  .hp-hero__dot {
    position: relative; width: 4.4rem; height: 2rem;
    padding: 0; background: transparent; border: none; cursor: pointer;
  }
  .hp-hero__dot::after {
    content: ''; position: absolute; left: 0; right: 0; top: 50%;
    height: 2px; border-radius: 2px;
    background: rgba(255, 249, 223, 0.3);
    transition: background 0.4s ease;
  }
  .hp-hero__dot::before {
    content: ''; position: absolute; left: 0; top: 50%;
    height: 2px; width: 0; border-radius: 2px;
    background: {{ hero_text }};
    transition: width 0.4s ease;
  }
  .hp-hero__dot.is-active::before { width: 100%; }
  .hp-hero__counter {
    font-family: var(--hp-font-display); font-size: 1.5rem;
    letter-spacing: 0.18em; color: {{ hero_text }}; opacity: 0.75; white-space: nowrap;
  }
  .hp-hero__counter-current { font-size: 2.1rem; opacity: 1; }
  .hp-hero__nav { display: flex; gap: 0.8rem; align-items: center; }
  .hp-hero__arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 4.4rem; height: 4.4rem;
    background: rgba(8, 26, 27, 0.28);
    border: 1px solid rgba(255, 249, 223, 0.3);
    border-radius: 50%;
    color: {{ hero_text }};
    cursor: pointer;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s var(--hp-ease);
  }
  .hp-hero__arrow:hover {
    background: {{ hero_text }}; color: var(--hp-teal-ink);
    border-color: {{ hero_text }}; transform: translateY(-2px);
  }
  .hp-hero__cue {
    position: absolute; z-index: 7; left: 50%; bottom: 2.8rem;
    transform: translateX(-50%);
    display: none; flex-direction: column; align-items: center; gap: 0.6rem;
    font-family: var(--hp-font-ui); font-size: 0.95rem;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: {{ hero_text }}; opacity: 0.6;
  }
  @media screen and (min-width: 990px) { .hp-hero__cue { display: flex; } }
  .hp-hero__cue-line {
    width: 1px; height: 4rem;
    background: linear-gradient(to bottom, currentColor, transparent);
    animation: hp-cue 2.4s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes hp-cue { 0%,100% { transform: scaleY(0.4); opacity: 0.4; } 50% { transform: scaleY(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .hp-hero__cue-line { animation: none; } }
  @media screen and (max-width: 749px) { .hp-hero__counter, .hp-hero__nav { display: none; } }
{%- endstyle -%}

<hp-hero
  class="hp-hero{% if section.settings.text_position == 'center' %} hp-hero--center{% endif %}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed }}"
  data-hp-no-anim
  tabindex="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if has_video -%}
    {%- comment -%}
      Every attribute the video logic reads lives on this wrapper, whichever
      way the <video> underneath was built. `video_tag` takes no data
      attributes of its own, so a picked video had nowhere to hang the phone
      clip and initBgVideo never saw it. Keeping them all here means one place
      to read, and initBgVideo reaches through to the <video> inside.
    {%- endcomment -%}
    <div
      class="hp-hero__video"
      data-hp-parallax
      {%- comment -%}
        Emitted only when the setting is off. `| default: true` cannot say
        this: Liquid's default filter treats false as "no value" and returns
        the default, so an unchecked box rendered as "true" and the video
        played on phones anyway. Absence of the attribute means allowed.
      {%- endcomment %}
      {% if section.settings.video_on_mobile == false %}data-hp-video-mobile="false"{% endif %}
      {%- comment -%}
        data-hp-bg-video marks the stage for initBgVideo. It is set whenever
        there is a video at all, not only when there is a phone cut to swap:
        the markup no longer autoplays anything, so this marker is what starts
        playback — without it a picked video with no phone cut would never
        begin.
      {%- endcomment %}
      {% if has_video %}data-hp-bg-video{% endif %}
      {% if section.settings.video_url != blank %}data-src-desktop="{{ section.settings.video_url }}"{% endif %}
      {% if section.settings.video_url_mobile != blank %}data-src-mobile="{{ section.settings.video_url_mobile }}"{% endif %}
      {%- comment -%}
        How long a phone keeps showing the still before it starts fetching the
        clip, on top of waiting for load and an idle moment. This is what pays
        for the video being served at full quality: phones used to be handed a
        480p re-encode to save the bytes, which was visibly soft in the one
        place on the site that can least afford it. Deferring the same bytes
        costs nothing to look at, because the still IS the opening frame.
      {%- endcomment %}
      data-hp-video-hold="{{ section.settings.mobile_hold | times: 1000 | round }}"
      {%- comment -%}
        Once the hero has scrolled away there is nothing to look at, so there
        is no reason to keep decoding frames or pulling the rest of the file.
        initBgVideo watches the stage and pauses on the way out.
      {%- endcomment %}
      data-hp-video-pause-offscreen
    >
      {%- if section.settings.video != null -%}
        {%- comment -%}
          No autoplay/preload here on purpose. video_tag's native <source>
          starts fetching the moment the browser parses it — autoplay makes
          that immediate, before initBgVideo's JS has even run — so on a phone
          this clip (the desktop cut) was downloading in full at the same time
          as the phone clip it was about to be swapped out for. Measured: both
          fully downloaded on a single load, ~6MB combined.

          Those <source> children are the DESKTOP cut, always. initBgVideo
          detaches them the moment it runs and only puts them back on a wide
          screen, so on a phone they cannot be reached at all — the portrait
          clip is the element's only candidate rather than merely its
          preferred one. It also calls .play() itself, once it has decided
          which file this screen actually needs.
        {%- endcomment -%}
        {{
          section.settings.video
          | video_tag: loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '1920x'
        }}
      {%- else -%}
        {%- comment -%}
          The desktop clip stays on the src attribute so the element still has
          a file to play, but nothing here starts fetching it: no autoplay, and
          preload="none".

          HTML cannot ask a question about the screen, so any attribute that
          begins a download begins it everywhere — autoplay had a phone pulling
          the desktop cut in full the instant the tag was parsed, before any of
          the code that decides what this screen should get had run. That
          decision (which cut, whether at all on a slow connection, and not
          until the page has finished loading) belongs to initBgVideo, and it
          can only make it if the markup has not already committed.

          Nothing is lost without JavaScript: the still is painted as the
          stage's background, so the hero is a photograph rather than an empty
          frame.
        {%- endcomment -%}
        <video
          loop muted playsinline
          preload="none"
          src="{{ section.settings.video_url }}"
          data-src-desktop="{{ section.settings.video_url }}"
          data-src-mobile="{{ section.settings.video_url_mobile }}"
        ></video>
      {%- endif -%}
    </div>
    <div class="hp-hero__scrim"></div>
    <div class="hp-hero__vignette"></div>
    {%- if section.settings.grain -%}<div class="hp-hero__grain"></div>{%- endif -%}
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div
      class="hp-hero__slide{% if forloop.first %} is-active{% endif %}"
      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
      role="group"
      aria-roledescription="slide"
      aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
      {{ block.shopify_attributes }}
    >
      {%- unless has_video -%}
        <div class="hp-hero__media">
          {%- if block.settings.image -%}
            {%- liquid
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 3840
              | image_tag: widths: '750, 1100, 1500, 1780, 2000, 2400, 3000, 3840', sizes: '100vw', loading: img_loading, fetchpriority: img_priority
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hp-hero__scrim"></div>
        <div class="hp-hero__vignette"></div>
        {%- if section.settings.grain -%}<div class="hp-hero__grain"></div>{%- endif -%}
      {%- endunless -%}

      <div class="hp-hero__content">
        <div class="hp-hero__inner">
          {%- if block.settings.kicker != blank -%}
            <p class="hp-hero__kicker"{% if section.settings.typewriter %} data-hp-type="42"{% endif %}>{{ block.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="hp-hero__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          <span class="hp-hero__rule" aria-hidden="true"></span>
          {%- if block.settings.subheading != blank -%}
            <p class="hp-hero__sub">{{ block.settings.subheading | escape }}</p>
          {%- endif -%}
          <div class="hp-hero__actions">
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                class="hp-btn hp-btn--cream-solid"
              >
                {{ block.settings.button_label | escape }}
                {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
              </a>
            {%- endif -%}
            {%- if section.settings.watch_label != blank and section.settings.watch_video_url != blank -%}
              <button type="button" class="hp-btn hp-btn--cream" data-hp-video-src="{{ section.settings.watch_video_url }}" data-hp-video-wide>
                {{ section.settings.watch_label | escape }}
              </button>
            {%- endif -%}
          </div>
          {%- if section.settings.show_rating and section.settings.rating_text != blank -%}
            <div class="hp-hero__rating">
              <span class="hp-stars" aria-hidden="true">
                {%- for i in (1..5) -%}{% render 'hp-icon', icon: 'star', size: 13 %}{%- endfor -%}
              </span>
              {%- if section.settings.rating_score != blank -%}
                <span class="hp-hero__rating-score">{{ section.settings.rating_score | escape }}</span>
              {%- endif -%}
              <span class="hp-hero__rating-text">{{ section.settings.rating_text | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hp-hero__chrome">
      <div class="hp-hero__dots" role="tablist" aria-label="{{ section.settings.accessibility_info | escape }}">
        {%- for block in section.blocks -%}
          <button type="button" class="hp-hero__dot{% if forloop.first %} is-active{% endif %}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="hp-hero__nav">
        <div class="hp-hero__counter">
          <span class="hp-hero__counter-current">01</span>
          <span aria-hidden="true">/ {% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</span>
        </div>
        <button type="button" class="hp-hero__arrow hp-hero__arrow--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-left', size: 18 %}
        </button>
        <button type="button" class="hp-hero__arrow hp-hero__arrow--next" aria-label="{{ 'general.slider.next_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-right', size: 18 %}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_cue -%}
    <div class="hp-hero__cue" aria-hidden="true">
      <span>Scroll</span>
      <span class="hp-hero__cue-line"></span>
    </div>
  {%- endif -%}
</hp-hero>

{% schema %}
{
  "name": "THP Hero (v3)",
  "tag": "section",
  "class": "hp-hero-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Background video (optional)" },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video",
      "info": "Muted, autoplaying loop behind the rotating copy. When set, slide images are ignored."
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Hero video URL (phones)",
      "info": "Used below 750px — a portrait clip suits a phone far better than a cropped landscape one. Falls back to the video below."
    },
    {
      "type": "image_picker",
      "id": "video_poster_mobile",
      "label": "Thumbnail for the phone video",
      "info": "Shown on phones before the clip above loads, and while it is paused. Pick a still from that same clip — ideally its opening frame, so the swap into video is invisible. Update this whenever you change the phone video; nothing does it automatically. Leave blank to use the built-in still below instead."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "…or external MP4 URL",
      "info": "Used only when no video is picked above."
    },
    {
      "type": "image_picker",
      "id": "video_poster_desktop",
      "label": "Thumbnail for the desktop video",
      "info": "Shown on wider screens before the clip above loads. Pick a still from that same clip — ideally its opening frame, so the swap into video is invisible. Update this whenever you change the desktop video; nothing does it automatically. Leave blank to use the built-in still below instead."
    },
    {
      "type": "checkbox",
      "id": "video_on_mobile",
      "label": "Play the hero video on phones",
      "default": true,
      "info": "Off shows the still image instead. The clip is the single heaviest thing a phone downloads on this page, so turning it off is the biggest saving available here."
    },
    {
      "type": "range",
      "id": "mobile_hold",
      "label": "Hold the still image on phones",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "s",
      "default": 2,
      "info": "How long a phone shows the poster frame before it begins downloading the clip — counted after the page has finished loading, so it never delays anything you can see. The still is the video's own first frame, so a longer hold just means the hero stays a photograph for a moment. Raise it to take the clip further out of the way of the rest of the page; 0 loads it as soon as the page settles."
    },
    {
      "type": "checkbox",
      "id": "builtin_poster",
      "label": "Use the built-in poster stills as a fallback",
      "default": true,
      "info": "Stills of the two hero clips as configured today, bundled with the theme, painted immediately so the hero is never an empty block of colour while the video loads. Used only where the matching thumbnail field above is left blank. Swapping a video without uploading its thumbnail will show a still that no longer matches — turn this off in that case, or upload one above."
    },
    { "type": "header", "content": "Layout & legibility" },
    {
      "type": "select",
      "id": "height",
      "label": "Hero height",
      "options": [
        { "value": "compact", "label": "Compact (72vh)" },
        { "value": "standard", "label": "Standard (88vh)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Overlay gradient strength",
      "info": "Raise this if the headline is hard to read over the imagery.",
      "default": 75
    },
    {
      "type": "checkbox",
      "id": "text_shade",
      "label": "Extra shade behind text",
      "default": true
    },
    { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#1a4b46" },
    { "type": "checkbox", "id": "grain", "label": "Film-grain texture", "info": "Fine vintage grain over the footage — adds depth and masks compression.", "default": true },
    { "type": "checkbox", "id": "typewriter", "label": "Typewriter effect on the kicker", "default": true },
    { "type": "checkbox", "id": "show_cue", "label": "Show scroll cue", "default": true },
    {
      "type": "select",
      "id": "focal",
      "label": "Video / image focal point",
      "info": "Which part of the frame stays visible when it is cropped.",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#fff9df" },
    { "type": "header", "content": "Rotation" },
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate slides", "default": true },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    { "type": "header", "content": "Watch Story button" },
    { "type": "text", "id": "watch_label", "label": "Label", "default": "Watch Story" },
    {
      "type": "text",
      "id": "watch_video_url",
      "label": "Story video URL (MP4)",
      "info": "Opens in a fullscreen player. Leave empty to hide the button."
    },
    { "type": "header", "content": "Rating highlight" },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show review rating chip",
      "default": true
    },
    { "type": "text", "id": "rating_score", "label": "Score", "default": "4.9" },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Text",
      "default": "10,000+ happy tables across Pakistan"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Slideshow description",
      "default": "Slideshow about our brand"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Adjust the focal point on the image in Shopify admin to control framing on all screen sizes."
        },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Handcrafted Heritage · Pakistan" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Exquisite Dining" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Premium serveware for homes and hospitality." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Hero (v3)",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
