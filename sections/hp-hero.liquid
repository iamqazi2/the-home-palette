{% comment %}
  THP — v3 hero: full-bleed background video (or Ken-Burns image slides),
  left-weighted teal gradient, rotating copy, dash indicators, rating chip.
  Legibility fixes: gradient strength + text-shade controls, text shadows.
  Set each image's focal point in the Shopify admin (image editor) — it is
  respected automatically via object-position.
{% endcomment %}

{%- liquid
  assign has_video = false
  if section.settings.video != null or section.settings.video_url != blank
    assign has_video = true
  endif

  assign h = section.settings.height
  assign hero_h = '88vh'
  if h == 'full'
    assign hero_h = '100svh'
  elsif h == 'compact'
    assign hero_h = '72vh'
  endif

  assign shade = section.settings.overlay_strength | divided_by: 100.0
  assign shade_mid = shade | times: 0.55
  assign shade_low = shade | times: 0.18
-%}

{%- style -%}
  .hp-hero {
    position: relative;
    display: block;
    height: {{ hero_h }};
    min-height: 54rem;
    max-height: 110rem;
    overflow: hidden;
    background: var(--hp-teal-ink);
    color: var(--hp-cream);
  }
  @media screen and (max-width: 560px) { .hp-hero { min-height: 50rem; } }

  /* background video layer (parallax via data-hp-parallax) */
  .hp-hero__video { z-index: 0; }
  .hp-hero__video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  {%- unless has_video -%}
  .hp-hero__slide.is-active .hp-hero__media img {
    animation: hp-kenburns 12s ease-out both;
  }
  {%- endunless -%}

  .hp-hero__slide {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.1s var(--hp-ease), visibility 0s 1.1s;
  }
  .hp-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.1s var(--hp-ease);
    z-index: 2;
  }
  {%- if has_video -%}
  /* with a video background the slides are copy-only, transparent layers */
  .hp-hero__slide { pointer-events: none; }
  .hp-hero__slide.is-active { pointer-events: auto; }
  {%- endif -%}
  .hp-hero__media,
  .hp-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero__slide { transition: none; }
    .hp-hero__slide.is-active .hp-hero__media img { animation: none !important; }
  }

  /* left-weighted gradient — keeps type readable over any footage */
  .hp-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(18, 53, 54, {{ shade }}) 0%,
      rgba(18, 53, 54, {{ shade_mid }}) 50%,
      rgba(18, 53, 54, {{ shade_low }}) 100%
    );
  }
  .hp-hero--center .hp-hero__scrim {
    background: linear-gradient(
      180deg,
      rgba(18, 53, 54, {{ shade_low }}) 0%,
      rgba(18, 53, 54, {{ shade_mid }}) 55%,
      rgba(18, 53, 54, {{ shade }}) 100%
    );
  }

  .hp-hero__content {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 clamp(2rem, 6vw, 6.4rem);
    max-width: 100%;
  }
  .hp-hero__content-inner { max-width: 64rem; }
  .hp-hero--center .hp-hero__content { align-items: center; text-align: center; }
  .hp-hero--center .hp-hero__content-inner { max-width: 72rem; }

  {%- if section.settings.text_shade -%}
  /* soft radial shade hugging the text block itself */
  .hp-hero__content-inner {
    position: relative;
  }
  .hp-hero__content-inner::before {
    content: '';
    position: absolute;
    inset: -4rem -6rem;
    background: radial-gradient(ellipse at 30% 50%, rgba(18, 53, 54, 0.55), transparent 70%);
    z-index: -1;
    pointer-events: none;
  }
  {%- endif -%}

  .hp-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--hp-font-ui);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--hp-cream);
    margin: 0 0 1.4rem;
    text-shadow: 0 1px 12px rgba(18, 53, 54, 0.6);
  }
  .hp-hero__kicker::before {
    content: '';
    width: 2.2rem;
    height: 1.5px;
    background: currentColor;
  }
  .hp-hero--center .hp-hero__kicker::after {
    content: '';
    width: 2.2rem;
    height: 1.5px;
    background: currentColor;
  }
  .hp-hero__heading {
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: clamp(3.6rem, 6.8vw, 7.2rem);
    line-height: 1.02;
    letter-spacing: 0.005em;
    margin: 0;
    color: var(--hp-cream);
    text-shadow: 0 2px 24px rgba(18, 53, 54, 0.55);
  }
  .hp-hero__sub {
    margin: 1.6rem 0 0;
    font-size: clamp(1.4rem, 1.6vw, 1.6rem);
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: rgba(255, 249, 223, 0.9);
    max-width: 44rem;
    text-shadow: 0 1px 14px rgba(18, 53, 54, 0.6);
  }
  .hp-hero--center .hp-hero__sub { margin-left: auto; margin-right: auto; }
  .hp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.6rem;
  }
  .hp-hero--center .hp-hero__actions { justify-content: center; }

  /* rating chip — total reviews highlighted right at the start (fix #6) */
  .hp-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.8rem;
    padding: 0.9rem 1.6rem;
    border-radius: var(--hp-r-pill);
    background: rgba(18, 53, 54, 0.45);
    border: 1px solid rgba(255, 249, 223, 0.25);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    width: fit-content;
  }
  .hp-hero--center .hp-hero__rating { margin-left: auto; margin-right: auto; }
  .hp-hero__rating-score {
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: 2rem;
    color: var(--hp-cream);
  }
  .hp-hero__rating-text {
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: rgba(255, 249, 223, 0.85);
  }

  /* staggered rise on the active slide's copy */
  .hp-hero__kicker, .hp-hero__heading, .hp-hero__sub, .hp-hero__actions, .hp-hero__rating {
    opacity: 0;
    transform: translateY(26px);
  }
  .hp-hero__slide.is-active .hp-hero__kicker,
  .hp-hero__slide.is-active .hp-hero__heading,
  .hp-hero__slide.is-active .hp-hero__sub,
  .hp-hero__slide.is-active .hp-hero__actions,
  .hp-hero__slide.is-active .hp-hero__rating {
    animation: hp-hero-rise 1s var(--hp-ease) forwards;
  }
  .hp-hero__slide.is-active .hp-hero__kicker { animation-delay: 0.15s; }
  .hp-hero__slide.is-active .hp-hero__heading { animation-delay: 0.28s; }
  .hp-hero__slide.is-active .hp-hero__sub { animation-delay: 0.42s; }
  .hp-hero__slide.is-active .hp-hero__actions { animation-delay: 0.56s; }
  .hp-hero__slide.is-active .hp-hero__rating { animation-delay: 0.7s; }
  @keyframes hp-hero-rise { to { opacity: 1; transform: none; } }
  html:not(.hp-js) .hp-hero__kicker,
  html:not(.hp-js) .hp-hero__heading,
  html:not(.hp-js) .hp-hero__sub,
  html:not(.hp-js) .hp-hero__actions,
  html:not(.hp-js) .hp-hero__rating { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero__kicker, .hp-hero__heading, .hp-hero__sub, .hp-hero__actions, .hp-hero__rating {
      opacity: 1 !important; transform: none !important; animation: none !important;
    }
  }

  /* chrome — thin dash indicators bottom-left, counter + arrows bottom-right */
  .hp-hero__chrome {
    position: absolute;
    z-index: 5;
    left: 0; right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 clamp(2rem, 6vw, 6.4rem) 2.4rem;
  }
  .hp-hero__dots { display: flex; gap: 0.6rem; align-items: center; }
  .hp-hero__dot {
    width: 3.2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    position: relative;
  }
  .hp-hero__dot::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 249, 223, 0.35);
    transition: background 0.4s ease;
  }
  .hp-hero__dot.is-active::after { background: var(--hp-cream); }
  .hp-hero__counter {
    font-family: var(--hp-font-display);
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    color: rgba(255, 249, 223, 0.8);
    white-space: nowrap;
  }
  .hp-hero__counter-current { color: var(--hp-cream); font-size: 2rem; }
  .hp-hero__nav { display: flex; gap: 0.8rem; align-items: center; }
  .hp-hero__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    background: transparent;
    border: 1.5px solid rgba(255, 249, 223, 0.4);
    border-radius: 50%;
    color: var(--hp-cream);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s var(--hp-ease);
  }
  .hp-hero__arrow:hover { background: var(--hp-cream); color: var(--hp-teal); border-color: var(--hp-cream); transform: translateY(-2px); }
  @media screen and (max-width: 749px) {
    .hp-hero__counter, .hp-hero__nav { display: none; }
  }
{%- endstyle -%}

<hp-hero
  class="hp-hero{% if section.settings.text_position == 'center' %} hp-hero--center{% endif %}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed }}"
  tabindex="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if has_video -%}
    <div class="hp-hero__video" data-hp-parallax>
      {%- if section.settings.video != null -%}
        {{
          section.settings.video
          | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata'
        }}
      {%- else -%}
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          {% if section.settings.video_poster %}poster="{{ section.settings.video_poster | image_url: width: 1800 }}"{% endif %}
          src="{{ section.settings.video_url }}"
        ></video>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if has_video -%}
    <div class="hp-hero__scrim"></div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    <div
      class="hp-hero__slide{% if forloop.first %} is-active{% endif %}"
      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
      role="group"
      aria-roledescription="slide"
      aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
      {{ block.shopify_attributes }}
    >
      {%- unless has_video -%}
        <div class="hp-hero__media">
          {%- if block.settings.image -%}
            {%- liquid
              if forloop.first
                assign img_loading = 'eager'
                assign img_priority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 3200
              | image_tag:
                widths: '750, 1100, 1500, 1780, 2000, 3000, 3200',
                sizes: '100vw',
                loading: img_loading,
                fetchpriority: img_priority
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hp-hero__scrim"></div>
      {%- endunless -%}

      <div class="hp-hero__content">
        <div class="hp-hero__content-inner">
          {%- if block.settings.kicker != blank -%}
            <p class="hp-hero__kicker">{{ block.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="hp-hero__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="hp-hero__sub">{{ block.settings.subheading | escape }}</p>
          {%- endif -%}
          <div class="hp-hero__actions">
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                class="hp-btn hp-btn--cream-solid"
              >
                {{ block.settings.button_label | escape }}
                {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
              </a>
            {%- endif -%}
            {%- if section.settings.watch_label != blank and section.settings.watch_video_url != blank -%}
              <button
                type="button"
                class="hp-btn hp-btn--cream"
                data-hp-video-src="{{ section.settings.watch_video_url }}"
                data-hp-video-wide
              >
                {{ section.settings.watch_label | escape }}
              </button>
            {%- endif -%}
          </div>
          {%- if section.settings.show_rating and section.settings.rating_text != blank -%}
            <div class="hp-hero__rating">
              <span class="hp-stars" aria-hidden="true">
                {%- for i in (1..5) -%}{% render 'hp-icon', icon: 'star', size: 13 %}{%- endfor -%}
              </span>
              {%- if section.settings.rating_score != blank -%}
                <span class="hp-hero__rating-score">{{ section.settings.rating_score | escape }}</span>
              {%- endif -%}
              <span class="hp-hero__rating-text">{{ section.settings.rating_text | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hp-hero__chrome">
      <div class="hp-hero__dots" role="tablist" aria-label="{{ section.settings.accessibility_info | escape }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hp-hero__dot{% if forloop.first %} is-active{% endif %}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="hp-hero__nav">
        <div class="hp-hero__counter">
          <span class="hp-hero__counter-current">01</span>
          <span aria-hidden="true">/ {% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</span>
        </div>
        <button type="button" class="hp-hero__arrow hp-hero__arrow--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-left', size: 18 %}
        </button>
        <button type="button" class="hp-hero__arrow hp-hero__arrow--next" aria-label="{{ 'general.slider.next_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-right', size: 18 %}
        </button>
      </div>
    </div>
  {%- endif -%}
</hp-hero>

{% schema %}
{
  "name": "THP Hero (v3)",
  "tag": "section",
  "class": "hp-hero-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Background video (optional)" },
    {
      "type": "video",
      "id": "video",
      "label": "Hero video",
      "info": "Muted, autoplaying loop behind the rotating copy. When set, slide images are ignored."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "…or external MP4 URL",
      "info": "Used only when no video is picked above."
    },
    { "type": "image_picker", "id": "video_poster", "label": "Poster frame (for external URL)" },
    { "type": "header", "content": "Layout & legibility" },
    {
      "type": "select",
      "id": "height",
      "label": "Hero height",
      "options": [
        { "value": "compact", "label": "Compact (72vh)" },
        { "value": "standard", "label": "Standard (88vh)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay gradient strength",
      "info": "Raise this if the headline is hard to read over the imagery.",
      "default": 65
    },
    {
      "type": "checkbox",
      "id": "text_shade",
      "label": "Extra shade behind text",
      "default": true
    },
    { "type": "header", "content": "Rotation" },
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate slides", "default": true },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    { "type": "header", "content": "Watch Story button" },
    { "type": "text", "id": "watch_label", "label": "Label", "default": "Watch Story" },
    {
      "type": "text",
      "id": "watch_video_url",
      "label": "Story video URL (MP4)",
      "info": "Opens in a fullscreen player. Leave empty to hide the button."
    },
    { "type": "header", "content": "Rating highlight" },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show review rating chip",
      "default": true
    },
    { "type": "text", "id": "rating_score", "label": "Score", "default": "4.9" },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Text",
      "default": "1,000+ happy tables across Pakistan"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Slideshow description",
      "default": "Slideshow about our brand"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Adjust the focal point on the image in Shopify admin to control framing on all screen sizes."
        },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Handcrafted Heritage · Pakistan" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Exquisite Dining" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Premium serveware for homes and hospitality." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Hero (v3)",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
