{% comment %}
  THP — client logo wall.

  Two display modes from one set of blocks:
    grid      every brand visible at once, in a tile wall (default)
    marquee   two rows drifting in opposite directions, paused on hover

  Each logo can come from a theme asset (the extracted brand tiles ship with
  the theme) or from an uploaded image, so a merchant can swap or add brands
  without touching the files. Blocks with neither are skipped rather than
  rendering an empty tile.
{% endcomment %}

{%- liquid
  assign mode = section.settings.mode | default: 'grid'
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}

{%- style -%}
  .hp-brands { background: {{ section.settings.bg_color | default: '#fffdf4' }}; overflow: hidden; }

  .hp-brands__count {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    padding: 0.7rem 1.6rem;
    border-radius: var(--hp-r-pill);
    background: var(--hp-teal-chip);
    font-family: var(--hp-font-ui);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-teal);
  }

  /* ---------- shared tile ---------- */
  .hp-brands__tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: var(--hp-paper);
    border: 1px solid var(--hp-hairline);
    text-decoration: none;
    transition: transform 0.45s var(--hp-ease), box-shadow 0.45s var(--hp-ease),
      border-color 0.45s var(--hp-ease);
  }
  .hp-brands__tile img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.fit | default: 'cover' }};
    display: block;
    transition: filter 0.55s var(--hp-ease), transform 0.9s var(--hp-ease);
  }
  /* box-sizing is content-box for images in this theme, so padding would push
     the img past the tile and get clipped — hence the explicit border-box */
  .hp-brands__tile--contain img { object-fit: contain; padding: 9%; box-sizing: border-box; }
  {%- if section.settings.mute -%}
    /* muted until hover: the wall reads as one calm block of clients rather
       than twenty-four competing brand palettes, and colour returns on the
       one the visitor is actually looking at */
    .hp-brands__tile img { filter: grayscale(0.92) opacity(0.72); }
    .hp-brands__tile:hover img,
    .hp-brands__tile:focus-visible img { filter: none; }
  {%- endif -%}
  .hp-brands__tile:hover,
  .hp-brands__tile:focus-visible {
    transform: translateY(-6px);
    box-shadow: var(--hp-shadow-card);
    border-color: transparent;
    outline: none;
  }
  .hp-brands__tile:hover img { transform: scale(1.04); }

  .hp-brands__name {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.6rem 1rem;
    border-radius: var(--hp-r-pill);
    background: rgba(18, 53, 54, 0.88);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--hp-cream);
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s var(--hp-ease), transform 0.4s var(--hp-ease);
    pointer-events: none;
  }
  .hp-brands__tile:hover .hp-brands__name,
  .hp-brands__tile:focus-visible .hp-brands__name { opacity: 1; transform: translateY(0); }

  /* ---------- grid ---------- */
  .hp-brands__grid {
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.8rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media screen and (min-width: 750px) {
    .hp-brands__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media screen and (min-width: 990px) {
    .hp-brands__grid { grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr)); }
  }

  /* ---------- marquee ---------- */
  .hp-brands__rows { display: grid; gap: clamp(1rem, 1.6vw, 1.8rem); }
  .hp-brands__row { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .hp-brands__track {
    display: flex;
    gap: clamp(1rem, 1.6vw, 1.8rem);
    width: max-content;
    animation: hp-brands-scroll {{ section.settings.speed | default: 46 }}s linear infinite;
    will-change: transform;
  }
  .hp-brands__row--back .hp-brands__track { animation-direction: reverse; }
  .hp-brands__row:hover .hp-brands__track { animation-play-state: paused; }
  .hp-brands__track > * { flex: 0 0 auto; width: clamp(11rem, 14vw, 16rem); }
  @keyframes hp-brands-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-brands__track { animation: none; }
    .hp-brands__row { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
  }
{%- endstyle -%}

<div class="hp-brands hp-section">
  <div class="hp-container">
    <div class="hp-section-head{% if section.settings.center_head %} hp-section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_count -%}
        <p class="hp-brands__count">
          {% render 'hp-icon', icon: 'award', size: 14 %}
          {{ section.blocks.size }} {{ section.settings.count_label | escape }}
        </p>
      {%- endif -%}
    </div>

    {%- if mode == 'marquee' -%}
      <div class="hp-brands__rows" data-hp-no-anim>
        {%- for row in (1..2) -%}
          <div class="hp-brands__row{% if row == 2 %} hp-brands__row--back{% endif %}">
            <div class="hp-brands__track">
              {%- comment -%} the track is rendered twice so the loop is seamless {%- endcomment -%}
              {%- for pass in (1..2) -%}
                {%- for block in section.blocks -%}
                  {%- if row == 1 and forloop.index > half -%}{%- continue -%}{%- endif -%}
                  {%- if row == 2 and forloop.index <= half -%}{%- continue -%}{%- endif -%}
                  {% render 'hp-brand-tile', block: block, section: section, clone: pass %}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="hp-brands__grid" data-hp-stagger>
        {%- for block in section.blocks -%}
          {% render 'hp-brand-tile', block: block, section: section, reveal: true %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "THP Brand Wall",
  "tag": "section",
  "max_blocks": 40,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "mode",
      "label": "Display",
      "options": [
        { "value": "grid", "label": "Grid — show every brand" },
        { "value": "marquee", "label": "Marquee — two scrolling rows" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 4, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "speed", "label": "Marquee speed", "min": 20, "max": 90, "step": 2, "unit": "s", "default": 46 },
    {
      "type": "select",
      "id": "fit",
      "label": "Logo fit",
      "info": "Cover suits logos supplied as full square tiles; contain suits logos on transparent or white.",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "mute",
      "label": "Mute logos until hover",
      "info": "Greyscales every logo until it is hovered. Best when the logos are marks on white; full-colour tiles look better left alone.",
      "default": false
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fffdf4" },
    { "type": "checkbox", "id": "center_head", "label": "Centre the heading", "default": true },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted Across Hospitality" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Tables We Already Set" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Restaurants, cafés, hotels and resorts across Pakistan serve on crockery we made with them."
    },
    { "type": "checkbox", "id": "show_count", "label": "Show the brand count", "default": true },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "hospitality brands and counting" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "info": "Used for the hover label and the image's alt text." },
        { "type": "image_picker", "id": "image", "label": "Logo (upload)" },
        {
          "type": "text",
          "id": "asset",
          "label": "Logo (theme asset)",
          "info": "Filename of a logo shipped with the theme, e.g. hp-brand-june.webp. Ignored when an image is uploaded above."
        },
        { "type": "url", "id": "url", "label": "Link (optional)" },
        {
          "type": "select",
          "id": "fit",
          "label": "Fit",
          "options": [
            { "value": "", "label": "Use section default" },
            { "value": "cover", "label": "Cover" },
            { "value": "contain", "label": "Contain" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Brand Wall",
      "blocks": [{ "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }]
    }
  ]
}
{% endschema %}
