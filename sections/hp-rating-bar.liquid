{% comment %}
  THP — Rating highlight bar. Sits high on the page so the review count is
  visible immediately. Figures are merchant-controlled (Judge.me totals can be
  typed in here) — nothing is faked at render time.
{% endcomment %}

{%- style -%}
  .hp-rating-bar {
    background: var(--hp-cream);
    border-bottom: 1px solid var(--hp-hairline);
  }
  .hp-rating-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 6rem);
    padding: 2.8rem 0;
    text-align: center;
  }
  .hp-rating-bar__score {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .hp-rating-bar__number {
    font-family: var(--hp-font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--hp-ink);
  }
  .hp-rating-bar__stars { display: flex; gap: 0.3rem; color: var(--hp-taupe); }
  .hp-rating-bar__stars .hp-icon--filled { fill: currentColor; }
  .hp-rating-bar__meta {
    text-align: left;
    font-size: 1.15rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hp-taupe);
    line-height: 1.7;
  }
  .hp-rating-bar__meta strong { color: var(--hp-ink); }
  .hp-rating-bar__divider {
    width: 1px;
    height: 4.4rem;
    background: var(--hp-hairline);
    display: none;
  }
  @media screen and (min-width: 750px) { .hp-rating-bar__divider { display: block; } }
  .hp-rating-bar__quote {
    max-width: 44rem;
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: 1.9rem;
    line-height: 1.5;
    color: var(--hp-ink);
    margin: 0;
  }
  .hp-rating-bar__cite {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--assistant-font, inherit);
    font-style: normal;
    font-size: 1.05rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--hp-taupe);
  }
{%- endstyle -%}

<div class="hp-rating-bar hp-grain">
  <div class="hp-container">
    <div class="hp-rating-bar__inner" data-hp-reveal>
      <div class="hp-rating-bar__score">
        {%- if section.settings.score != blank -%}
          <span class="hp-rating-bar__number">{{ section.settings.score | escape }}</span>
        {%- endif -%}
        <div>
          <div class="hp-rating-bar__stars" aria-hidden="true">
            {%- assign stars_filled = section.settings.stars -%}
            {%- for i in (1..5) -%}
              {% if i <= stars_filled %}
                {% render 'hp-icon', icon: 'star', size: 16, class: 'hp-icon--filled' %}
              {% else %}
                {% render 'hp-icon', icon: 'star', size: 16 %}
              {% endif %}
            {%- endfor -%}
          </div>
          <p class="hp-rating-bar__meta">
            {%- if section.settings.review_count != blank -%}
              <strong>{{ section.settings.review_count | escape }}</strong> {{ section.settings.review_label | escape }}
            {%- endif -%}
          </p>
        </div>
      </div>

      {%- if section.settings.quote != blank -%}
        <span class="hp-rating-bar__divider"></span>
        <blockquote class="hp-rating-bar__quote">
          “{{ section.settings.quote | escape }}”
          {%- if section.settings.quote_author != blank -%}
            <cite class="hp-rating-bar__cite">{{ section.settings.quote_author | escape }}</cite>
          {%- endif -%}
        </blockquote>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <span class="hp-rating-bar__divider"></span>
        <a href="{{ section.settings.link | default: '#' }}" class="hp-link">
          {{ section.settings.link_label | escape }}
          {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Rating Bar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "score", "label": "Average score", "default": "4.9" },
    {
      "type": "range",
      "id": "stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Filled stars",
      "default": 5
    },
    { "type": "text", "id": "review_count", "label": "Review count", "info": "Type the current total from Judge.me.", "default": "600+" },
    { "type": "text", "id": "review_label", "label": "Review count label", "default": "verified reviews" },
    { "type": "textarea", "id": "quote", "label": "Highlighted quote", "default": "The quality is unreal — our guests ask where every plate came from." },
    { "type": "text", "id": "quote_author", "label": "Quote author", "default": "Ayesha K. · Islamabad" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read all reviews" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "THP Rating Bar" }]
}
{% endschema %}
