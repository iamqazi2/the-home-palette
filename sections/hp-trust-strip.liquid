{% comment %} THP — v3 trust strip: cream band, teal icon chips, hairline dividers {% endcomment %}

{%- style -%}
  .hp-trust {
    background: var(--hp-cream);
    border-bottom: 1px solid var(--hp-hairline-teal);
  }
  .hp-trust__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    max-width: 144rem;
    margin: 0 auto;
  }
  @media screen and (min-width: 990px) {
    .hp-trust__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); }
  }
  .hp-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
    padding: 2.4rem 1.6rem;
    border-left: 1px solid var(--hp-hairline-teal);
    color: var(--hp-ink);
  }
  .hp-trust__item:nth-child(2n + 1) { border-left: none; }
  @media screen and (min-width: 990px) {
    .hp-trust__item:nth-child(2n + 1) { border-left: 1px solid var(--hp-hairline-teal); }
    .hp-trust__item:first-child { border-left: none; }
  }
  .hp-trust__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: var(--hp-teal);
    color: var(--hp-cream);
    transition: transform 0.35s var(--hp-ease);
  }
  .hp-trust__item:hover .hp-trust__chip { transform: translateY(-4px); }
  .hp-trust__title {
    margin: 0;
    font-family: var(--hp-font-ui);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .hp-trust__text {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--hp-taupe);
  }
{%- endstyle -%}

<div class="hp-trust">
  <div class="hp-trust__grid" data-hp-stagger>
    {%- for block in section.blocks -%}
      <div class="hp-trust__item" data-hp-reveal {{ block.shopify_attributes }}>
        <span class="hp-trust__chip">{% render 'hp-icon', icon: block.settings.icon, size: 17 %}</span>
        <h3 class="hp-trust__title">{{ block.settings.title | escape }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="hp-trust__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "THP Trust Strip",
  "tag": "section",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield-check", "label": "Shield check" },
            { "value": "award", "label": "Award" },
            { "value": "rotate-ccw", "label": "Returns" },
            { "value": "gem", "label": "Gem" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Nationwide Delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Flat Rs. 299 — free above Rs. 8,000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Trust Strip",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "award", "title": "Handcrafted", "text": "Made by Pakistani artisans" } },
        { "type": "item", "settings": { "icon": "shield-check", "title": "Quality Checked", "text": "Every piece inspected by hand" } },
        { "type": "item", "settings": { "icon": "sparkles", "title": "5% Off Online", "text": "Website orders only" } }
      ]
    }
  ]
}
{% endschema %}
