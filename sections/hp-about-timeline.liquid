{% comment %}
  THP — About timeline.

  Milestones on a centre rail that fills as the visitor scrolls (GSAP scrub
  when available; the rail simply shows filled otherwise). Alternating sides on
  desktop, a single left-hand rail on phones.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color | default: '#257575'
  assign rail = 'rgba(37, 85, 80, 0.14)'
  assign card_style = section.settings.card_style | default: 'paper'
  assign card_base = section.settings.card_color | default: '#257575'
-%}

{%- style -%}
  .hp-abt-time { background: {{ section.settings.bg_color | default: '#fffdf4' }}; overflow: hidden; }

  /* The rail is a sibling of the <ol> rather than a child of it: an <ol> may
     only contain <li>, and a stray <span> inside one is invalid markup that
     also throws off :nth-child() counting for the alternating layout below. */
  .hp-abt-time__wrap { position: relative; }
  .hp-abt-time__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* the rail: left-aligned on phones, centred from 990px up */
  .hp-abt-time__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.9rem;
    width: 2px;
    background: {{ rail }};
    border-radius: 2px;
    overflow: hidden;
  }
  .hp-abt-time__fill {
    position: absolute;
    inset: 0 0 auto 0;
    height: 0;
    background: linear-gradient(180deg, {{ accent }} 0%, {{ section.settings.accent_2_color | default: '#7fc8be' }} 100%);
    transform-origin: top center;
  }
  /* without GSAP there is nothing to scrub the fill, so show the rail complete
     rather than permanently empty */
  html:not(.hp-gsap) .hp-abt-time__fill { height: 100%; }

  .hp-abt-time__item {
    position: relative;
    padding: 0 0 clamp(2.8rem, 4vw, 4.4rem) 4.4rem;
  }
  .hp-abt-time__item:last-child { padding-bottom: 0; }

  .hp-abt-time__dot {
    position: absolute;
    left: 0;
    top: 0.8rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: {{ section.settings.bg_color | default: '#fffdf4' }};
    border: 2px solid {{ accent }};
    display: grid;
    place-items: center;
  }
  .hp-abt-time__dot::after {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: {{ accent }};
    transform: scale(0.5);
    transition: transform 0.5s var(--hp-ease);
  }
  .hp-abt-time__item.is-active .hp-abt-time__dot::after { transform: scale(1); }
  .hp-abt-time__item.is-active .hp-abt-time__dot {
    box-shadow: 0 0 0 6px rgba(37, 117, 117, 0.1);
  }

  .hp-abt-time__card {
    position: relative;
    padding: clamp(2rem, 2.6vw, 2.8rem);
    background: var(--hp-paper);
    border: 1px solid var(--hp-hairline);
    border-radius: var(--hp-r-card);
    transition: transform 0.45s var(--hp-ease), box-shadow 0.45s var(--hp-ease);
  }
  .hp-abt-time__card:hover { transform: translateY(-6px); box-shadow: var(--hp-shadow-card); }
  .hp-abt-time__year {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.5rem 1.2rem;
    border-radius: var(--hp-r-pill);
    background: var(--hp-teal-chip);
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ accent }};
  }
  .hp-abt-time__title {
    margin: 0;
    font-family: var(--hp-font-display);
    font-size: var(--hp-h-block);
    line-height: 1.22;
    color: var(--hp-heading);
  }
  .hp-abt-time__text {
    margin: 1rem 0 0;
    font-size: 1.4rem;
    line-height: 1.78;
    color: var(--hp-taupe);
  }
  .hp-abt-time__thumb {
    margin-top: 1.6rem;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--hp-linen);
  }
  .hp-abt-time__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--hp-ease); }
  .hp-abt-time__card:hover .hp-abt-time__thumb img { transform: scale(1.05); }

  /* ---------- desktop: centre rail, alternating sides ---------- */
  @media screen and (min-width: 990px) {
    .hp-abt-time__rail { left: 50%; transform: translateX(-50%); }
    .hp-abt-time__item {
      display: grid;
      grid-template-columns: 1fr 8rem 1fr;
      align-items: start;
      padding: 0 0 clamp(3.2rem, 4.4vw, 5rem) 0;
    }
    .hp-abt-time__item .hp-abt-time__card { grid-column: 1; }
    .hp-abt-time__item:nth-child(even) .hp-abt-time__card { grid-column: 3; }
    .hp-abt-time__dot {
      position: static;
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      margin-top: 2.4rem;
    }
    /* the little connector from the card to the rail */
    .hp-abt-time__card::after {
      content: '';
      position: absolute;
      top: 3.2rem;
      width: 2.6rem;
      height: 1px;
      background: {{ rail }};
    }
    .hp-abt-time__item .hp-abt-time__card::after { right: -2.7rem; }
    .hp-abt-time__item:nth-child(even) .hp-abt-time__card::after { left: -2.7rem; right: auto; }
  }

  {%- if card_style != 'paper' -%}
    /* Dark cards — the gradient sits on top of the flat colour, since on its
       own it is fully transparent for the first 30% of the card. */
    .hp-abt-time__card {
      background-color: {{ card_base }};
      {%- if card_style == 'gradient' %}
      background-image: linear-gradient(180deg, rgba(18, 53, 54, 0) 30%, rgba(18, 53, 54, 0.55) 62%, rgba(12, 38, 39, 0.92) 100%);
      {%- endif %}
      border-color: rgba(255, 249, 223, 0.14);
    }
    .hp-abt-time__year { background: rgba(255, 249, 223, 0.16); color: var(--hp-cream); }
    .hp-abt-time__title { color: var(--hp-cream); }
    .hp-abt-time__text { color: rgba(255, 249, 223, 0.8); }
    .hp-abt-time__thumb { background: rgba(255, 249, 223, 0.08); }
  {%- endif -%}
{%- endstyle -%}

<div class="hp-abt-time hp-section">
  <div class="hp-container">
    <div class="hp-section-head{% if section.settings.center_head %} hp-section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-abt-time__wrap" data-hp-timeline>
      <span class="hp-abt-time__rail" aria-hidden="true"><span class="hp-abt-time__fill" data-hp-timeline-fill></span></span>
      <ol class="hp-abt-time__list">
      {%- for block in section.blocks -%}
        <li class="hp-abt-time__item" data-hp-timeline-item {{ block.shopify_attributes }}>
          <div class="hp-abt-time__card" data-hp-reveal>
            {%- if block.settings.year != blank -%}
              <span class="hp-abt-time__year">{{ block.settings.year | escape }}</span>
            {%- endif -%}
            <h3 class="hp-abt-time__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="hp-abt-time__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <div class="hp-abt-time__thumb">
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: widths: '360, 600, 900', sizes: '(min-width: 990px) 40vw, 92vw', loading: 'lazy', alt: block.settings.title
                }}
              </div>
            {%- endif -%}
          </div>
          <span class="hp-abt-time__dot" aria-hidden="true"></span>
        </li>
      {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP About Timeline",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fffdf4" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "paper", "label": "White card" },
        { "value": "teal", "label": "Solid teal" },
        { "value": "gradient", "label": "Teal with deep gradient" }
      ],
      "default": "paper"
    },
    { "type": "color", "id": "card_color", "label": "Card colour", "info": "Used by the teal and gradient card styles.", "default": "#257575" },
    { "type": "color", "id": "accent_color", "label": "Rail colour", "default": "#257575" },
    { "type": "color", "id": "accent_2_color", "label": "Rail colour (end)", "default": "#7fc8be" },
    { "type": "checkbox", "id": "center_head", "label": "Centre the heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter Four — The Journey" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From One Dinner Set to Ten Collections" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "A short history of the palette — and where it is headed next."
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year / label", "default": "2024" },
        { "type": "text", "id": "title", "label": "Title", "default": "The first collection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the milestone." },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP About Timeline",
      "blocks": [
        { "type": "milestone" },
        { "type": "milestone", "settings": { "year": "2025", "title": "Colour becomes the system" } },
        { "type": "milestone", "settings": { "year": "2025", "title": "Hospitality begins" } },
        { "type": "milestone", "settings": { "year": "2026", "title": "Wood and metal join the palette" } }
      ]
    }
  ]
}
{% endschema %}
