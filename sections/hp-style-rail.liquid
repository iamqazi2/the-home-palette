{% comment %} THP — Shop by Style horizontal swatch rail (scroll-snap + arrows) {% endcomment %}

{%- style -%}
  .hp-styles { background: var(--hp-cream); }
  .hp-styles__head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .hp-styles__head-row .hp-section-head { margin-bottom: clamp(2.4rem, 4vw, 4rem); }
  .hp-rail { display: block; position: relative; }
  .hp-rail__track {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }
  .hp-rail__track::-webkit-scrollbar { display: none; }
  .hp-styles__tile {
    position: relative;
    flex: 0 0 min(72vw, 30rem);
    aspect-ratio: 3 / 4;
    scroll-snap-align: start;
    overflow: hidden;
    text-decoration: none;
    background: var(--hp-linen);
  }
  .hp-styles__tile img,
  .hp-styles__tile .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.3s var(--hp-ease);
  }
  .hp-styles__tile:hover img { transform: scale(1.06); }
  .hp-styles__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14, 6, 6, 0.55), transparent 50%);
  }
  .hp-styles__label {
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    padding: 2.4rem 2rem;
    text-align: center;
    font-family: var(--hp-font-display);
    font-size: 2.2rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hp-cream);
  }
  .hp-rail__arrows { display: none; gap: 0.8rem; margin-bottom: clamp(2.4rem, 4vw, 4rem); }
  @media screen and (min-width: 990px) { .hp-rail__arrows { display: flex; } }
  .hp-rail__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border: 1px solid var(--hp-hairline-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--hp-ink);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, opacity 0.3s ease;
  }
  .hp-rail__arrow:hover:not(:disabled) { background: var(--hp-espresso); color: var(--hp-paper); }
  .hp-rail__arrow:disabled { opacity: 0.3; cursor: default; }
{%- endstyle -%}

<div class="hp-styles hp-grain hp-section">
  <div class="hp-container">
    <div class="hp-styles__head-row">
      <div class="hp-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-eyebrow" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div class="hp-rail__arrows" data-hp-arrows-for="hp-styles-rail-{{ section.id }}"></div>
    </div>

    <hp-rail class="hp-rail" id="hp-styles-rail-{{ section.id }}">
      <div class="hp-rail__track" data-hp-stagger tabindex="0" role="list" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign tile_image = block.settings.image | default: col.featured_image
          -%}
          <a
            class="hp-styles__tile"
            role="listitem"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% elsif col != blank %}href="{{ col.url }}"{% endif %}
            data-hp-reveal
            {{ block.shopify_attributes }}
          >
            {%- if tile_image -%}
              {{ tile_image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '30rem', loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="hp-styles__label">{{ block.settings.title | escape }}</span>
          </a>
        {%- endfor -%}
      </div>
      <div class="hp-rail__nav-slot" hidden>
        <button type="button" class="hp-rail__arrow hp-rail__arrow--prev" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-left', size: 18 %}
        </button>
        <button type="button" class="hp-rail__arrow hp-rail__arrow--next" aria-label="{{ 'general.slider.next_slide' | t }}">
          {% render 'hp-icon', icon: 'chevron-right', size: 18 %}
        </button>
      </div>
    </hp-rail>
  </div>
</div>

<script>
  // move the rail arrows up into the section header row
  (function () {
    var rail = document.getElementById('hp-styles-rail-{{ section.id }}');
    if (!rail) return;
    var slot = rail.querySelector('.hp-rail__nav-slot');
    var target = document.querySelector('[data-hp-arrows-for="hp-styles-rail-{{ section.id }}"]');
    if (slot && target) {
      while (slot.firstChild) target.appendChild(slot.firstChild);
      slot.remove();
    }
  })();
</script>

{% schema %}
{
  "name": "THP Shop by Style",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Textures & Glazes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Style" }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Minimalist" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Collection (image + link fallback)" },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Shop by Style",
      "blocks": [
        { "type": "style" },
        { "type": "style", "settings": { "title": "Earthy" } },
        { "type": "style", "settings": { "title": "Reactive" } },
        { "type": "style", "settings": { "title": "Contemporary" } },
        { "type": "style", "settings": { "title": "Hotel Collection" } }
      ]
    }
  ]
}
{% endschema %}
