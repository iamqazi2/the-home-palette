{% comment %}
  THP — v3 Shop by Style: grid of tall 3:4 texture tiles, centered serif label,
  each backed by a collection (fix #5) with optional live count.
{% endcomment %}

{%- liquid
  # Entries come from Shopify admin, Content, Metaobjects, "Shop by Style tile". They are
  # the single list both the homepage and the Shop by Style page read, which is what
  # keeps the two in step: section blocks are stored per template, so while the
  # list lived in blocks each page carried its own copy and they drifted.
  #
  # Ordered by the Position field. Liquid cannot sort drops by a nested field,
  # so each entry becomes a zero-padded "position:handle" key, the keys are
  # sorted as text, and each is looked up again by handle. Padding to five
  # digits keeps 10 after 9; entries with no Position sort last, alphabetically
  # by handle. Liquid returns the first 50 entries of a type.
  assign hp_sty_keys = ''
  for hp_entry in shop.metaobjects.shop_style.values
    assign hp_pos = hp_entry.position.value | default: 9999 | at_least: 0 | at_most: 89999 | plus: 10000
    assign hp_sty_keys = hp_sty_keys | append: hp_pos | append: ':' | append: hp_entry.system.handle | append: ','
  endfor
  assign hp_sty_keys = hp_sty_keys | split: ',' | sort
  assign hp_sty_count = hp_sty_keys.size
-%}

{%- style -%}
  .hp-styles { background: {{ section.settings.bg_color | default: '#fffdf4' }}; }
  .hp-styles__grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media screen and (min-width: 750px) { .hp-styles__grid { grid-template-columns: repeat(3, 1fr); gap: 1.6rem; } }
  @media screen and (min-width: 1200px) { .hp-styles__grid { grid-template-columns: repeat({{ hp_sty_count | at_most: 6 | at_least: 3 }}, 1fr); } }
  .hp-styles__tile { aspect-ratio: 3 / 4; }
  .hp-styles__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(16, 48, 44, 0.1), rgba(16, 48, 44, {{ section.settings.scrim | default: 66 | divided_by: 100.0 }}));
  }
  .hp-styles__label {
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    padding: 0 1.2rem 1.6rem;
    text-align: center;
    color: var(--hp-cream);
  }
  .hp-styles__name {
    display: block;
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 2vw, 2.6rem);
    letter-spacing: 0.04em;
  }
  .hp-styles__count {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 249, 223, 0.8);
  }

  {%- comment -%}
    Mobile layout, opt-in per placement.

    hp-theme.css turns every card grid on the site into a sideways-scrolling
    rail below 750px, this one included — which is right on the home page,
    where the section is one chapter among many and a rail keeps it short. On
    a page that exists to show these styles, a rail hides most of them behind
    a swipe, so that page asks for the grid back.

    This wins on document order rather than on weight: the rail rule is
    `.hp-section .hp-styles__grid` in a stylesheet in <head>, and Shopify
    renders a section's {% style %} inline in <body>. Two classes each, so the
    later one — this one — takes it, with no !important needed.
  {%- endcomment -%}
  @media screen and (max-width: 749px) {
    .hp-styles--mobile-grid .hp-styles__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
    }
    /* the rail sizes each tile to 2.2-per-view; in a grid the column does it */
    .hp-styles--mobile-grid .hp-styles__grid > * {
      flex: initial;
      width: auto;
      max-width: none;
      scroll-snap-align: none;
    }
  }
{%- endstyle -%}

<div class="hp-styles hp-section{% if section.settings.mobile_layout == 'grid' %} hp-styles--mobile-grid{% endif %}" id="hp-styles">
  <div class="hp-container">
    <div class="hp-section-head hp-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--rule-after" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="hp-styles__grid" data-hp-stagger>
      {%- for hp_key in hp_sty_keys -%}
        {%- liquid
          assign hp_handle = hp_key | split: ':' | last
          assign sty = shop.metaobjects.shop_style[hp_handle]
          assign sty_title = sty.title.value
          assign col = sty.collection.value
          assign tile_image = sty.image.value | default: col.featured_image
          assign href = sty.link.value
          if href == blank and col != blank
            assign href = col.url
          endif
        -%}
        <a
          class="hp-tile hp-styles__tile"
          {% if href != blank %}href="{{ href }}"{% endif %}
          data-hp-reveal
        >
          {%- if tile_image -%}
            {{ tile_image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: sty_title }}
          {%- else -%}
            {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="hp-styles__label">
            <span class="hp-styles__name">{{ sty_title | escape }}</span>
            {%- if col != blank and section.settings.show_count -%}
              <span class="hp-styles__count">{{ col.all_products_count }} {{ section.settings.count_label | default: 'varieties' | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
      {%- if hp_sty_count == 0 and request.design_mode -%}
        <p class="hp-section-head__text" style="grid-column: 1 / -1; text-align: center;">
          Nothing to show yet. Add entries in Shopify admin under Content → Metaobjects → Shop by Style tile.
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Shop by Style",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The tiles are shared by the homepage and the Shop by Style page, so both always match. Add, edit, reorder or remove tiles in Shopify admin → Content → Metaobjects → Shop by Style tile (lower Position shows first). Everything below is set per page."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Textures & Glazes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Style"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout on phones",
      "options": [
        {
          "value": "rail",
          "label": "Sideways rail"
        },
        {
          "value": "grid",
          "label": "Grid (two per row)"
        }
      ],
      "default": "rail",
      "info": "A rail keeps the section short where it is one part of a longer page. Use the grid on a page devoted to these styles, where a swipe would hide most of them."
    },
    {
      "type": "range",
      "id": "scrim",
      "min": 30,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Label overlay strength",
      "default": 65
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#fffdf4"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show live product counts",
      "default": false
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "default": "varieties"
    }
  ],
  "presets": [
    {
      "name": "THP Shop by Style"
    }
  ]
}
{% endschema %}
