{% comment %}
  THP — v3 Shop by Occasion.

  Cards are solid brand teal (#1a4b46) on the cream band. Earlier passes tried
  white and then a pale teal tint; both sat too close to the cream behind them
  to read as distinct cards. Note this is the *brand* teal, not the deep
  #1a4b46 tried before it — that one was dark enough to read as a near-black
  slab rather than a teal card.

  Going dark inverts everything that sits on the card: title, caption, icon
  circle, count pill and link cue all move to cream, and the icon circle fills
  solid cream on hover so it still has somewhere to go.

  Shape still comes from the shared .hp-card shell (radius, hover lift, shadow),
  so these stay in step with the product cards. Structure carried over from the
  earlier passes: the card is sized by its content instead of a fixed tall box
  (which is what left dead space underneath), and the "shop now" cue is always
  visible rather than fading in on hover, which meant no touch visitor ever saw
  it.

  Each occasion is backed by a real collection: the card links to it and can
  show its live product count.
{% endcomment %}

{%- liquid
  assign card_bg = section.settings.card_color | default: '#1a4b46'
  assign card_bg_hover = section.settings.card_color_hover | default: '#123532'
-%}

{%- style -%}
  .hp-occasion { background: {{ section.settings.bg_color | default: '#fff9df' }}; }
  .hp-occasion__grid {
    display: grid;
    gap: clamp(1rem, 1.4vw, 1.6rem);
    grid-template-columns: repeat(2, 1fr);
  }
  @media screen and (min-width: 750px) { .hp-occasion__grid { grid-template-columns: repeat(3, 1fr); } }
  @media screen and (min-width: 1200px) { .hp-occasion__grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 6 | at_least: 3 }}, 1fr); } }

  .hp-occasion__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* No fixed height and no `justify-content`: the card is exactly as tall as
       its content, and the grid's default stretch alignment keeps each row
       even. That is what removes the dead space the old fixed-padding card
       left sitting under the text. */
    gap: 0.9rem;
    padding: 2.4rem 1.4rem 2rem;
    text-decoration: none;
    /* Overrides .hp-card's white. Same specificity as .hp-card (0,1,0), but a
       section's style block renders inline in the body, i.e. later in document
       order than hp-theme.css in the head — so this wins on order, no
       !important needed. Radius, hover lift and shadow stay inherited. */
    background: {{ card_bg }};
    color: var(--hp-cream);
    /* Lightened edge rather than .hp-card's dark hairline, which would vanish
       against a dark surface. */
    border-color: rgba(255, 249, 223, 0.16);
    transition: background-color 0.45s var(--hp-ease), border-color 0.45s var(--hp-ease),
      transform 0.45s var(--hp-ease), box-shadow 0.45s var(--hp-ease);
  }
  .hp-occasion__card:hover {
    background: {{ card_bg_hover }};
    border-color: rgba(255, 249, 223, 0.3);
  }
  .hp-occasion__card:focus-visible { outline: 2px solid var(--hp-cream); outline-offset: 3px; }

  /* Translucent cream, not the default pale-teal .hp-chip tint — that tint is
     nearly invisible on a saturated teal card. Fills solid cream on hover so
     the circle still has a state to move to. */
  .hp-occasion__card .hp-chip {
    width: 5rem;
    height: 5rem;
    background: rgba(255, 249, 223, 0.13);
    border: 1px solid rgba(255, 249, 223, 0.26);
    color: var(--hp-cream);
  }
  .hp-occasion__card:hover .hp-chip {
    background: var(--hp-cream);
    color: {{ card_bg_hover }};
    border-color: var(--hp-cream);
    transform: translateY(-2px) scale(1.04);
  }

  .hp-occasion__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 249, 223, 0.1);
    margin-bottom: 0.2rem;
  }
  .hp-occasion__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--hp-ease); }
  .hp-occasion__card:hover .hp-occasion__media img { transform: scale(1.06); }
  .hp-occasion__card:has(.hp-occasion__media) { padding: 1.2rem 1.2rem 1.8rem; }

  .hp-occasion__name {
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 1.6vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.002em;
    color: var(--hp-cream);
  }
  .hp-occasion__caption {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    /* Cream at reduced alpha rather than a separate grey — it keeps the caption
       secondary to the title while staying in the same colour family as the
       card, which a flat grey would not do on a saturated background. */
    color: rgba(255, 249, 223, 0.76);
  }
  /* Count sits in a pill so it reads as metadata rather than a third line of
     body copy. Translucent cream, matching the icon circle above it. */
  .hp-occasion__count {
    margin: 0.2rem 0 0;
    padding: 0.4rem 1rem;
    border-radius: var(--hp-r-pill);
    background: rgba(255, 249, 223, 0.14);
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-cream);
  }
  .hp-occasion__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-teal-soft);
    transition: color 0.35s var(--hp-ease);
  }
  .hp-occasion__card:hover .hp-occasion__cta { color: var(--hp-cream); }
  .hp-occasion__cta .hp-icon { transition: transform 0.35s var(--hp-ease); }
  .hp-occasion__card:hover .hp-occasion__cta .hp-icon { transform: translateX(4px); }

  @media screen and (max-width: 749px) {
    .hp-occasion__card { padding: 1.8rem 1.1rem 1.6rem; gap: 0.7rem; }
    .hp-occasion__card .hp-chip { width: 4.2rem; height: 4.2rem; }
    .hp-occasion__caption { font-size: 1.1rem; }
    .hp-occasion__cta { padding-top: 0.8rem; font-size: 0.95rem; }
  }
{%- endstyle -%}

<div class="hp-occasion hp-section">
  <div class="hp-container">
    <div class="hp-section-head hp-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--rule-after" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text" data-hp-reveal>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-occasion__grid" data-hp-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign href = block.settings.link
          if href == blank and col != blank
            assign href = col.url
          endif
        -%}
        <a
          class="hp-card hp-occasion__card"
          {% if href != blank %}href="{{ href }}"{% endif %}
          data-hp-reveal
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image -%}
            <span class="hp-occasion__media">
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
            </span>
          {%- else -%}
            <span class="hp-chip">{% render 'hp-icon', icon: block.settings.icon, size: 20 %}</span>
          {%- endif -%}
          <h3 class="hp-occasion__name">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.caption != blank -%}
            <p class="hp-occasion__caption">{{ block.settings.caption | escape }}</p>
          {%- endif -%}
          {%- if col != blank and section.settings.show_count -%}
            <p class="hp-occasion__count">{{ col.all_products_count }} {{ section.settings.count_label | default: 'varieties' | escape }}</p>
          {%- endif -%}
          {%- if href != blank -%}
            <span class="hp-occasion__cta">
              {{ section.settings.cta_label | default: 'Shop now' | escape }}
              {% render 'hp-icon', icon: 'arrow-right', size: 14 %}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Shop by Occasion",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter Three — The Table" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Occasion" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From quiet weekday meals to grand celebrations — set the table for the moment." },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#fff9df" },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#1a4b46",
      "info": "Card text, icon and count pill are all cream, so this needs to stay dark enough to read against."
    },
    {
      "type": "color",
      "id": "card_color_hover",
      "label": "Card background on hover",
      "default": "#123532",
      "info": "Also used as the icon colour once the circle fills cream on hover."
    },
    { "type": "checkbox", "id": "show_count", "label": "Show live product counts", "default": true },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "varieties" },
    { "type": "text", "id": "cta_label", "label": "Card link label", "default": "Shop now" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "utensils", "label": "Utensils" },
            { "value": "users", "label": "Guests" },
            { "value": "coffee", "label": "Tea time" },
            { "value": "moon-star", "label": "Ramadan" },
            { "value": "sparkles", "label": "Eid" },
            { "value": "heart", "label": "Wedding" },
            { "value": "hand-platter", "label": "Serving" },
            { "value": "flame", "label": "Kitchen" }
          ],
          "default": "utensils"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)",
          "info": "Shown above the title instead of the icon chip."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Everyday Dining" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Sturdy, beautiful staples" },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The card links here and shows this collection's live product count."
        },
        { "type": "url", "id": "link", "label": "Custom link (overrides collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Shop by Occasion",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion", "settings": { "icon": "users", "title": "Hosting Guests", "caption": "Sets that impress" } },
        { "type": "occasion", "settings": { "icon": "coffee", "title": "Tea Time", "caption": "Slow afternoon rituals" } },
        { "type": "occasion", "settings": { "icon": "moon-star", "title": "Ramadan", "caption": "Iftar & suhoor tables" } },
        { "type": "occasion", "settings": { "icon": "sparkles", "title": "Eid", "caption": "Festive gatherings" } },
        { "type": "occasion", "settings": { "icon": "heart", "title": "Wedding Gifts", "caption": "Heirlooms to give" } }
      ]
    }
  ]
}
{% endschema %}
