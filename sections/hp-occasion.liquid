{% comment %}
  THP — v3 Shop by Occasion.

  Redesigned: the cards were white-on-cream, which gave the section almost no
  contrast against the band behind it and left each card looking like an empty
  box with a lot of dead space under the text. They are now deep-teal panels on
  the cream band — the same brand teal used elsewhere, so the section finally
  reads as a deliberate block rather than washed-out padding — sized to their
  content instead of a fixed tall box.

  Each occasion is backed by a real collection: the card links to it and can
  show its live product count.
{% endcomment %}

{%- liquid
  assign card_bg = section.settings.card_color | default: '#173f40'
  assign card_bg_hover = section.settings.card_color_hover | default: '#257575'
-%}

{%- style -%}
  .hp-occasion { background: {{ section.settings.bg_color | default: '#fff9df' }}; }
  .hp-occasion__grid {
    display: grid;
    gap: clamp(1rem, 1.4vw, 1.6rem);
    grid-template-columns: repeat(2, 1fr);
  }
  @media screen and (min-width: 750px) { .hp-occasion__grid { grid-template-columns: repeat(3, 1fr); } }
  @media screen and (min-width: 1200px) { .hp-occasion__grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 6 | at_least: 3 }}, 1fr); } }

  .hp-occasion__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* No `justify-content` and no fixed height: the card is exactly as tall as
       its content, and the grid's stretch alignment keeps the row even. That is
       what removes the dead space the old fixed-padding card left underneath. */
    gap: 1rem;
    padding: 2.6rem 1.6rem 2.4rem;
    border-radius: var(--hp-r-card);
    background: {{ card_bg }};
    /* Hairline is a lightened version of the card itself rather than a flat
       white alpha, so the edge stays readable on both light and dark settings. */
    border: 1px solid rgba(255, 249, 223, 0.13);
    text-decoration: none;
    color: var(--hp-cream);
    overflow: hidden;
    isolation: isolate;
    transition: background-color 0.45s var(--hp-ease), transform 0.45s var(--hp-ease),
      box-shadow 0.45s var(--hp-ease), border-color 0.45s var(--hp-ease);
  }
  /* Soft radial bloom behind the icon — stops the flat teal panel reading as a
     plain rectangle without adding another element to the markup. */
  .hp-occasion__card::before {
    content: '';
    position: absolute;
    inset: -40% 20% auto;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(127, 200, 190, 0.28), transparent 68%);
    opacity: 0;
    transition: opacity 0.55s var(--hp-ease);
    z-index: -1;
  }
  .hp-occasion__card:hover,
  .hp-occasion__card:focus-visible {
    background: {{ card_bg_hover }};
    border-color: rgba(255, 249, 223, 0.28);
    transform: translateY(-6px);
    box-shadow: var(--hp-shadow-card);
  }
  .hp-occasion__card:hover::before,
  .hp-occasion__card:focus-visible::before { opacity: 1; }
  .hp-occasion__card:focus-visible { outline: 2px solid var(--hp-cream); outline-offset: 3px; }

  /* Icon chip inverted for the dark panel: translucent cream instead of the
     pale teal chip, which would have been invisible against this background. */
  .hp-occasion__card .hp-chip {
    width: 5.2rem;
    height: 5.2rem;
    background: rgba(255, 249, 223, 0.1);
    border: 1px solid rgba(255, 249, 223, 0.22);
    color: var(--hp-cream);
  }
  .hp-occasion__card:hover .hp-chip {
    background: var(--hp-cream);
    color: {{ card_bg_hover }};
    border-color: var(--hp-cream);
    transform: translateY(-2px) scale(1.04);
  }

  .hp-occasion__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 249, 223, 0.08);
    margin-bottom: 0.2rem;
  }
  .hp-occasion__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--hp-ease); }
  .hp-occasion__card:hover .hp-occasion__media img { transform: scale(1.06); }
  .hp-occasion__card:has(.hp-occasion__media) { padding: 1.2rem 1.2rem 2rem; }

  .hp-occasion__name {
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 1.6vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.002em;
    color: var(--hp-cream);
  }
  .hp-occasion__caption {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgba(255, 249, 223, 0.7);
  }
  /* Count sits in a pill so it reads as metadata, not as a third line of copy */
  .hp-occasion__count {
    margin: 0.2rem 0 0;
    padding: 0.4rem 1rem;
    border-radius: var(--hp-r-pill);
    background: rgba(255, 249, 223, 0.1);
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-cream);
  }
  /* Always-visible link affordance. The old version faded this in on hover,
     which meant it simply never appeared for any touch visitor. */
  .hp-occasion__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.2rem;
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-teal-soft);
    transition: color 0.35s var(--hp-ease);
  }
  .hp-occasion__card:hover .hp-occasion__cta { color: var(--hp-cream); }
  .hp-occasion__cta .hp-icon { transition: transform 0.35s var(--hp-ease); }
  .hp-occasion__card:hover .hp-occasion__cta .hp-icon { transform: translateX(4px); }

  @media screen and (max-width: 749px) {
    .hp-occasion__card { padding: 2rem 1.2rem 1.8rem; gap: 0.8rem; }
    .hp-occasion__card .hp-chip { width: 4.4rem; height: 4.4rem; }
    .hp-occasion__caption { font-size: 1.1rem; }
    .hp-occasion__cta { padding-top: 0.8rem; font-size: 0.95rem; }
  }
{%- endstyle -%}

<div class="hp-occasion hp-section">
  <div class="hp-container">
    <div class="hp-section-head hp-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--rule-after" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text" data-hp-reveal>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-occasion__grid" data-hp-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign href = block.settings.link
          if href == blank and col != blank
            assign href = col.url
          endif
        -%}
        {%- comment -%}
          Deliberately not using the shared .hp-card shell here — it paints a
          white background and a dark hairline, both of which this card
          overrides anyway, so inheriting it would only invite a specificity
          fight between two rules that disagree.
        {%- endcomment -%}
        <a
          class="hp-occasion__card"
          {% if href != blank %}href="{{ href }}"{% endif %}
          data-hp-reveal
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image -%}
            <span class="hp-occasion__media">
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
            </span>
          {%- else -%}
            <span class="hp-chip">{% render 'hp-icon', icon: block.settings.icon, size: 20 %}</span>
          {%- endif -%}
          <h3 class="hp-occasion__name">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.caption != blank -%}
            <p class="hp-occasion__caption">{{ block.settings.caption | escape }}</p>
          {%- endif -%}
          {%- if col != blank and section.settings.show_count -%}
            <p class="hp-occasion__count">{{ col.all_products_count }} {{ section.settings.count_label | default: 'varieties' | escape }}</p>
          {%- endif -%}
          {%- if href != blank -%}
            <span class="hp-occasion__cta">
              {{ section.settings.cta_label | default: 'Shop now' | escape }}
              {% render 'hp-icon', icon: 'arrow-right', size: 14 %}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Shop by Occasion",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter Three — The Table" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Occasion" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From quiet weekday meals to grand celebrations — set the table for the moment." },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#fff9df" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#173f40" },
    {
      "type": "color",
      "id": "card_color_hover",
      "label": "Card background on hover",
      "default": "#257575",
      "info": "Card text is always cream, so keep both of these dark enough to read against."
    },
    { "type": "checkbox", "id": "show_count", "label": "Show live product counts", "default": true },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "varieties" },
    { "type": "text", "id": "cta_label", "label": "Card link label", "default": "Shop now" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "utensils", "label": "Utensils" },
            { "value": "users", "label": "Guests" },
            { "value": "coffee", "label": "Tea time" },
            { "value": "moon-star", "label": "Ramadan" },
            { "value": "sparkles", "label": "Eid" },
            { "value": "heart", "label": "Wedding" },
            { "value": "hand-platter", "label": "Serving" },
            { "value": "flame", "label": "Kitchen" }
          ],
          "default": "utensils"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)",
          "info": "Shown above the title instead of the icon chip."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Everyday Dining" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Sturdy, beautiful staples" },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The card links here and shows this collection's live product count."
        },
        { "type": "url", "id": "link", "label": "Custom link (overrides collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Shop by Occasion",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion", "settings": { "icon": "users", "title": "Hosting Guests", "caption": "Sets that impress" } },
        { "type": "occasion", "settings": { "icon": "coffee", "title": "Tea Time", "caption": "Slow afternoon rituals" } },
        { "type": "occasion", "settings": { "icon": "moon-star", "title": "Ramadan", "caption": "Iftar & suhoor tables" } },
        { "type": "occasion", "settings": { "icon": "sparkles", "title": "Eid", "caption": "Festive gatherings" } },
        { "type": "occasion", "settings": { "icon": "heart", "title": "Wedding Gifts", "caption": "Heirlooms to give" } }
      ]
    }
  ]
}
{% endschema %}
