{% comment %}
  THP — Shop by Occasion. Each card is backed by a real collection (or tag),
  showing a photo, a Lucide icon and a live product count so the occasion is
  defined in terms of actual products rather than a decorative label.
{% endcomment %}

{%- style -%}
  .hp-occasion { background: var(--hp-moss); color: var(--hp-linen); }
  .hp-occasion .hp-eyebrow { color: var(--hp-cream); }
  .hp-occasion .hp-section-head__title { color: var(--hp-linen); }
  .hp-occasion .hp-section-head__text { color: rgba(239, 236, 236, 0.72); }

  .hp-occasion__grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media screen and (min-width: 750px) { .hp-occasion__grid { grid-template-columns: repeat(3, 1fr); } }

  .hp-occasion__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: var(--hp-linen);
    text-decoration: none;
    border: 1px solid var(--hp-hairline-light);
    background: rgba(239, 236, 236, 0.04);
  }
  @media screen and (min-width: 750px) { .hp-occasion__card { aspect-ratio: 1 / 1; } }
  .hp-occasion__media { position: absolute; inset: 0; }
  .hp-occasion__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hp-focal, 50% 50%);
    opacity: 0.62;
    transition: transform 1.4s var(--hp-ease), opacity 0.6s var(--hp-ease);
  }
  .hp-occasion__card:hover .hp-occasion__media img { transform: scale(1.06); opacity: 0.78; }
  .hp-occasion__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14, 6, 6, 0.72), rgba(14, 6, 6, 0.1) 65%);
  }
  .hp-occasion__body {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    gap: 1.2rem;
    padding: 2.8rem 1.8rem;
  }
  .hp-occasion__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.4rem;
    height: 5.4rem;
    border: 1px solid rgba(255, 249, 223, 0.5);
    border-radius: 50%;
    color: var(--hp-cream);
    margin-bottom: auto;
    transition: transform 0.4s var(--hp-ease), background 0.4s var(--hp-ease), color 0.4s var(--hp-ease);
  }
  .hp-occasion__card:hover .hp-occasion__icon {
    transform: translateY(-4px);
    background: var(--hp-cream);
    color: var(--hp-moss);
  }
  .hp-occasion__name {
    margin: 0;
    font-family: var(--hp-font-display);
    font-size: clamp(1.9rem, 2.4vw, 2.4rem);
    font-weight: 500;
    text-shadow: 0 1px 16px rgba(14, 6, 6, 0.5);
  }
  .hp-occasion__meta {
    margin: 0;
    font-size: 1.02rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 249, 223, 0.82);
  }
  .hp-occasion__caption {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgba(239, 236, 236, 0.8);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.5s var(--hp-ease), opacity 0.4s var(--hp-ease);
  }
  .hp-occasion__card:hover .hp-occasion__caption,
  .hp-occasion__card:focus-visible .hp-occasion__caption { max-height: 8rem; opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hp-occasion__caption { max-height: 8rem; opacity: 1; transition: none; }
  }
{%- endstyle -%}

<div class="hp-occasion hp-section">
  <div class="hp-container">
    <div class="hp-section-head hp-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--rule-after" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text" data-hp-reveal>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-occasion__grid" data-hp-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign card_image = block.settings.image | default: col.featured_image
          assign card_link = block.settings.link
          if card_link == blank and col != blank
            assign card_link = col.url
          endif
        -%}
        <a
          class="hp-occasion__card"
          {% if card_link != blank %}href="{{ card_link }}"{% endif %}
          style="--hp-focal: {{ block.settings.focal_x }}% {{ block.settings.focal_y }}%;"
          data-hp-reveal
          {{ block.shopify_attributes }}
        >
          <div class="hp-occasion__media">
            {%- if card_image -%}
              {{
                card_image
                | image_url: width: 900
                | image_tag: widths: '300, 500, 700, 900', sizes: '(min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: block.settings.title
              }}
            {%- endif -%}
          </div>
          <div class="hp-occasion__body">
            <span class="hp-occasion__icon">{% render 'hp-icon', icon: block.settings.icon, size: 22 %}</span>
            <h3 class="hp-occasion__name">{{ block.settings.title | escape }}</h3>
            {%- if col != blank and section.settings.show_count -%}
              <p class="hp-occasion__meta">
                {{ col.all_products_count }} {{ section.settings.count_label | escape }}
              </p>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="hp-occasion__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Shop by Occasion",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter Three — The Table" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Occasion" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From quiet weekday meals to grand celebrations — set the table for the moment." },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "varieties" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Everyday Dining" },
        { "type": "text", "id": "caption", "label": "Caption (shown on hover)", "default": "Sturdy, beautiful staples" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "utensils", "label": "Utensils" },
            { "value": "users", "label": "Guests" },
            { "value": "coffee", "label": "Tea time" },
            { "value": "moon-star", "label": "Ramadan" },
            { "value": "sparkles", "label": "Eid" },
            { "value": "heart", "label": "Wedding" },
            { "value": "hand-platter", "label": "Serving" },
            { "value": "flame", "label": "Kitchen" },
            { "value": "gem", "label": "Gem" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "utensils"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Defines the products behind this occasion — also supplies the image and link if left blank below."
        },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        {
          "type": "range",
          "id": "focal_x",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Focal point — horizontal",
          "default": 50
        },
        {
          "type": "range",
          "id": "focal_y",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Focal point — vertical",
          "default": 50
        },
        { "type": "url", "id": "link", "label": "Custom link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Shop by Occasion",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion", "settings": { "icon": "users", "title": "Hosting Guests", "caption": "Sets that impress" } },
        { "type": "occasion", "settings": { "icon": "coffee", "title": "Tea Time", "caption": "Slow afternoon rituals" } },
        { "type": "occasion", "settings": { "icon": "moon-star", "title": "Ramadan", "caption": "Iftar & suhoor tables" } },
        { "type": "occasion", "settings": { "icon": "sparkles", "title": "Eid", "caption": "Festive gatherings" } },
        { "type": "occasion", "settings": { "icon": "heart", "title": "Wedding Gifts", "caption": "Heirlooms to give" } }
      ]
    }
  ]
}
{% endschema %}
