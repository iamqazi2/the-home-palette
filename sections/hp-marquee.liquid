{% comment %} THP — Serif brand marquee band {% endcomment %}

{%- style -%}
  .hp-marquee-band {
    background: {{ section.settings.bg_color | default: '#1a4b46' }};
    padding: {{ section.settings.padding | default: 18 }}px 0;
  }
  .hp-marquee-band .hp-marquee__track {
    gap: 0;
    animation-duration: {{ section.settings.speed | default: 32 }}s;
  }
  .hp-marquee-band__item {
    display: inline-flex;
    align-items: center;
    gap: 2.2rem;
    padding-right: 2.2rem;
    font-family: var(--hp-font-display);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: {{ section.settings.text_color | default: '#fff9df' }};
    white-space: nowrap;
    font-size: clamp({{ section.settings.size | default: 24 | divided_by: 10.0 }}rem, 3.4vw, {{ section.settings.size | default: 24 | times: 1.7 | divided_by: 10.0 }}rem);
  }
  .hp-marquee-band__item .hp-icon { color: {{ section.settings.text_color | default: '#fff9df' | color_modify: 'alpha', 0.6 }}; }
{%- endstyle -%}

<div class="hp-marquee-band">
  <div class="hp-marquee hp-marquee--pause" aria-hidden="true">
    <div class="hp-marquee__track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <span class="hp-marquee-band__item" {{ block.shopify_attributes }}>
            {{ block.settings.text | escape }}
            {% render 'hp-icon', icon: block.settings.icon, size: 20 %}
          </span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  <span class="visually-hidden">
    {%- for block in section.blocks -%}{{ block.settings.text | escape }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
  </span>
</div>

{% schema %}
{
  "name": "THP Marquee",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1a4b46" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fff9df" },
    { "type": "header", "content": "Layout & motion" },
    { "type": "range", "id": "size", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Text size (mobile base)", "default": 24 },
    { "type": "range", "id": "padding", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Band padding", "default": 18 },
    { "type": "range", "id": "speed", "min": 16, "max": 70, "step": 2, "unit": "s", "label": "Scroll duration (lower = faster)", "default": 32 }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Phrase",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Crafted in Pakistan" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "gem", "label": "Gem" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "utensils", "label": "Utensils" },
            { "value": "coffee", "label": "Coffee" }
          ],
          "default": "sparkles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Marquee",
      "blocks": [
        { "type": "phrase" },
        { "type": "phrase", "settings": { "text": "Made for Fine Dining", "icon": "utensils" } },
        { "type": "phrase", "settings": { "text": "Supporting Local Artisans", "icon": "heart" } },
        { "type": "phrase", "settings": { "text": "Homes & Hospitality", "icon": "gem" } }
      ]
    }
  ]
}
{% endschema %}
