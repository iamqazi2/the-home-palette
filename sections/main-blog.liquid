{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ---- hero: same band treatment as the collection pages ---------------- */
  .hp-blog-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(28rem, 34vw, 40rem);
    background: var(--hp-teal);
    color: var(--hp-cream);
    overflow: hidden;
  }
  .hp-blog-hero__inner { width: 100%; padding: clamp(3.2rem, 6vw, 6rem) 0; position: relative; z-index: 2; }
  .hp-blog-hero__media { position: absolute; inset: 0; z-index: 0; }
  .hp-blog-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .hp-blog-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(10, 35, 32, 0.88), rgba(16, 48, 44, 0.55));
  }
  .hp-blog-hero__eyebrow { margin: 0 0 1.4rem; }
  .hp-blog-hero__title { margin: 0; color: var(--hp-cream); font-size: var(--hp-h-page); }
  .hp-blog-hero__tagline {
    margin: 1.4rem 0 0;
    max-width: 56rem;
    font-size: 1.55rem;
    line-height: 1.75;
    color: rgba(255, 249, 223, 0.88);
  }

  /* ---- listing ---------------------------------------------------------- */
  .hp-blog { background: var(--hp-cream-soft); }

  .hp-blog__card {
    display: flex;
    flex-direction: column;
    background: var(--hp-paper);
    border: 1px solid var(--hp-hairline);
    border-radius: var(--hp-r-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--hp-ink);
    height: 100%;
    transition: transform 0.45s var(--hp-ease), box-shadow 0.45s var(--hp-ease);
  }
  .hp-blog__card:hover { transform: translateY(-8px); box-shadow: var(--hp-shadow-card); }
  .hp-blog__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--hp-linen);
  }
  .hp-blog__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--hp-ease); }
  .hp-blog__card:hover .hp-blog__media img { transform: scale(1.06); }
  .hp-blog__body { display: flex; flex-direction: column; gap: 0.9rem; padding: 2rem 1.8rem 2.2rem; flex: 1 1 auto; }
  .hp-blog__meta {
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-teal);
  }
  .hp-blog__title {
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: var(--hp-h-block);
    line-height: 1.25;
    letter-spacing: -0.004em;
    color: var(--hp-heading);
  }
  .hp-blog__excerpt {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--hp-taupe);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hp-blog__more {
    margin-top: auto;
    padding-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--hp-font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-teal);
  }
  .hp-blog__card:hover .hp-blog__more .hp-icon { transform: translateX(4px); }
  .hp-blog__more .hp-icon { transition: transform 0.35s var(--hp-ease); }

  /* Lead story: the newest post gets the full width and a side-by-side layout,
     which is what stops the page reading as an undifferentiated wall of cards. */
  .hp-blog__lead { margin-bottom: clamp(2.4rem, 4vw, 4rem); }
  @media screen and (min-width: 900px) {
    .hp-blog__lead .hp-blog__card { flex-direction: row; align-items: stretch; }
    .hp-blog__lead .hp-blog__media { flex: 0 0 55%; aspect-ratio: auto; }
    .hp-blog__lead .hp-blog__body { justify-content: center; padding: clamp(2.4rem, 3.4vw, 4rem); }
    .hp-blog__lead .hp-blog__title { font-size: var(--hp-h-section); }
    .hp-blog__lead .hp-blog__excerpt { -webkit-line-clamp: 4; font-size: 1.5rem; }
  }

  .hp-blog__grid { display: grid; gap: clamp(1.6rem, 2.4vw, 2.4rem); grid-template-columns: 1fr; }
  @media screen and (min-width: 750px) { .hp-blog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (min-width: 1200px) { .hp-blog__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .hp-blog__empty {
    text-align: center;
    padding: clamp(3rem, 6vw, 6rem) 1rem;
    color: var(--hp-taupe);
    font-size: 1.5rem;
  }
{%- endstyle -%}

{%- liquid
  assign hero_alt = section.settings.hp_hero_image.alt | default: blog.title | escape
-%}

<div class="hp-blog-hero">
  {%- if section.settings.hp_hero_image != blank -%}
    <div class="hp-blog-hero__media">
      {{
        section.settings.hp_hero_image
        | image_url: width: 2200
        | image_tag: widths: '600, 900, 1200, 1600, 2200', sizes: '100vw', alt: hero_alt, fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}
  <div class="hp-blog-hero__inner page-width">
    {%- if section.settings.hp_eyebrow != blank -%}
      <p class="hp-eyebrow hp-eyebrow--light hp-blog-hero__eyebrow">{{ section.settings.hp_eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="hp-blog-hero__title">{{ blog.title | escape }}</h1>
    {%- if section.settings.hp_tagline != blank -%}
      <p class="hp-blog-hero__tagline">{{ section.settings.hp_tagline }}</p>
    {%- endif -%}
  </div>
</div>

{%- paginate blog.articles by 7 -%}
  <div class="hp-blog">
    <div class="main-blog page-width section-{{ section.id }}-padding">
      {%- if blog.articles.size == 0 -%}
        <p class="hp-blog__empty">No stories yet — check back soon.</p>
      {%- else -%}
        {%- liquid
          # The newest post runs as a full-width lead story, and the grid then
          # starts one item later. Only on page one: paging back should not
          # present a second, different article as though it were featured.
          assign grid_offset = 0
          if paginate.current_page == 1
            assign grid_offset = 1
          endif
        -%}

        {%- if grid_offset == 1 -%}
          <div class="hp-blog__lead" data-hp-reveal>
            {% render 'hp-blog-card',
              article: blog.articles.first,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              lead: true
            %}
          </div>
        {%- endif -%}

        <div class="hp-blog__grid" data-hp-stagger>
          {%- for article in blog.articles offset: grid_offset -%}
            <div data-hp-reveal>
              {% render 'hp-blog-card',
                article: article,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main-blog.settings.layout.options__1.label"
        },
        {
          "value": "collage",
          "label": "t:sections.main-blog.settings.layout.options__2.label"
        }
      ],
      "default": "collage",
      "label": "t:sections.main-blog.settings.layout.label",
      "info": "t:sections.main-blog.settings.layout.info"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label",
      "info": "t:sections.main-blog.settings.image_height.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hp_hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hp_eyebrow",
      "label": "Eyebrow",
      "default": "The Journal"
    },
    {
      "type": "textarea",
      "id": "hp_tagline",
      "label": "Tagline",
      "default": "Styling notes, care guides and table stories from The Home Palette."
    }
  ]
}
{% endschema %}
