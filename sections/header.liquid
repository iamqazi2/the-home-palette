<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ---- dropdown panels (Categories, Policies) ----------------------------
     Written here, not in hp-theme.css, because component-list-menu.css is
     <link>ed at the top of this section — into <body>, later than hp-theme.css
     in <head> — so Dawn's menu rules beat that file at equal specificity.

     Where !important appears below it is because base.css wins on specificity,
     not on order, and matching it selector-for-selector would be worse to read:
       .header__submenu.list-menu        two classes, sets the panel padding
       .header__submenu .header__menu-item:hover   sets a hover underline
       .header__menu-item > span         sets uppercase + tracking site-wide
     Each of those is noted at the rule that overrides it. */

  .header__submenu,
  .header__submenu.list-menu {
    min-width: 27rem;
    /* !important: .header__submenu.list-menu in base.css is two classes and
       would otherwise keep its own 1rem 0, which pushes rows edge to edge. */
    padding: 0.6rem !important;
    border: 1px solid var(--hp-hairline);
    border-radius: 16px;
    background: var(--hp-paper);
    box-shadow:
      0 24px 48px -28px rgba(16, 48, 44, 0.42),
      0 2px 8px -4px rgba(16, 48, 44, 0.12);
  }

  /* Rows: full-width rounded targets with a tinted hover. */
  .header__submenu .header__menu-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    color: var(--hp-ink);
    /* !important: base.css underlines .link / .header__menu-item, which drew a
       rule under every row in the panel and under the group heading. A menu
       row is already a target by virtue of its hover fill. */
    text-decoration: none !important;
    transition: background-color 0.18s var(--hp-ease), color 0.18s var(--hp-ease);
  }
  /* The type is set on the inner <span>, so it has to be reset there — setting
     it on the row does nothing, which is why parent rows stayed uppercase while
     plain links (which have no span) came out correct. */
  .header__submenu .header__menu-item > span,
  .header__submenu .header__menu-item {
    font-family: var(--hp-font-ui);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    padding-bottom: 0;
  }
  .header__submenu .header__menu-item:hover,
  .header__submenu .header__menu-item:focus-visible {
    background: var(--hp-teal-chip);
    color: var(--hp-teal);
    /* !important: base.css sets text-decoration-line: underline on this exact
       selector, so an underline was drawing on top of the hover fill. */
    text-decoration: none !important;
  }
  /* The top-level nav's sliding underline has no place in a panel — with a
     hover background on the row the two read as a doubled hover state. */
  .header__submenu .header__menu-item > span::after,
  .header__submenu .header__menu-item::after { content: none !important; }

  /* A group heading is not a destination — it labels the links under it. Set
     as a small caps eyebrow it stops competing with them for the same reading
     weight, which is what made the panel one flat list of equal-looking rows
     with no way to tell a heading from a link. */
  .header__submenu > li > details > summary.header__menu-item,
  .header__submenu > li > details > summary.header__menu-item > span {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-taupe);
  }
  .header__submenu > li > details > summary.header__menu-item {
    padding: 1.1rem 1.2rem 0.7rem;
    cursor: pointer;
  }
  /* the heading is a disclosure, so it still needs a hover state — a colour
     shift rather than the links' fill, which would read as a selected row */
  .header__submenu > li > details > summary.header__menu-item:hover,
  .header__submenu > li > details[open] > summary.header__menu-item {
    background: transparent;
    color: var(--hp-teal);
  }

  /* Nested lists expand INSIDE the panel as an indented group — no second card.
     They were always inline in the flow; they only looked like a floating panel
     because they were wearing the same card surface as their parent. The rail
     and indent that said "these belong to the row above" are no longer needed
     now the heading above them reads as a heading, and dropping them buys the
     links back the full width of the panel. */
  .header__submenu .header__submenu,
  .header__submenu .header__submenu.list-menu,
  .header-wrapper .header__submenu .header__submenu {
    position: static;
    min-width: 0;
    width: auto;
    margin: 0 0 0.4rem !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }
  .header__submenu .header__submenu .header__menu-item {
    padding: 0.85rem 1.2rem;
    border-radius: 10px;
  }
  .header__submenu .header__submenu .header__menu-item > span,
  .header__submenu .header__submenu .header__menu-item { font-size: 1.35rem; }

  /* A hairline between the panel's top-level groups, so it reads as sections
     rather than one long column. On the <li> rather than on the row inside it,
     so it never draws across a hovered row's rounded fill — and scoped by
     .list-menu--disclosure, which only the outer panel carries: without it the
     nested list matched too and ruled off every single link. */
  .header__submenu.list-menu--disclosure > li + li {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--hp-hairline);
  }

  /* A chevron that slides in on hover marks a row as somewhere to go, and
     gives the eye a consistent right edge to track down the list. Only on
     links: a summary already carries a caret, and two arrows on one row would
     say the heading both expands and navigates. */
  .header__submenu a.header__menu-item::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg) translateX(-0.3rem);
    opacity: 0;
    transition: opacity 0.18s var(--hp-ease), transform 0.18s var(--hp-ease);
    order: 2;
  }
  .header__submenu a.header__menu-item:hover::before,
  .header__submenu a.header__menu-item:focus-visible::before {
    opacity: 0.55;
    transform: rotate(-45deg) translateX(0);
  }

  /* The page you are on, marked in the menu rather than left to be guessed. */
  .header__submenu .list-menu__item--active,
  .header__submenu .header__menu-item[aria-current='page'] {
    color: var(--hp-teal);
    font-weight: 600;
  }

  .header__submenu .header__menu-item:focus-visible {
    outline: 2px solid var(--hp-teal);
    outline-offset: -2px;
  }

  /* Caret turns to point down when its group is open. */
  .header__submenu .icon-caret {
    flex-shrink: 0;
    width: 1rem;
    margin-left: 0.8rem;
    opacity: 0.6;
    transition: transform 0.25s var(--hp-ease);
  }
  .header__submenu details[open] > summary .icon-caret { transform: rotate(180deg); }

  /* Settle in rather than snapping open. */
  @media (prefers-reduced-motion: no-preference) {
    header-menu > details[open] > .header__submenu {
      animation: hpMenuIn 0.22s var(--hp-ease) both;
    }
    @keyframes hpMenuIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: none; }
    }
  }

  /* ======================================================================
     Mobile menu drawer
     ======================================================================
     Dawn ships the drawer as a stack of sliding panels: tapping a parent
     pushes a whole new panel over the menu, and the way back is a small
     "‹ Categories" button at the top. On a phone that means you lose sight
     of the rest of the nav to see three links, and the back button is the
     only exit — which is the pattern that reads as dated and broken.

     This turns it into an accordion: a parent expands in place, everything
     else stays where it was, and the caret shows state. The markup is
     untouched — it is the same <details> the sliding panels were built on,
     restyled — so Dawn's own JS (focus trap, escape, body scroll lock) keeps
     working, and hp-theme.js still closes the whole drawer on any link tap.

     Colours come from the theme tokens rather than Dawn's scheme variables,
     so the drawer matches the header it opens from.
     ------------------------------------------------------------------ */

  /* the scrim behind the panel */
  menu-drawer > details[open] > summary::before {
    background: rgba(8, 26, 27, 0.5) !important;
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .menu-drawer {
    background-color: var(--hp-cream-soft) !important;
    border: 0 !important;
    filter: drop-shadow(0 18px 40px rgba(16, 48, 44, 0.28)) !important;
  }
  .menu-drawer__navigation { padding: 0.8rem 0 2rem; }

  /* Neither base.css nor component-list-menu.css actually resets .list-menu,
     so the drawer's lists were rendering with browser bullets and a 40px
     marker indent that pushed every row off its own padding. */
  .menu-drawer .menu-drawer__menu,
  .menu-drawer .menu-drawer__menu > li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---- rows -------------------------------------------------------- */

  .menu-drawer__menu-item {
    /* content-box would add the padding on top of min-height and make every
       row 8.4rem instead of the 5.6rem it asks for */
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    min-height: 5.6rem;
    padding: 1.4rem 2.4rem !important;
    font-family: var(--hp-font-ui);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: var(--hp-ink);
    text-decoration: none !important;
    transition: background-color 0.2s var(--hp-ease), color 0.2s var(--hp-ease);
  }
  /* a hairline under every row except the last, so the list reads as rows
     rather than as floating words */
  .menu-drawer__navigation > .menu-drawer__menu > li + li > .menu-drawer__menu-item,
  .menu-drawer__navigation > .menu-drawer__menu > li + li > details > summary.menu-drawer__menu-item {
    border-top: 1px solid var(--hp-hairline);
  }

  .menu-drawer__menu-item:hover,
  .menu-drawer__menu-item:focus {
    background-color: var(--hp-teal-chip) !important;
    color: var(--hp-teal) !important;
  }
  /* the page you are on, marked with a teal bar rather than a grey wash */
  .menu-drawer__menu-item--active,
  .menu-drawer__menu-item[aria-current='page'] {
    background-color: transparent !important;
    color: var(--hp-teal) !important;
    font-weight: 600;
    box-shadow: inset 3px 0 0 var(--hp-teal);
  }

  /* ---- parent rows: caret, not a slide-away arrow ------------------- */

  /* Dawn hides the caret and shows a right-pointing arrow, because tapping
     used to take you to another panel. In an accordion the caret is the
     honest affordance, so the two swap over. */
  .js .menu-drawer__menu-item .icon-caret { display: inline-flex !important; }
  .menu-drawer summary.menu-drawer__menu-item .svg-wrapper:has(.icon-arrow),
  .menu-drawer summary.menu-drawer__menu-item > .svg-wrapper:first-of-type { display: none; }
  .menu-drawer summary.menu-drawer__menu-item {
    padding-right: 2.4rem !important;
    cursor: pointer;
    list-style: none;
  }
  .menu-drawer summary.menu-drawer__menu-item::-webkit-details-marker { display: none; }
  .menu-drawer .icon-caret {
    position: static !important;
    flex: 0 0 auto;
    width: 1.1rem;
    transform: none;
    opacity: 0.55;
    transition: transform 0.25s var(--hp-ease);
  }
  .menu-drawer details[open].menu-opening > summary .icon-caret { transform: rotate(180deg); }
  .menu-drawer details[open].menu-opening > summary.menu-drawer__menu-item { color: var(--hp-teal) !important; }

  /* ---- submenu: expands in place ------------------------------------ */

  /* The sliding panel is unwound here: taken out of its absolute position and
     laid back into the flow. 0fr -> 1fr on a grid row is what lets it animate
     to its own height, which a plain height:auto cannot do. */
  .js .menu-drawer__submenu,
  .js .menu-drawer .menu-drawer__submenu {
    position: static !important;
    transform: none !important;
    visibility: visible !important;
    width: auto;
    background: transparent !important;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s var(--hp-ease);
  }
  .js .menu-drawer details[open].menu-opening > .menu-drawer__submenu { grid-template-rows: 1fr; }
  .menu-drawer__inner-submenu {
    min-height: 0;
    overflow: hidden;
  }
  /* Dawn hides the parent list from screen readers while a panel is over it.
     Nothing is over it any more, so that would hide the whole open menu. */
  .js .menu-drawer__navigation .submenu-open { visibility: visible !important; }
  /* the back button belonged to the panel that no longer exists */
  .menu-drawer__close-button { display: none !important; }

  /* child rows: indented under their parent, quieter until touched */
  .menu-drawer__submenu .menu-drawer__menu-item {
    min-height: 4.8rem;
    padding: 1.1rem 2.4rem 1.1rem 3.8rem !important;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--hp-taupe);
    border: 0 !important;
  }
  .menu-drawer__submenu .menu-drawer__menu-item:hover,
  .menu-drawer__submenu .menu-drawer__menu-item:focus { color: var(--hp-teal) !important; }
  .menu-drawer__submenu .menu-drawer__submenu .menu-drawer__menu-item {
    padding-left: 5.2rem !important;
    font-size: 1.4rem;
  }
  /* a rail down the expanded group ties the children to their heading */
  .menu-drawer__inner-submenu > .menu-drawer__menu {
    margin: 0.2rem 0 0.8rem 2.4rem;
    border-left: 2px solid var(--hp-teal-chip);
  }
  .menu-drawer__inner-submenu > .menu-drawer__menu .menu-drawer__menu-item {
    padding-left: 1.4rem !important;
  }

  /* ---- utility strip at the foot ------------------------------------ */

  .menu-drawer__utility-links {
    background-color: transparent !important;
    border-top: 1px solid var(--hp-hairline);
    padding: 1.6rem 2.4rem !important;
  }
  .menu-drawer__account {
    font-family: var(--hp-font-ui);
    font-size: 1.5rem;
    color: var(--hp-ink);
    text-decoration: none !important;
  }
  .menu-drawer__account:hover { color: var(--hp-teal); }

  /* The phone-only section shortcuts are a different kind of thing from the
     nav proper — they jump within a page — so they sit apart as quiet pills
     rather than pretending to be more top-level nav. */
  .menu-drawer .hp-nav-jump > .menu-drawer__menu-item {
    margin: 0.4rem 2.4rem;
    padding: 1rem 1.6rem !important;
    min-height: 0;
    border: 1px solid var(--hp-hairline-strong) !important;
    border-radius: var(--hp-r-pill);
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hp-taupe);
    justify-content: center;
  }
  .menu-drawer .hp-nav-jump > .menu-drawer__menu-item:hover {
    border-color: var(--hp-teal) !important;
    color: var(--hp-teal) !important;
    background: transparent !important;
  }
  .menu-drawer .hp-nav-jump + .hp-nav-jump > .menu-drawer__menu-item { margin-top: 0; }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{%- if section.settings.hp_band_enable -%}
  {%- style -%}
    /* THP fix #1 — full-width brand band behind the logo, so the logo's own
       square background blends into the header instead of floating on cream */
    .header-wrapper.hp-band,
    .header-wrapper.hp-band .header {
      background: {{ section.settings.hp_band_color }};
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      color: {{ section.settings.hp_band_text }};
      --color-foreground: {{ section.settings.hp_band_text | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    }
    .header-wrapper.hp-band .header__heading-link,
    .header-wrapper.hp-band > .header > .header__inline-menu .header__menu-item,
    .header-wrapper.hp-band > .header > .header__inline-menu .header__menu-item span,
    .header-wrapper.hp-band .header__icon,
    .header-wrapper.hp-band .header__icon .icon {
      color: {{ section.settings.hp_band_text }};
    }
    .header-wrapper.hp-band > .header > .header__inline-menu .header__menu-item > span::after {
      background: {{ section.settings.hp_band_text }};
    }
    .header-wrapper.hp-band .header__heading-logo-wrapper,
    .header-wrapper.hp-band .header__heading-logo {
      background: transparent;
      mix-blend-mode: normal;
    }
    .header-wrapper.hp-band { border-bottom: 1px solid rgba(255, 249, 223, 0.16); }
    .header-wrapper.hp-band .cart-count-bubble {
      background-color: {{ section.settings.hp_band_text }};
      color: {{ section.settings.hp_band_color }};
    }

    /* Colour only. The panel's surface — background, border, radius, shadow,
       padding — is set once in the dropdown block higher up and deliberately
       NOT repeated here.

       Repeating it was the bug behind nested menus looking like a card floating
       in front of the dropdown: this selector is three classes and renders
       after that block, so it re-painted EVERY .header__submenu as a card,
       including the nested ones the block above had just flattened. The nested
       list was always inline — it only looked detached because it was wearing
       the same card as its parent. */
    .header-wrapper.hp-band .mega-menu__content {
      background: var(--hp-cream-soft);
      border: 1px solid var(--hp-hairline);
      border-radius: 14px;
      box-shadow: 0 24px 48px -28px rgba(16, 48, 44, 0.55);
      padding: 1rem 0.6rem;
    }
    .header-wrapper.hp-band .header__submenu .header__menu-item,
    .header-wrapper.hp-band .header__submenu .header__menu-item span,
    .header-wrapper.hp-band .header__submenu a,
    .header-wrapper.hp-band .header__submenu summary,
    .header-wrapper.hp-band .mega-menu__content a,
    .header-wrapper.hp-band .mega-menu__link {
      color: var(--hp-ink) !important;
      opacity: 1 !important;
    }
    .header-wrapper.hp-band .header__submenu .header__menu-item:hover,
    .header-wrapper.hp-band .header__submenu .header__menu-item:hover span,
    .header-wrapper.hp-band .mega-menu__link:hover {
      color: var(--hp-teal) !important;
    }
    .header-wrapper.hp-band .header__submenu .header__menu-item > span::after,
    .header-wrapper.hp-band .header__submenu .header__menu-item span::after {
      background: var(--hp-teal);
    }
    .header-wrapper.hp-band .header__submenu .icon-caret { color: var(--hp-taupe); }
    /* drawer + search overlay are light surfaces too */
    .header-wrapper.hp-band .menu-drawer,
    .header-wrapper.hp-band .menu-drawer a,
    .header-wrapper.hp-band .menu-drawer summary,
    .header-wrapper.hp-band .search-modal,
    .header-wrapper.hp-band .search-modal input,
    .header-wrapper.hp-band predictive-search { color: var(--hp-ink); }
  {%- endstyle -%}
{%- endif -%}
<{% if section.settings.sticky_header_type != 'none' %}sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}{% if section.settings.hp_band_enable %} hp-band{% endif %}">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}{% if section.settings.hp_search_right %} header--search-right{% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer'
      endif

      if section.settings.logo_position == 'top-center' or section.settings.menu == blank
        render 'header-search', input_id: 'Search-In-Modal-1'
      endif
    -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {%- if settings.logo != blank -%}
              <div class="header__heading-logo-wrapper">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                {{ settings.logo | image_url: width: 600 | image_tag:
                  class: 'header__heading-logo motion-reduce',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
                }}
              </div>
            {%- else -%}
              <span class="h2">{{ shop.name }}</span>
            {%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      if section.settings.menu != blank
        if section.settings.menu_type_desktop == 'dropdown'
          render 'header-dropdown-menu'
        elsif section.settings.menu_type_desktop != 'drawer'
          render 'header-mega-menu'
        endif
      endif
    %}

    {%- if section.settings.logo_position == 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {%- if settings.logo != blank -%}
              <div class="header__heading-logo-wrapper">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
                {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                {{ settings.logo | image_url: width: 600 | image_tag:
                  class: 'header__heading-logo',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
                }}
              </div>
            {%- else -%}
              <span class="h2">{{ shop.name }}</span>
            {%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {% render 'header-search', input_id: 'Search-In-Modal' %}

      {%- comment -%}
        The account icon is off the header row by default. It still lives in the
        mobile menu drawer (header-drawer.liquid), so signing in is reachable
        there; turn the setting back on to put it beside search and cart.
      {%- endcomment -%}
      {%- if shop.customer_accounts_enabled and section.settings.hp_show_account -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
          {% if cart == empty %}
            <span class="svg-wrapper">{{'icon-cart-empty.svg' | inline_asset_content }}</span>
          {% else %}
            <span class="svg-wrapper">{{'icon-cart.svg' | inline_asset_content }}</span>
          {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</{% if section.settings.sticky_header_type != 'none' %}sticky-header{% else %}div{% endif %}>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always' || this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      };

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => this.preventReveal = true;

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach(disclosure => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

