{% comment %} THP — v3 CTA band: rounded full-bleed image, teal gradient, single cream CTA {% endcomment %}

{%- style -%}
  .hp-cta { background: var(--hp-cream-soft); }
  .hp-cta__frame {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    color: var(--hp-cream);
    background: var(--hp-teal-ink);
    transform: translateZ(0);
  }
  .hp-cta__media img {
    {% if section.settings.duotone %}filter: brightness(0.6) sepia(0.18) saturate(0.85);{% else %}filter: brightness(0.68);{% endif %}
  }
  /* Legibility: a deep teal wash on the copy side, easing off over the photo.
     Strength is merchant-adjustable for future images. */
  .hp-cta__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(12, 38, 39, {{ section.settings.scrim | divided_by: 100.0 }}) 0%,
      rgba(18, 53, 54, {{ section.settings.scrim | times: 0.82 | divided_by: 100.0 }}) 45%,
      rgba(37, 117, 117, {{ section.settings.scrim | times: 0.42 | divided_by: 100.0 }}) 100%
    );
  }
  /* extra vertical wash on phones, where the copy overlays the whole frame */
  @media screen and (max-width: 749px) {
    .hp-cta__scrim {
      background: linear-gradient(
        180deg,
        rgba(12, 38, 39, {{ section.settings.scrim | times: 0.7 | divided_by: 100.0 }}) 0%,
        rgba(12, 38, 39, {{ section.settings.scrim | divided_by: 100.0 }}) 100%
      );
    }
  }
  .hp-cta__inner {
    position: relative;
    padding: clamp(3rem, 6vw, 6rem) clamp(2rem, 5vw, 5rem);
    max-width: 58rem;
  }
  .hp-cta__heading {
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
    line-height: 1.06;
    margin: 1.2rem 0;
    color: #fff9df;
    text-shadow: 0 2px 20px rgba(12, 38, 39, 0.6);
  }
  .hp-cta__text {
    margin: 0 0 2.4rem;
    max-width: 44rem;
    font-size: 1.45rem;
    line-height: 1.8;
    color: rgba(255, 249, 223, 0.94);
    text-shadow: 0 1px 12px rgba(12, 38, 39, 0.6);
  }
  .hp-cta .hp-eyebrow--light { text-shadow: 0 1px 10px rgba(12, 38, 39, 0.7); }
{%- endstyle -%}

<div class="hp-cta hp-section hp-section--flush-top">
  <div class="hp-container">
    <div class="hp-cta__frame" data-hp-reveal>
      <div class="hp-media-frame" data-hp-parallax>
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 3000
            | image_tag: widths: '750, 1100, 1500, 2000, 3000', sizes: '100vw', loading: 'lazy'
          }}
        {%- endif -%}
      </div>
      <div class="hp-cta__scrim"></div>
      <div class="hp-cta__inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-eyebrow hp-eyebrow--light">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-cta__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hp-cta__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% endif %}
            class="hp-btn hp-btn--cream-solid"
          >
            {{ section.settings.button_label | escape }}
            {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP CTA Band",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "checkbox", "id": "duotone", "label": "Sepia/duotone treatment", "default": true },
    {
      "type": "range",
      "id": "scrim",
      "min": 30,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "info": "Raise this if the heading is hard to read over the photo.",
      "default": 82
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Weave Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Woven for the Everyday Feast" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hand-woven placemats and baskets that ground every table setting in warmth." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore THP Weaves" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "THP CTA Band" }]
}
{% endschema %}
