{% comment %} THP — Full-width duotone CTA band, single clear CTA {% endcomment %}

{%- style -%}
  .hp-cta {
    position: relative;
    overflow: hidden;
    min-height: 52rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--hp-cream);
    background: var(--hp-fern);
  }
  .hp-cta__media { position: absolute; inset: 0; }
  .hp-cta__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hp-focal, 50% 50%);
    {% if section.settings.duotone %}filter: sepia(0.35) saturate(0.75) contrast(0.98);{% endif %}
  }
  .hp-cta__scrim {
    position: absolute;
    inset: 0;
    background: rgba(14, 6, 6, {{ section.settings.scrim | divided_by: 100.0 }});
  }
  .hp-cta__frame {
    position: absolute;
    inset: 1.6rem;
    border: 1px solid rgba(255, 249, 223, 0.3);
    pointer-events: none;
  }
  .hp-cta__inner {
    position: relative;
    max-width: 76rem;
    padding: clamp(8rem, 12vw, 12rem) 2.4rem;
  }
  .hp-cta__heading {
    font-family: var(--hp-font-display);
    font-weight: 500;
    font-size: clamp(3.4rem, 6vw, 6.4rem);
    line-height: 1.06;
    margin: 2rem 0 0;
    color: var(--hp-cream);
  }
  .hp-cta__text {
    margin: 2rem auto 0;
    max-width: 52rem;
    font-size: 1.5rem;
    line-height: 1.8;
    letter-spacing: 0.03em;
    color: rgba(239, 236, 236, 0.9);
  }
  .hp-cta__action { margin-top: 3.6rem; }
{%- endstyle -%}

<div class="hp-cta" style="--hp-focal: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;">
  <div class="hp-cta__media hp-parallax" data-hp-depth="52">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag: widths: '750, 1100, 1500, 2000, 3000', sizes: '100vw', loading: 'lazy'
      }}
    {%- endif -%}
  </div>
  <div class="hp-cta__scrim"></div>
  <div class="hp-cta__frame"></div>
  <div class="hp-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp-eyebrow hp-eyebrow--rule-after hp-eyebrow--light" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="hp-cta__heading" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hp-cta__text" data-hp-reveal>{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="hp-cta__action" data-hp-reveal>
        <a
          {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% endif %}
          class="hp-btn hp-btn--cream-solid"
        >
          {{ section.settings.button_label | escape }}
          {% render 'hp-icon', icon: 'arrow-right', size: 16 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "THP CTA Band",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "checkbox", "id": "duotone", "label": "Sepia/duotone treatment", "default": true },
    {
      "type": "range",
      "id": "scrim",
      "min": 0,
      "max": 85,
      "step": 5,
      "unit": "%",
      "label": "Image shade",
      "info": "Raise this if the heading is hard to read.",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Focal point — horizontal",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Focal point — vertical",
      "default": 50
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Weave Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Woven for the Everyday Feast" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "THP CTA Band" }]
}
{% endschema %}
