{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Dawn's announcement bar, plus a "Sale / deal popup" block.

  Two block types live here, and they are deliberately unrelated on the page:

    announcement  the original one-line text (and its slider when there is
                  more than one). Untouched.
    deal          a sale or offer — title, description, media, button —
                  shown as a modal popup over the page, not in the bar.

  The deal is a block of THIS section only because that is where a merchant
  goes to manage promos; it does not render inside the utility bar. The markup
  is emitted here and then re-parented to <body> by initDealPopup (hp-theme.js)
  so that `position: fixed` is measured against the viewport — inside the
  header group it would otherwise be trapped by any ancestor that has a
  transform or containment on it.

  Block counts are partitioned (`ann_blocks` / `deal_blocks`) so a deal cannot
  make the announcement row believe it has an extra slide to rotate to.
{%- endcomment -%}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif

  comment
    Every count and lookup below reads ann_blocks, never section.blocks — a
    deal block must not make the announcement row think it has a second slide
    to rotate to, and must not become `.first` when there are no announcements
    at all.
  endcomment
  assign ann_blocks = section.blocks | where: 'type', 'announcement'
  assign deal_blocks = section.blocks | where: 'type', 'deal'

  if ann_blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if deal_blocks.size > 0 -%}
  {%- style -%}
    /* ------------------------------------------------------------------
       Sale / deal popup. Emitted once for the section; each block's own
       colours arrive as inline custom properties on its own element, so any
       number of deals can share this one stylesheet instead of carrying a
       <style> block apiece.
       ------------------------------------------------------------------ */
    .hp-deal {
      position: fixed;
      inset: 0;
      z-index: 998;                 /* under the video lightbox's 999 */
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(1.6rem, 4vw, 3.2rem);
      font-family: var(--hp-font-ui);
    }
    /* The markup ships hidden and JS opens it. Stated explicitly because the
       rule above sets display, and a bare [hidden] would lose to it — which
       would put an undismissable overlay on every page for anyone whose
       JavaScript never runs. Failing closed is the right direction here. */
    .hp-deal[hidden] { display: none; }
    .hp-deal * { box-sizing: border-box; }

    html.hp-deal-open,
    html.hp-deal-open body { overflow: hidden; }

    .hp-deal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(8, 26, 27, 0.66);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      transition: opacity 0.4s var(--hp-ease);
    }
    .hp-deal.is-open .hp-deal__backdrop { opacity: 1; }

    .hp-deal__panel {
      position: relative;
      z-index: 1;
      width: min(88rem, 100%);
      max-height: min(88vh, 76rem);
      overflow: auto;
      display: grid;
      grid-template-columns: 1fr;
      border-radius: var(--hp-r-card);
      background: var(--hp-deal-bg);
      color: var(--hp-deal-fg);
      box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7);
      opacity: 0;
      transform: translateY(20px) scale(0.98);
      transition: opacity 0.45s var(--hp-ease), transform 0.45s var(--hp-ease);
    }
    .hp-deal.is-open .hp-deal__panel { opacity: 1; transform: none; }
    /* Only ever focused programmatically, and it is not a control — a ring here
       would be noise. The controls inside keep theirs, in brand colours. */
    .hp-deal__panel:focus { outline: none; }
    .hp-deal__close:focus-visible,
    .hp-deal__btn:focus-visible,
    .hp-deal__dismiss:focus-visible {
      outline: 2px solid var(--hp-deal-accent);
      outline-offset: 3px;
    }

    .hp-deal__close {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      z-index: 3;
      width: 3.6rem;
      height: 3.6rem;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 50%;
      background: rgba(255, 249, 223, 0.92);
      color: var(--hp-espresso);
      cursor: pointer;
      transition: transform 0.3s var(--hp-ease);
    }
    .hp-deal__close:hover { transform: scale(1.1); }

    /* ---- media ------------------------------------------------------- */
    .hp-deal__media {
      position: relative;
      overflow: hidden;
      min-height: 20rem;
      background: rgba(0, 0, 0, 0.14);
    }
    .hp-deal__media img,
    .hp-deal__video {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* The clip sits over the still and is transparent until it has frames, so
       the still IS the poster and stays visible if the video never loads. It
       is fetched only once the popup is near the viewport — which, being
       fixed and full-screen, means as soon as it exists; see
       initLazyPreviewVideos in hp-theme.js. */
    .hp-deal__video { z-index: 1; }

    /* ---- copy -------------------------------------------------------- */
    .hp-deal__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.2rem;
      padding: clamp(2.4rem, 3.4vw, 4rem);
    }
    .hp-deal__eyebrow {
      display: inline-block;
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      opacity: 0.8;
    }
    .hp-deal__title {
      margin: 0;
      font-family: var(--hp-font-display);
      font-weight: 600;
      font-size: clamp(2.4rem, 3.4vw, 3.6rem);
      line-height: 1.06;
    }
    .hp-deal__text { margin: 0; font-size: 1.4rem; line-height: 1.65; opacity: 0.86; }
    .hp-deal__text > p { margin: 0; }
    .hp-deal__text > p + p { margin-top: 0.7rem; }
    .hp-deal__text a { color: inherit; text-underline-offset: 0.3em; }

    .hp-deal__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      margin-top: 0.6rem;
      padding: 1.3rem 2.6rem;
      border: 1.5px solid var(--hp-deal-accent);
      border-radius: var(--hp-r-pill);
      background: var(--hp-deal-accent);
      color: var(--hp-deal-accent-fg);
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      transition: transform 0.35s var(--hp-ease), box-shadow 0.35s var(--hp-ease);
    }
    .hp-deal__btn:hover { transform: translateY(-2px); box-shadow: var(--hp-shadow-btn); }
    .hp-deal__btn .hp-icon { transition: transform 0.35s var(--hp-ease); }
    .hp-deal__btn:hover .hp-icon { transform: translateX(3px); }

    .hp-deal__dismiss {
      margin-top: 0.2rem;
      padding: 0;
      border: none;
      background: none;
      color: inherit;
      font-family: inherit;
      font-size: 1.15rem;
      letter-spacing: 0.04em;
      opacity: 0.7;
      text-decoration: underline;
      text-underline-offset: 0.35em;
      cursor: pointer;
    }
    .hp-deal__dismiss:hover { opacity: 1; }

    /* ---- side-by-side once there is room ----------------------------- */
    @media screen and (min-width: 750px) {
      .hp-deal--has-media .hp-deal__panel { grid-template-columns: minmax(0, 34rem) 1fr; }
      .hp-deal--has-media.hp-deal--flip .hp-deal__media { order: 2; }
      .hp-deal__media { min-height: 100%; }
    }
    @media screen and (max-width: 749px) {
      .hp-deal__media { min-height: 0; height: 22rem; }
      .hp-deal__btn { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hp-deal__backdrop,
      .hp-deal__panel,
      .hp-deal__btn,
      .hp-deal__btn .hp-icon,
      .hp-deal__close { transition: none; }
      .hp-deal__panel { transform: none; }
      .hp-deal__btn:hover,
      .hp-deal__close:hover { transform: none; }
    }
  {%- endstyle -%}
{%- endif -%}

{%- comment -%}
  Nothing to put in the bar, nothing to draw. Once the deal moved out of this
  row it became possible to have a section whose only block is a popup — and
  the bar would still have rendered as an empty strip with a separator line
  under the header. It is skipped instead.
{%- endcomment -%}
{%- if ann_blocks.size > 0 or language_country_selector or section.settings.show_social and social_icons -%}
<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and ann_blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if ann_blocks.size == 1 -%}
      {%- assign only_ann = ann_blocks.first -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ only_ann.shopify_attributes }}
      >
        {%- if only_ann.settings.text != blank -%}
          {%- if only_ann.settings.link != blank -%}
            <a
              href="{{ only_ann.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5">
            <span>{{ only_ann.settings.text | escape }}</span>
            {%- if only_ann.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if only_ann.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif ann_blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in ann_blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{%- for block in deal_blocks -%}
  {%- liquid
    assign has_media = false
    if block.settings.image != blank or block.settings.video != blank
      assign has_media = true
    endif

    comment
      The still shown under the clip: the merchant's own image when they set
      one, otherwise the frame Shopify generated for the video. Either way the
      popup has something to show before — and if — the video arrives.
    endcomment
    assign poster = block.settings.image
    if poster == blank and block.settings.video != blank
      assign poster = block.settings.video.preview_image
    endif

    comment
      A picked video carries several encodes. Take the smallest mp4 that is at
      least 480 tall: this is a panel a third of a popup wide, never full-bleed,
      so the 1080p master is bytes the visitor cannot see. Falls back to the
      largest mp4 if every encode is smaller than that.
    endcomment
    assign video_src = ''
    if block.settings.video != blank
      assign mp4s = block.settings.video.sources | where: 'format', 'mp4' | sort: 'height'
      if mp4s.size > 0
        assign video_src = mp4s.last.url
        for source in mp4s
          if source.height >= 480
            assign video_src = source.url
            break
          endif
        endfor
      endif
    endif
  -%}

  {%- comment -%}
    `hidden` is on the element in the markup, not added by script: the popup
    must never be visible before the code that can close it has run. JS removes
    it to open. With JavaScript off the popup simply never appears, which is
    the right way for this to fail.
  {%- endcomment -%}
  <div
    class="hp-deal{% if has_media %} hp-deal--has-media{% endif %}{% if block.settings.flip %} hp-deal--flip{% endif %}"
    hidden
    data-hp-deal
    data-hp-deal-id="{{ block.id }}"
    data-frequency="{{ block.settings.frequency }}"
    data-delay="{{ block.settings.delay }}"
    style="--hp-deal-bg: {{ block.settings.bg_color }}; --hp-deal-fg: {{ block.settings.text_color }}; --hp-deal-accent: {{ block.settings.button_color }}; --hp-deal-accent-fg: {{ block.settings.button_text_color }};"
    {{ block.shopify_attributes }}
  >
    <div class="hp-deal__backdrop" data-hp-deal-close></div>

    {%- comment -%}
      tabindex="-1" so the dialog itself can take focus when it opens. Focus has
      to move into the popup — otherwise the keyboard is still out on the page
      behind it — but putting it on the close button lit that button up with the
      browser's focus ring the instant the popup appeared, which reads as "this
      is selected" to everyone, not just keyboard users. The panel takes it
      instead: screen readers announce the dialog, and the first Tab still lands
      on the close button.
    {%- endcomment -%}
    <div
      class="hp-deal__panel"
      tabindex="-1"
      role="dialog"
      aria-modal="true"
      {% if block.settings.title != blank %}aria-labelledby="HpDealTitle-{{ block.id }}"{% else %}aria-label="{{ 'sections.header.announcement' | t }}"{% endif %}
    >
      <button type="button" class="hp-deal__close" data-hp-deal-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'hp-icon', icon: 'x', size: 16 %}
      </button>

      {%- if has_media -%}
        <div class="hp-deal__media">
          {%- if poster != blank -%}
            {{
              poster
              | image_url: width: 1200
              | image_tag: widths: '340, 500, 680, 900, 1200', sizes: '(min-width: 750px) 34rem, 100vw', loading: 'lazy', alt: ''
            }}
          {%- endif -%}
          {%- if video_src != blank -%}
            {%- comment -%}
              No src and preload="none": initLazyPreviewVideos fills it in, so
              the clip is a cost paid by the popup rather than by every page
              load whether or not the popup is due to show.
            {%- endcomment -%}
            <video
              class="hp-deal__video"
              data-hp-lazy-video
              data-hp-lazy-autoplay
              data-src="{{ video_src }}"
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              tabindex="-1"
            ></video>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hp-deal__body">
        {%- if block.settings.eyebrow != blank -%}
          <p class="hp-deal__eyebrow">{{ block.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <p class="hp-deal__title" id="HpDealTitle-{{ block.id }}">{{ block.settings.title | escape }}</p>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="hp-deal__text">{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <a
            class="hp-deal__btn"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{ block.settings.button_label | escape }}
            {% render 'hp-icon', icon: 'arrow-right', size: 14 %}
          </a>
        {%- endif -%}
        {%- if block.settings.dismiss_label != blank -%}
          <button type="button" class="hp-deal__dismiss" data-hp-deal-close>
            {{ block.settings.dismiss_label | escape }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endfor -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    },
    {
      "type": "deal",
      "name": "Sale / deal popup",
      "settings": [
        {
          "type": "paragraph",
          "content": "A sale or offer shown as a popup over the page. It does not appear in the bar itself. To take it down after a sale, hide the block with the eye icon — the settings stay for next time."
        },
        { "type": "header", "content": "Content" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small line above the title, e.g. \"Limited time\"." },
        { "type": "text", "id": "title", "label": "Title", "default": "Winter Sale — 20% off" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>On every dinner set until the 30th. Discount applied at checkout.</p>"
        },
