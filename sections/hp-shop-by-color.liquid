{% comment %}
  THP — Shop by Colour (interactive).

  Clicking a swatch loads that colour's products in place, without a page
  reload: the section re-renders itself through Shopify's Section Rendering
  API and the grid cross-fades.

  Each swatch queries Shopify's product search for its colour name. Search
  indexes titles AND tags, which is the point: a product called "Selin Tea Set -
  Teal" is found today with no tagging done, and a product tagged `teal` is
  found whether or not its name says so. One mechanism, and the catalogue-wide
  matching is done by Shopify rather than scanned in Liquid (Liquid can only see
  the first 50 products of a collection, so template-side filtering would
  silently drop products as the catalogue grows).

  Search on its own is too loose to trust, so every result is re-checked against
  this section's colour list before it is drawn — see the results grid below.

  Tags remain the reliable long-term answer, because a product whose name does
  not mention its colour can only ever be found by tag. Tags are store data, not
  theme data, so they are added in the Shopify admin.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Add-to-cart needs Dawn's quick-add bundle. These load on the first render and
  stay loaded, so the cards injected later by the swatch fetch light up too —
  custom elements upgrade themselves whenever new matching nodes appear, so the
  re-rendered results do not need their own copy of the scripts.
{%- endcomment -%}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- liquid
  # These used to be one setting: "products per colour" also decided how many
  # grid columns to draw. That capped the shelf at 6 products purely because 7
  # columns would look wrong — the two are now separate so a colour can show
  # everything it has in a sensible 4-up grid.
  assign per_row = section.settings.columns | default: 4
  assign show_limit = section.settings.products_to_show | default: 12
  assign last_index = section.blocks.size | minus: 1
  assign requested = section.settings.default_index | default: 1 | minus: 1
  if requested > last_index
    assign requested = 0
  endif
-%}

{%- style -%}
  .hp-colors { background: {{ section.settings.bg_color | default: '#fffdf4' }}; }
  .hp-colors__row {
    display: flex;
    gap: clamp(1.4rem, 2.6vw, 2.8rem);
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    /* Setting overflow-x here makes the browser auto-compute overflow-y as
       clipping too (CSS Overflow spec), so the swatch's hover/active lift
       (translateY + scale) and its glow were being cut off at the row's own
       top edge. Generous top padding keeps that transform fully in view. */
    padding: 2rem 0.2rem 1.4rem;
    scroll-snap-type: x proximity;
    /* mobile only (the >=990px query below resets all of this to 0/visible):
       the row bleeds a flat --hp-gap-x so the scrollable/touch area still
       reaches the viewport edge, but the content padding adds an EXTRA
       1rem on top of that instead of exactly cancelling it out — a plain
       circular swatch with no card framing around it reads as flush against
       the edge at the same numeric inset a bordered tile would use, so it
       needs a bit more room than gap-x alone gives it. */
    margin: -1.4rem calc(var(--hp-gap-x) * -1) 0;
    padding-left: calc(var(--hp-gap-x) + 1rem);
    padding-right: calc(var(--hp-gap-x) + 1rem);
  }
  .hp-colors__row::-webkit-scrollbar { display: none; }
  @media screen and (min-width: 990px) {
    .hp-colors__row { justify-content: center; flex-wrap: wrap; overflow: visible; margin: 0; padding-left: 0; padding-right: 0; }
  }
  .hp-colors__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--hp-ink);
    flex: 0 0 auto;
    scroll-snap-align: start;
    text-align: center;
    font: inherit;
  }
  .hp-colors__dot {
    position: relative;
    width: clamp(6.4rem, 8vw, 8.8rem);
    height: clamp(6.4rem, 8vw, 8.8rem);
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--hp-hairline);
    box-shadow: inset 0 0 0 4px var(--hp-cream-soft);
    transition: transform 0.4s var(--hp-ease), box-shadow 0.4s var(--hp-ease);
  }
  .hp-colors__dot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hp-colors__item:hover .hp-colors__dot { transform: translateY(-6px) scale(1.05); }
  .hp-colors__item.is-active .hp-colors__dot {
    transform: translateY(-6px) scale(1.06);
    box-shadow: inset 0 0 0 4px var(--hp-cream-soft), 0 0 0 2px var(--hp-teal),
      0 18px 30px -18px rgba(18, 53, 54, 0.5);
  }
  .hp-colors__item:focus-visible .hp-colors__dot { outline: 2px solid var(--hp-teal); outline-offset: 4px; }
  /* Label stack. Both of these were inline <span>s with margin:0, so the name
     and the count ran together on one line as "Sea Green8 VARIETIES" — the
     styling assumed block layout the elements never had. Making the wrapper a
     column flex container fixes the layout regardless of which parts show. */
  .hp-colors__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .hp-colors__name {
    display: block;
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.002em;
  }
  .hp-colors__count {
    display: block;
    margin: 0;
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-taupe);
  }

  /* results */
  .hp-colors__results-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.2rem 0 2rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--hp-hairline-teal);
  }
  .hp-colors__results-title {
    margin: 0;
    font-family: var(--hp-font-display);
    /* Shared block tier + shared heading colour, so the selected colour's title
       matches every other in-section heading rather than carrying its own size
       and the old synthesised 600 weight. */
    font-weight: 400;
    font-size: var(--hp-h-block);
    color: var(--hp-heading);
  }
  .hp-colors__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    transition: opacity 0.22s ease;
  }
  @media screen and (min-width: 750px) {
    .hp-colors__grid { grid-template-columns: repeat({{ per_row }}, minmax(0, 1fr)); gap: 1.8rem; }
  }
  hp-colour-shop.is-loading .hp-colors__grid { opacity: 0.35; }
  .hp-colors__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1rem;
    color: var(--hp-taupe);
    font-size: 1.4rem;
  }
{%- endstyle -%}

<div class="hp-colors hp-section">
  <div class="hp-container">
    <div class="hp-section-head hp-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--rule-after">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <hp-colour-shop data-section-id="{{ section.id }}">
      <div class="hp-colors__row" role="group" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            # Each swatch points at Shopify's own product search for its colour
            # name. Search indexes titles AND tags, so an untagged product whose
            # name contains the colour is found today, and a tagged one is found
            # once tags exist — one mechanism covering both, with the matching
            # done by Shopify rather than scanned in Liquid.
            assign target = routes.search_url | append: '?q=' | append: block.settings.title | url_encode | append: '&type=product'
            assign count = null
          -%}
          <button
            type="button"
            class="hp-colors__item{% if forloop.index0 == requested %} is-active{% endif %}"
            data-hp-colour
            data-hp-url="{{ target }}"
            data-hp-label="{{ block.settings.title | escape }}"
            aria-pressed="{% if forloop.index0 == requested %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="hp-colors__dot" style="background: {{ block.settings.swatch }};">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- endif -%}
            </span>
            <span class="hp-colors__label">
              <span class="hp-colors__name">{{ block.settings.title | escape }}</span>
              {%- if count and section.settings.show_count -%}
                <span class="hp-colors__count">{{ count }} {{ section.settings.count_label | default: 'varieties' | escape }}</span>
              {%- endif -%}
            </span>
          </button>
        {%- endfor -%}
      </div>

      <div class="hp-colors__results-head">
        <h3 class="hp-colors__results-title" data-hp-colour-title>
          {{- section.blocks[requested].settings.title | escape -}}
        </h3>
        <a class="hp-link" data-hp-colour-link href="#" hidden>
          {{ section.settings.view_all_label | default: 'View all' | escape }}
          {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
        </a>
      </div>

      {%- comment -%}
        When Shopify re-renders this section for a /search URL, `search` is
        populated — that is what fills the grid on each swatch click.

        Search alone is too loose to trust: querying "Aqua" also returns
        Aqua-grey pieces, and a colour word in a description would pull in
        something unrelated. So every result is re-checked below against this
        section's own colour list, and only exact belongers are drawn.
      {%- endcomment -%}
      {%- liquid
        assign active = ''
        if search.performed and search.terms != blank
          assign active = search.terms | downcase | strip
        endif
        assign shown = 0
      -%}
      <div class="hp-colors__grid" data-hp-colour-results data-hp-stagger>
        {%- if search.performed -%}
          {%- capture hp_cards -%}
            {%- comment -%}
              paginate by 50 so the filter below has the full first page of
              results to work through. Unpaginated, search.results hands back a
              short default page, and since these results are then narrowed to
              one exact colour, a short page can filter down to nothing.
            {%- endcomment -%}
            {%- paginate search.results by 50 -%}
            {%- for product in search.results -%}
              {%- if shown >= show_limit -%}{%- break -%}{%- endif -%}
              {%- liquid
                assign ptitle = product.title | downcase
                assign chosen = ''

                # An explicit colour tag always wins. This is the path every
                # product should end up on, and the only one that stays correct
                # for a product whose name does not mention its colour.
                for b in section.blocks
                  assign btag = b.settings.tag | default: b.settings.title | handleize
                  if product.tags contains btag or product.tags contains b.settings.title
                    assign chosen = b.settings.title | downcase
                  endif
                endfor

                # Otherwise infer it from the title, keeping the LONGEST colour
                # name that fits. Length is what makes this safe: "Aqua-grey"
                # contains "Aqua", and "Reactive Cloud Grey" contains neither
                # cleanly, so a first-match rule would file both under the wrong
                # swatch. Longest-wins always picks the most specific colour.
                if chosen == blank
                  assign best = ''
                  for b in section.blocks
                    assign bt = b.settings.title | downcase
                    if ptitle contains bt
                      assign btl = bt | size
                      assign bestl = best | size
                      if btl > bestl
                        assign best = bt
                      endif
                    endif
                  endfor
                  assign chosen = best
                endif
              -%}
              {%- if chosen != blank and chosen == active -%}
                {%- assign shown = shown | plus: 1 -%}
                <div data-hp-reveal>
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'portrait',
                    show_secondary_image: true,
                    show_rating: true,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- endpaginate -%}
          {%- endcapture -%}

          {%- if shown > 0 -%}
            {{ hp_cards }}
          {%- else -%}
            <p class="hp-colors__empty">Nothing in this shade just yet — try another colour.</p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </hp-colour-shop>
  </div>
</div>

{% schema %}
{
  "name": "THP Shop by Colour",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Palette" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Colour" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick a glaze — the collection below updates instantly." },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 2,
      "label": "Products per colour",
      "default": 12,
      "info": "How many products a colour shows before it stops. Raise it if a colour has more pieces than fit."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "default_index",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Colour selected on load",
      "default": 1
    },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#fffdf4" },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Add-to-cart button",
      "default": "standard",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ]
    },
    { "type": "checkbox", "id": "show_count", "label": "Show live product counts", "default": false },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "varieties" }
  ],
  "blocks": [
    {
      "type": "colour",
      "name": "Colour",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Sea Green" },
        { "type": "color", "id": "swatch", "label": "Swatch colour", "default": "#3f7269" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Texture photo (optional)",
          "info": "Shown inside the dot instead of the flat colour."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "info": "The tag used on products of this colour, e.g. 'sage-green'. Products whose name already contains the colour are matched without it, but tagging is what makes a colour reliable for products that are not named after it."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Shop by Colour",
      "blocks": [
        { "type": "colour" },
        { "type": "colour", "settings": { "title": "Cloud Grey", "swatch": "#b8bdba" } },
        { "type": "colour", "settings": { "title": "Cobalt", "swatch": "#2b4a76" } },
        { "type": "colour", "settings": { "title": "Terracotta", "swatch": "#b06a4a" } },
        { "type": "colour", "settings": { "title": "Ivory", "swatch": "#f2ead8" } },
        { "type": "colour", "settings": { "title": "Charcoal", "swatch": "#3a3a38" } }
      ]
    }
  ]
}
{% endschema %}
