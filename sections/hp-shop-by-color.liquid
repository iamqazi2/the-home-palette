{% comment %}
  THP — Shop by Colour (interactive).

  Every colour's products are rendered up front and the swatches show and hide
  them. There is no fetch, so switching colour is instant.

  Earlier versions asked the Section Rendering API for this section at a
  /collections or /search URL. That cannot work: the API resolves the section id
  against the template of the URL being requested, and this section only exists
  in index.json — so those requests never returned the section and the grid was
  always empty.

  Matching, in order:

  1. If the product has a colour OPTION (a "Color"/"Colour"/"Shade"/"Glaze"
     option), only its variants decide where it appears. The Hand-Painted Handi
     sells in nine colours from one product, so it belongs in nine groups — each
     showing that colour's own variant image, not the product's cover shot.
     Such a product is deliberately NOT matched by tag or title: doing both is
     what put one-colour-per-card products into colours they do not come in.
  2. Otherwise by colour tag, which is the only thing that can be right for a
     product whose name does not mention its colour.
  3. Otherwise by title, excluding any longer colour name that contains the
     shorter one so Aqua-grey pieces never fall under Aqua.

  A variant colour matches a swatch only on an exact name (or alias) — no
  partial matching, because "Aqua" and "Aqua-grey" are different glazes and a
  contains-check cannot tell which way round it should go.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Add-to-cart needs Dawn's quick-add bundle. Every card is present from the
  first render now, so these simply load once and cover all of them.
{%- endcomment -%}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- liquid
  # These used to be one setting: "products per colour" also decided how many
  # grid columns to draw. That capped the shelf at 6 products purely because 7
  # columns would look wrong — the two are now separate so a colour can show
  # everything it has in a sensible 4-up grid.
  assign per_row = section.settings.columns | default: 4
  assign show_limit = section.settings.products_to_show | default: 12

  # Slider or grid. On the home page this section is one band among many and a
  # sideways-scrolling shelf is right; on its own page it IS the page, and a
  # shelf that hides most of a colour behind a scroll is not. 'auto' reads the
  # template so both get the correct one with nothing to configure, and the
  # explicit options are there to override it per placement.
  assign layout = section.settings.layout | default: 'auto'
  if layout == 'auto'
    if template.name == 'index'
      assign layout = 'slider'
    else
      assign layout = 'grid'
    endif
  endif
  assign last_index = section.blocks.size | minus: 1
  assign requested = section.settings.default_index | default: 1 | minus: 1
  if requested > last_index
    assign requested = 0
  endif
-%}

{%- style -%}
  .hp-colors { background: {{ section.settings.bg_color | default: '#fffdf4' }}; }
  .hp-colors__row {
    display: flex;
    gap: clamp(1.4rem, 2.6vw, 2.8rem);
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    /* Setting overflow-x here makes the browser auto-compute overflow-y as
       clipping too (CSS Overflow spec), so the swatch's hover/active lift
       (translateY + scale) and its glow were being cut off at the row's own
       top edge. Generous top padding keeps that transform fully in view. */
    padding: 2rem 0.2rem 1.4rem;
    scroll-snap-type: x proximity;
    /* mobile only (the >=990px query below resets all of this to 0/visible):
       the row bleeds a flat --hp-gap-x so the scrollable/touch area still
       reaches the viewport edge, but the content padding adds an EXTRA
       1rem on top of that instead of exactly cancelling it out — a plain
       circular swatch with no card framing around it reads as flush against
       the edge at the same numeric inset a bordered tile would use, so it
       needs a bit more room than gap-x alone gives it. */
    /* Sits inside the container's own padding rather than bleeding past it.
       The bleed let the first swatch's label run under the viewport edge, where
       a horizontal scroller clips it and it cannot be scrolled back into view. */
    margin: -1.4rem 0 0;
    padding-left: 1.2rem;
    padding-right: 1.2rem;
  }
  .hp-colors__row::-webkit-scrollbar { display: none; }
  @media screen and (min-width: 990px) {
    .hp-colors__row { justify-content: center; flex-wrap: wrap; overflow: visible; margin: 0; padding-left: 0; padding-right: 0; }
  }
  .hp-colors__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--hp-ink);
    flex: 0 0 auto;
    scroll-snap-align: start;
    text-align: center;
    font: inherit;
  }
  .hp-colors__dot {
    position: relative;
    width: clamp(6.4rem, 8vw, 8.8rem);
    height: clamp(6.4rem, 8vw, 8.8rem);
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--hp-hairline);
    box-shadow: inset 0 0 0 4px var(--hp-cream-soft);
    transition: transform 0.4s var(--hp-ease), box-shadow 0.4s var(--hp-ease);
  }
  .hp-colors__dot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hp-colors__item:hover .hp-colors__dot { transform: translateY(-6px) scale(1.05); }
  .hp-colors__item.is-active .hp-colors__dot {
    transform: translateY(-6px) scale(1.06);
    box-shadow: inset 0 0 0 4px var(--hp-cream-soft), 0 0 0 2px var(--hp-teal),
      0 18px 30px -18px rgba(16, 48, 44, 0.5);
  }
  .hp-colors__item:focus-visible .hp-colors__dot { outline: 2px solid var(--hp-teal); outline-offset: 4px; }
  /* Label stack. Both of these were inline <span>s with margin:0, so the name
     and the count ran together on one line as "Sea Green8 VARIETIES" — the
     styling assumed block layout the elements never had. Making the wrapper a
     column flex container fixes the layout regardless of which parts show. */
  .hp-colors__label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .hp-colors__name {
    display: block;
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.002em;
  }
  .hp-colors__count {
    display: block;
    margin: 0;
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-taupe);
  }

  /* results */
  .hp-colors__results-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.2rem 0 2rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--hp-hairline-teal);
  }
  .hp-colors__results-title {
    margin: 0;
    font-family: var(--hp-font-display);
    /* Shared block tier + shared heading colour, so the selected colour's title
       matches every other in-section heading rather than carrying its own size
       and the old synthesised 600 weight. */
    font-weight: 400;
    font-size: var(--hp-h-block);
    color: var(--hp-heading);
  }
  /* A row that scrolls sideways instead of wrapping. Card widths come from a
     per-view count that is deliberately fractional on small screens, so part of
     the next card always shows — that peek is the only cue that the row scrolls,
     since the scrollbar is hidden. */
  .hp-colors__grid {
    display: flex;
    gap: var(--hp-sbc-gap);
    margin: 0;
    padding: 0 0 0.6rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .hp-colors__grid::-webkit-scrollbar { display: none; }
  /* The `hidden` attribute alone would NOT hide these: the browser's own
     [hidden] { display: none } is a UA-stylesheet rule, so the author-level
     `display: flex` above beats it and all fourteen colours would paint stacked
     on top of each other. This restores it at author level. */
  .hp-colors__grid[hidden] { display: none; }
  .hp-colors__cell {
    flex: 0 0 var(--hp-sbc-item);
    width: var(--hp-sbc-item);
    max-width: var(--hp-sbc-item);
    min-width: 0;
    scroll-snap-align: start;
  }
  .hp-colors {
    --hp-sbc-gap: 1.2rem;
    --hp-sbc-item: calc((100% - (var(--hp-sbc-gap) * 1.2)) / 2.2);
  }
  @media screen and (min-width: 750px) {
    .hp-colors {
      --hp-sbc-gap: 1.6rem;
      --hp-sbc-item: calc((100% - (var(--hp-sbc-gap) * 2.2)) / 3.2);
    }
  }
  @media screen and (min-width: 990px) {
    .hp-colors {
      --hp-sbc-gap: 1.8rem;
      --hp-sbc-item: calc((100% - (var(--hp-sbc-gap) * {{ per_row | minus: 1 }})) / {{ per_row }});
    }
  }
  /* ---- grid layout ----
     Same cards, laid out rather than railed: every product for the selected
     colour on screen at once, no sideways scrolling. */
  .hp-colors--grid .hp-colors__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hp-sbc-gap);
    overflow: visible;
    scroll-snap-type: none;
    padding-bottom: 0;
  }
  /* Restated for the grid, and it must be: the browser's own
     [hidden] { display: none } is a UA rule, and `.hp-colors--grid
     .hp-colors__grid` outranks it — without this line all twenty-one colours
     would paint stacked on top of each other. Same trap as the flex rule
     above, one specificity step higher. */
  .hp-colors--grid .hp-colors__grid[hidden] { display: none; }
  .hp-colors--grid .hp-colors__cell {
    flex: initial;
    width: auto;
    max-width: none;
    scroll-snap-align: none;
  }
  .hp-colors--grid .hp-colors__empty { grid-column: 1 / -1; }
  @media screen and (min-width: 750px) {
    .hp-colors--grid .hp-colors__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media screen and (min-width: 990px) {
    .hp-colors--grid .hp-colors__grid { grid-template-columns: repeat({{ per_row }}, minmax(0, 1fr)); }
  }

  hp-colour-shop.is-loading .hp-colors__grid { opacity: 0.35; }
  /* Which glaze this card is showing — the cards sit in a grid of nine
     near-identical handis otherwise. */
  .hp-colour-card__chip {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 2;
    padding: 0.5rem 1.1rem;
    border-radius: var(--hp-r-pill);
    background: rgba(255, 249, 223, 0.94);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-teal);
    pointer-events: none;
  }

  .hp-colors__empty {
    flex: 1 1 100%;
    text-align: center;
    padding: 3rem 1rem;
    color: var(--hp-taupe);
    font-size: 1.4rem;
  }
{%- endstyle -%}

<div class="hp-colors hp-section{% if layout == 'grid' %} hp-colors--grid{% endif %}" id="hp-colours">
  <div class="hp-container">
    <div class="hp-section-head hp-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow hp-eyebrow--rule-after">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <hp-colour-shop data-section-id="{{ section.id }}">
      <div class="hp-colors__row" role="group" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            # Where "View all" goes, in order of preference.
            #
            # It used to always be /search?q=<colour>, and that is the bug: the
            # store's search matches a product's DESCRIPTION as well as its
            # title and tags, so "Copper" returned the Mughal Serving Platter
            # and the Royal Mandi Platter — neither of which is copper — mixed
            # in with the real ones. There is also no colour tag on these
            # products to filter a collection by (checked: their tags are
            # things like "serveware" and "dining"), so a /collections/all/
            # <tag> URL would come back empty.
            #
            # The only thing that knows which products are actually this colour
            # is this section's own matching logic. So the link points back at
            # this same section on its own page, deep-linked to the colour —
            # the destination re-runs the identical matching and therefore
            # shows exactly the set the swatch showed, never more.
            assign colour_key = block.settings.title | handleize
            if block.settings.view_all_url != blank
              assign target = block.settings.view_all_url
            elsif section.settings.view_all_page != blank
              # The #hp-colours fragment lands the visitor on the palette
              # rather than at the top of the page above it.
              assign target = section.settings.view_all_page.url | append: '?colour=' | append: colour_key | append: '#hp-colours'
            elsif layout == 'grid'
              # Already on a page showing every product for the colour. Linking
              # to a fuzzy search from here would be a step backwards, so there
              # is no link at all — the JS hides it when this is empty.
              assign target = ''
            else
              # Last resort, and still the loose one: no destination page has
              # been chosen in the section settings. Kept so the link is never
              # dead, but pick a page in "View all goes to" and this is not used.
              assign colour_query = block.settings.title | url_encode
              assign target = routes.search_url | append: '?q=' | append: colour_query | append: '&type=product'
            endif
            assign count = null
          -%}
          <button
            type="button"
            class="hp-colors__item{% if forloop.index0 == requested %} is-active{% endif %}"
            data-hp-colour
            data-hp-colour-key="{{ colour_key }}"
            data-hp-url="{{ target }}"
            data-hp-label="{{ block.settings.title | escape }}"
            aria-pressed="{% if forloop.index0 == requested %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="hp-colors__dot" style="background: {{ block.settings.swatch }};">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- endif -%}
            </span>
            <span class="hp-colors__label">
              <span class="hp-colors__name">{{ block.settings.title | escape }}</span>
              {%- if count and section.settings.show_count -%}
                <span class="hp-colors__count">{{ count }} {{ section.settings.count_label | default: 'varieties' | escape }}</span>
              {%- endif -%}
            </span>
          </button>
        {%- endfor -%}
      </div>

      <div class="hp-colors__results-head">
        <h3 class="hp-colors__results-title" data-hp-colour-title>
          {{- section.blocks[requested].settings.title | escape -}}
        </h3>
        <a class="hp-link" data-hp-colour-link href="#" hidden>
          {{ section.settings.view_all_label | default: 'View all' | escape }}
          {% render 'hp-icon', icon: 'arrow-right', size: 15 %}
        </a>
      </div>

      {%- comment -%}
        Every colour's products are rendered here, up front, and the swatches
        just show/hide them. There is no fetch.

        The previous versions asked the Section Rendering API for this section at
        a /collections or /search URL, which cannot work: that API resolves the
        section id against the template of the URL being requested, and this
        section only exists in index.json. Every one of those requests came back
        without the section, which is why the grid was always empty.

        Rendering up front costs nothing extra in practice — a product belongs to
        exactly one colour, so the total number of cards here is the number of
        matched products, not colours x limit. Hidden groups use the `hidden`
        attribute, so their lazy images are never downloaded until shown.
      {%- endcomment -%}
      {%- comment -%}
        Note the absence of reveal attributes below, and the no-anim flag.

        Those attributes are what made the products flash up and then vanish:
        the stylesheet zeroes the opacity of any reveal element as soon as GSAP
        boots, and the ScrollTrigger meant to bring them back measures every card
        at once — including the thirteen colours that are hidden and therefore
        have no position — so the triggers for the visible group never resolve
        and the cards stay invisible. Swapping colours is animated directly in
        hp-theme.js instead, which is also the only thing that can animate a
        group that was hidden when the page loaded.
      {%- endcomment -%}
      <div class="hp-colors__results" data-hp-colour-results data-hp-no-anim>
        {%- for block in section.blocks -%}
          {%- liquid
            assign cname = block.settings.title | downcase
            assign ctag = block.settings.tag | default: block.settings.title | handleize
            assign gid = block.settings.title | handleize

            # A swatch's display name is not always what the products are called.
            # "Limone Yellow" on the palette is "Limone Gardenia" on the shelf,
            # and matching on the display name alone found nothing at all for
            # three of the fourteen colours. Aliases let the swatch keep its
            # palette name while still matching the names products actually use.
            assign match_names = block.settings.title
            if block.settings.aliases != blank
              assign match_names = match_names | append: ',' | append: block.settings.aliases
            endif
            assign name_list = match_names | downcase | split: ','

            # Colour names that CONTAIN this one, e.g. "Aqua-grey" contains
            # "Aqua". Without this, every Aqua-grey piece would also be filed
            # under Aqua. Built once per colour rather than once per product.
            assign rivals = ''
            for other in section.blocks
              assign oname = other.settings.title | downcase
              if oname != cname and oname contains cname
                assign ohandle = other.settings.title | handleize
                assign rivals = rivals | append: ohandle | append: '||'
              endif
            endfor
            assign rival_list = rivals | split: '||'
          -%}
          {%- comment -%}
            Every colour but the one on screen is wrapped in <template>.

            The markup itself is unchanged and still arrives in the same
            response, so switching colours is still instant and still needs no
            network — that property was the whole point of rendering them all
            up front and it is kept. What changes is what the browser DOES with
            twenty colours' worth of product cards it is not showing: inside a
            <template> they are inert. No elements in the document, so nothing
            to style, lay out, or paint; no <img> to queue; no custom elements
            to upgrade. Measured on the home page, this is the difference
            between 11,300 DOM nodes and roughly 2,000 — the single largest
            cost on the page, and one paid on every visit for content most
            visitors never open.

            The first click on a colour lifts its cards out of the template
            into the document, once; from then on it behaves exactly as before.
          {%- endcomment -%}
          {%- unless forloop.index0 == requested -%}
            <template data-hp-colour-defer="{{ gid }}">
          {%- endunless -%}
          <div
            class="hp-colors__grid"
            data-hp-colour-group="{{ gid }}"
            {% unless forloop.index0 == requested %}hidden{% endunless %}
          >
            {%- liquid
              assign seen = ','
              assign shown = 0
            -%}
            {%- comment -%}
              Scanning the store's own collections rather than one "all" list:
              Liquid only ever hands back the first 50 products of any single
              collection, so walking each collection covers far more of the
              catalogue than one capped list would. Products sitting in two
              collections are de-duplicated by id below.
            {%- endcomment -%}
            {%- for col in collections -%}
              {%- for product in col.products -%}
                {%- if shown >= show_limit -%}{%- break -%}{%- endif -%}
                {%- liquid
                  assign pid = product.id | append: ',' | prepend: ','
                  assign ok = false
                  assign colour_variant = null

                  unless seen contains pid
                    # Does this product carry its colours as an option?
                    assign colour_pos = 0
                    assign colour_values = ''
                    for opt in product.options_with_values
                      assign oname = opt.name | downcase | strip
                      if oname == 'color' or oname == 'colour' or oname == 'shade' or oname == 'glaze'
                        assign colour_pos = forloop.index
                        # Handleized so "Matte black", "matte-black" and
                        # "Matte  Black" all compare equal, and wrapped in
                        # separators so the probe below is exact.
                        assign colour_values = '~'
                        for val in opt.values
                          assign vh = val | handleize
                          assign colour_values = colour_values | append: vh | append: '~'
                        endfor
                        break
                      endif
                    endfor

                    if colour_pos > 0
                      # Variant-coloured: the option decides, and nothing else.
                      #
                      # The option's value list is checked before any variant is
                      # touched. Walking every variant of every product for all
                      # fourteen swatches is tens of thousands of iterations and
                      # would blow Liquid's render budget; this settles most
                      # products with one string comparison. Values are joined
                      # and probed wrapped in separators so the test is exact —
                      # a plain `contains` would file every Aqua-grey piece
                      # under Aqua as well.
                      assign matched_colour = ''
                      for nm in name_list
                        assign nm_handle = nm | handleize
                        if nm_handle == blank
                          continue
                        endif
                        assign needle = '~' | append: nm_handle | append: '~'
                        if colour_values contains needle
                          assign matched_colour = nm_handle
                          break
                        endif
                      endfor

                      if matched_colour != blank
                        assign colour_idx = colour_pos | minus: 1
                        for variant in product.variants
                          assign vcolour = variant.options[colour_idx] | handleize
                          if vcolour == matched_colour
                            assign ok = true
                            assign colour_variant = variant
                            break
                          endif
                        endfor
                      endif
                    else
                      # An explicit colour tag always wins — it is the only thing
                      # that can be right for a product not named after its colour.
                      if product.tags contains ctag or product.tags contains block.settings.title
                        assign ok = true
                      else
                        # Handleized and wrapped in dashes, so a title written
                        # "Aqua - Grey Day to Dine Set" reads as "aqua-grey" and
                        # is caught by the rival guard below. Comparing raw text
                        # missed it — the spaces around the dash meant the title
                        # never literally contained "aqua-grey", so the set was
                        # filed under Aqua and Aqua-grey stayed empty.
                        assign ptitle = product.title | handleize
                        assign phandle = '-' | append: ptitle | append: '-'
                        for nm in name_list
                          assign nm_handle = nm | handleize
                          if nm_handle == blank
                            continue
                          endif
                          assign needle = '-' | append: nm_handle | append: '-'
                          if phandle contains needle
                            assign ok = true
                            break
                          endif
                        endfor
                        # A longer colour name that contains this one still wins,
                        # so Aqua-grey pieces never fall under Aqua.
                        if ok
                          for rival in rival_list
                            if rival == blank
                              continue
                            endif
                            assign rneedle = '-' | append: rival | append: '-'
                            if phandle contains rneedle
                              assign ok = false
                              break
                            endif
                          endfor
                        endif
                      endif
                    endif
                  endunless
                -%}
                {%- if ok -%}
                  {%- liquid
                    assign seen = seen | append: product.id | append: ','
                    assign shown = shown | plus: 1
                  -%}
                  <div class="hp-colors__cell">
                    {%- if colour_variant -%}
                      {% render 'hp-colour-card',
                        product: product,
                        variant: colour_variant,
                        colour_label: block.settings.title,
                        quick_add: section.settings.quick_add,
                        section_id: section.id
                      %}
                    {%- else -%}
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: 'portrait',
                        show_secondary_image: true,
                        show_rating: true,
                        quick_add: section.settings.quick_add,
                        lazy_load: true,
                        section_id: section.id
                      %}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}

            {%- if shown == 0 -%}
              <p class="hp-colors__empty">Nothing in this shade just yet — try another colour.</p>
            {%- endif -%}
          </div>
          {%- unless forloop.index0 == requested -%}
            </template>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </hp-colour-shop>
  </div>
</div>

{% schema %}
{
  "name": "THP Shop by Colour",
  "tag": "section",
