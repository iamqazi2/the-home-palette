{% comment %} THP — Editorial mixed-size collection tile grid {% endcomment %}

{%- style -%}
  .hp-cats { background: var(--hp-paper); }
  .hp-cats__grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 24rem;
  }
  @media screen and (min-width: 990px) {
    .hp-cats__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 26rem;
    }
    .hp-cats__tile:nth-child(6n + 1) { grid-column: span 2; grid-row: span 2; }
    .hp-cats__tile:nth-child(6n + 4) { grid-column: span 2; }
  }
  .hp-cats__tile {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--hp-linen);
    text-decoration: none;
  }
  .hp-cats__tile img,
  .hp-cats__tile .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.3s var(--hp-ease);
  }
  .hp-cats__tile:hover img { transform: scale(1.05); }
  .hp-cats__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14, 6, 6, 0.62), rgba(14, 6, 6, 0.05) 55%);
  }
  .hp-cats__tile-inner {
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    padding: 2.4rem;
    color: var(--hp-cream);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .hp-cats__name {
    margin: 0;
    font-family: var(--hp-font-display);
    font-size: clamp(2rem, 2.6vw, 2.8rem);
    font-weight: 500;
    line-height: 1.1;
  }
  .hp-cats__count {
    margin: 0.6rem 0 0;
    font-size: 1.05rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(239, 236, 236, 0.8);
  }
  .hp-cats__arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid rgba(255, 249, 223, 0.45);
    border-radius: 50%;
    transition: background 0.3s ease, color 0.3s ease, transform 0.35s var(--hp-ease);
  }
  .hp-cats__tile:hover .hp-cats__arrow {
    background: var(--hp-cream);
    color: var(--hp-ink);
    transform: translateX(3px);
  }
{%- endstyle -%}

<div class="hp-cats hp-section">
  <div class="hp-container">
    <div class="hp-section-head{% if section.settings.center_head %} hp-section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow{% if section.settings.center_head %} hp-eyebrow--rule-after{% endif %}" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text" data-hp-reveal>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-cats__grid" data-hp-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign tile_image = block.settings.image | default: col.featured_image
          assign tile_title = block.settings.title | default: col.title
        -%}
        <a
          class="hp-cats__tile"
          {% if col != blank %}href="{{ col.url }}"{% else %}role="link" aria-disabled="true"{% endif %}
          data-hp-reveal
          {{ block.shopify_attributes }}
        >
          {%- if tile_image -%}
            {{
              tile_image
              | image_url: width: 1400
              | image_tag: widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: tile_title
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="hp-cats__tile-inner">
            <div>
              <h3 class="hp-cats__name">{{ tile_title | default: 'Collection' }}</h3>
              {%- if col != blank and section.settings.show_count -%}
                <p class="hp-cats__count">{{ col.all_products_count }} pieces</p>
              {%- endif -%}
            </div>
            <span class="hp-cats__arrow">{% render 'hp-icon', icon: 'arrow-right', size: 16 %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Collection Tiles",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter One — The Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every Table Tells a Story" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "center_head", "label": "Center heading", "default": false },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Collection Tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
