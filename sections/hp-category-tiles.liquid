{% comment %} THP — v3 collection tiles: uniform 4:5 rounded tiles, teal gradient, live counts {% endcomment %}

{%- style -%}
  .hp-cats { background: {{ section.settings.bg_color | default: '#fffdf4' }}; }
  .hp-cats__grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media screen and (min-width: 750px) {
    .hp-cats__grid { grid-template-columns: repeat(3, 1fr); gap: 1.8rem; }
  }
  @media screen and (min-width: 1200px) {
    .hp-cats__grid { grid-template-columns: repeat({{ section.settings.columns }}, 1fr); }
  }
  .hp-cats__tile { aspect-ratio: 4 / 5; }
  /* Legibility: the label sits on a deep, tall gradient so it reads over any
     photo — light jute, pale ceramics or busy flatlays alike. */
  .hp-cats__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(16, 48, 44, 0) 30%,
      rgba(16, 48, 44, {{ section.settings.scrim | default: 92 | times: 0.6 | divided_by: 100.0 }}) 62%,
      rgba(10, 35, 32, {{ section.settings.scrim | default: 92 | divided_by: 100.0 }}) 100%
    );
  }
  .hp-cats__tile-inner {
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    padding: 1.6rem 1.6rem 1.5rem;
    color: var(--hp-cream);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .hp-cats__name {
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 2vw, 2.3rem);
    line-height: 1.1;
    color: #fff9df;
    text-shadow: 0 2px 12px rgba(10, 35, 32, 0.75);
  }
  .hp-cats__count {
    margin: 0.4rem 0 0;
    font-family: var(--hp-font-ui);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 249, 223, 0.92);
    text-shadow: 0 1px 8px rgba(10, 35, 32, 0.8);
  }
  .hp-cats__arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    border: 1.5px solid rgba(255, 249, 223, 0.5);
    border-radius: 50%;
    transition: background 0.3s ease, color 0.3s ease, transform 0.35s var(--hp-ease);
  }
  .hp-cats__tile:hover .hp-cats__arrow {
    background: var(--hp-cream);
    color: var(--hp-teal);
    transform: translateX(3px);
  }
{%- endstyle -%}

<div class="hp-cats hp-section">
  <div class="hp-container">
    <div class="hp-section-head{% if section.settings.center_head %} hp-section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-eyebrow{% if section.settings.center_head %} hp-eyebrow--rule-after{% endif %}" data-hp-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-section-head__title" data-hp-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-section-head__text" data-hp-reveal>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hp-cats__grid" data-hp-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign tile_image = block.settings.image | default: col.featured_image
          assign tile_title = block.settings.title | default: col.title
        -%}
        <a
          class="hp-tile hp-cats__tile"
          {% if col != blank %}href="{{ col.url }}"{% else %}role="link" aria-disabled="true"{% endif %}
          data-hp-reveal
          {{ block.shopify_attributes }}
        >
          {%- if tile_image -%}
            {{
              tile_image
              | image_url: width: 900
              | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: tile_title
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="hp-cats__tile-inner">
            <div>
              <h3 class="hp-cats__name">{{ tile_title | default: 'Collection' }}</h3>
              {%- if col != blank and section.settings.show_count -%}
                <p class="hp-cats__count">{{ col.all_products_count }} {{ section.settings.count_label | default: 'varieties' | escape }}</p>
              {%- endif -%}
            </div>
            <span class="hp-cats__arrow">{% render 'hp-icon', icon: 'arrow-right', size: 15 %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "THP Collection Tiles",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Chapter One — The Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every Table Tells a Story" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "center_head", "label": "Center heading", "default": true },
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 5
    },
    { "type": "range", "id": "scrim", "min": 40, "max": 100, "step": 5, "unit": "%", "label": "Label overlay strength", "info": "Raise if names are hard to read on pale photos.", "default": 90 },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#fffdf4" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "info": "Shown after the number, e.g. '27 varieties'.",
      "default": "varieties"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "THP Collection Tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
